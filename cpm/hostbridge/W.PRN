

                ;-----------------------------------------------------------------------
                ; W.COM: copy a file from CP/M to the host.
                ;
                ;       W <cpmfile> [hostfile] [B|T]
                ;       W <pattern> [hostfolder] [B|T]  e.g.  W *.ASM     W B:*.* OUT
                ;
                ; Part of the altairsim Host Bridge. Assemble it in the machine:
                ;
                ;       ASM W                   -> W.HEX
                ;       LOAD W                  -> W.COM
                ;
                ; Revisions:
                ;       1.0  2026-08-27  Version banner. Byte count after each file.
                ;       1.1  2026-09-23  Attribute bits do not go into a host name.
                ;       1.2  2026-10-12  With no switch, the extension selects T or B.
                ;       1.3  2026-10-21  A wildcard can copy into a host folder.
                ;       1.4  2026-11-14  The no-board message says what to do.
                ;
                ; W uses only BDOS calls for the disk, and only ports B0H and B1H. It
                ; does not use the BIOS or a disk controller, so the same W.COM runs on
                ; every CP/M disk. BDOS changes every register except SP.
                ;
                ; B copies every byte of every record. T stops at the first ^Z. CP/M
                ; keeps no byte count, so the last record of a text file holds the ^Z
                ; and up to 126 bytes of old data. With no switch, W looks at the
                ; extension of the CP/M name (PICKMD):
                ;
                ;   ASM MAC Z80 HEX PRN LST SYM INC SUB TXT     -> T, and W says so
                ;   anything else                               -> B
                ;
                ; The table lists text types, so a file that is not on it is copied
                ; byte for byte. .BAS and .DOC are not on it, because MBASIC saves
                ; tokens by default and a word processor file can hold a 1AH. A switch
                ; always wins over the extension.
                ;-----------------------------------------------------------------------
                
 0100           	ORG	100H
                
                ;---- CP/M ------------------------------------------------------------
 0005 =         BDOS	EQU	0005H
 0080 =         TAIL	EQU	0080H		; the command tail: length, then the text.
                				; The CCP folds it to upper case.
 005C =         TFCB	EQU	005CH		; the FCB that the CCP parsed. W's first
                				; word is a CP/M name, so this parse is
                				; correct for it, and * is already ?.
                
 0002 =         CONOUT	EQU	2		; E = char
 0009 =         PRSTR	EQU	9		; DE = string, ends in '$'
 000F =         FOPEN	EQU	15
 0014 =         FREAD	EQU	20		; read sequential
 0011 =         FSRCHF	EQU	17		; search for first
 0012 =         FSRCHN	EQU	18		; search for next
 001A =         FSETDMA EQU	26
                
 0080 =         RECLEN	EQU	128		; a CP/M record
 0040 =         HNMAX	EQU	64		; a host name can be a path
 0020 =         IDMAX	EQU	32		; room for the board's signature
 0040 =         MAXN	EQU	64		; the most wildcard matches W holds
 001A =         CPMEOF	EQU	1AH		; ^Z
 000D =         CR	EQU	0DH
 000A =         LF	EQU	0AH
                
                ;---- The Host Bridge (HB.INC has the full list) ----------------------
 00B0 =         HBCMD	EQU	0B0H		; OUT = command   IN = status
 00B1 =         HBDATA	EQU	0B1H		; data, both ways
                
 0010 =         HERR	EQU	10H		; the last operation failed
                
 0000 =         CIDENT	EQU	0
 0002 =         CVOPENW EQU	2
 0003 =         CCLOSE	EQU	3
 0004 =         CDIRF	EQU	4
 0007 =         CERROR	EQU	7
 0008 =         CRESET	EQU	8
                
                ;=======================================================================
                ; MAIN
                ;=======================================================================
 0100 317010    START:	LXI	SP,STACK
                
 0103 3E08      	MVI	A,CRESET	; one byte puts the board in a known state
 0105 D3B0      	OUT	HBCMD
                
 0107 CD9803    	CALL	IDENT		; exits if there is no board
 010A CDFA03    	CALL	PARSE		; the tail -> CNAME, HNAME, MODE
 010D CDD502    	CALL	INIFCB		; the CCP's FCB at 5CH -> FCB
                
 0110 3A7D0C    	LDA	CNAME
 0113 B7        	ORA	A
 0114 CAD805    	JZ	USAGE		; no arguments
                
 0117 CDF802    	CALL	HASWLD		; a '?' in the FCB name?
 011A B7        	ORA	A
 011B C22401    	JNZ	MANY		; yes: a pattern
 011E CDE001    	CALL	ONEF		; no: one file
 0121 C30000    	JMP	0		; warm boot
                
                ;=======================================================================
                ; MANY: a wildcard. Copy each CP/M file that matches.
                ;
                ; W collects all the names first, then copies them. BDOS SEARCH NEXT
                ; keeps its place in the BDOS work area, and an OPEN or a READ
                ; overwrites it.
                ;
                ; More than MAXN matches is an error, and W copies nothing.
                ;
                ; A second word is a host folder: `W *.ASM SRC` writes SRC/FOO.ASM. The
                ; folder must exist. SETDIR checks it once, before the first file.
                ;=======================================================================
 0124 CD8601    MANY:	CALL	SETDIR		; HNAME -> HDIRP, "SRC/" (exits if bad)
                
 0127 AF        	XRA	A
 0128 326A0D    	STA	NCNT
 012B 21700D    	LXI	H,NAMES
 012E 226C0D    	SHLD	NPTR		; where the next match goes
 0131 226E0D    	SHLD	CPTR		; where the copy reads from
                
 0134 114F0B    	LXI	D,BUF		; the search results go in the DMA buffer
 0137 0E1A      	MVI	C,FSETDMA
 0139 CD0500    	CALL	BDOS
                
 013C 11D60B    	LXI	D,FCB
 013F 0E11      	MVI	C,FSRCHF
 0141 CD0500    	CALL	BDOS
                
 0144 FEFF      MN1:	CPI	0FFH
 0146 CA5A01    	JZ	MN2		; 0FFH = no more matches
 0149 CD0D03    	CALL	STASH		; A = the directory code
 014C DA0F06    	JC	ETOOMNY
 014F 11D60B    	LXI	D,FCB
 0152 0E12      	MVI	C,FSRCHN
 0154 CD0500    	CALL	BDOS
 0157 C34401    	JMP	MN1
                
 015A 3A6A0D    MN2:	LDA	NCNT
 015D B7        	ORA	A
 015E CA0406    	JZ	ENOMAT
                
                ;---- copy each match --------------------------------------------------
 0161 AF        	XRA	A
 0162 326B0D    	STA	DONE
                
 0165 3A6B0D    MN3:	LDA	DONE
 0168 47        	MOV	B,A
 0169 3A6A0D    	LDA	NCNT
 016C B8        	CMP	B
 016D CA8301    	JZ	EXIT		; every match done
                
 0170 CD4103    	CALL	SETFCB		; the next name -> FCB
 0173 CDCF01    	CALL	DIRHN		; HNAME = the folder, then the CP/M name
 0176 CDE001    	CALL	ONEF		; reports its own errors and returns
                
 0179 3A6B0D    	LDA	DONE
 017C 3C        	INR	A
 017D 326B0D    	STA	DONE
 0180 C36501    	JMP	MN3
                
 0183 C30000    EXIT:	JMP	0		; warm boot
                
                ;-----------------------------------------------------------------------
                ; SETDIR: HNAME -> HDIRP, the folder that a wildcard writes into.
                ;
                ; With no second word, HDIRP is empty. Otherwise W adds a `/` if the
                ; name does not end in `/` or `\`. Then DIR_FIRST lists the folder. It
                ; fails if the folder is not there or is a file, and it changes nothing
                ; on the host. On a failure W prints the host's message and stops.
                ;
                ; The folder must leave room in HNAME for a 12-character CP/M name,
                ; "FILENAME.EXT". W refuses a longer folder.
                ;-----------------------------------------------------------------------
 0186 21FA0B    SETDIR: LXI	H,HNAME
 0189 113B0C    	LXI	D,HDIRP
 018C 0600      	MVI	B,0		; B counts the characters copied
 018E 7E        SD1:	MOV	A,M
 018F B7        	ORA	A
 0190 CA9A01    	JZ	SD2
 0193 12        	STAX	D
 0194 23        	INX	H
 0195 13        	INX	D
 0196 04        	INR	B
 0197 C38E01    	JMP	SD1
                
 019A 78        SD2:	MOV	A,B
 019B B7        	ORA	A
 019C CACD01    	JZ	SD9		; no folder: HDIRP is only the NUL
 019F 2B        	DCX	H		; the last character typed
 01A0 7E        	MOV	A,M
 01A1 FE2F      	CPI	'/'
 01A3 CAB001    	JZ	SD3
 01A6 FE5C      	CPI	'\'
 01A8 CAB001    	JZ	SD3
 01AB 3E2F      	MVI	A,'/'
 01AD 12        	STAX	D
 01AE 13        	INX	D
 01AF 04        	INR	B
 01B0 78        SD3:	MOV	A,B
 01B1 FE35      	CPI	HNMAX-12+1
 01B3 D2E305    	JNC	ELONG		; no room for FILENAME.EXT
 01B6 AF        	XRA	A
 01B7 12        	STAX	D
                
 01B8 3E04      	MVI	A,CDIRF
 01BA D3B0      	OUT	HBCMD
 01BC 213B0C    	LXI	H,HDIRP
 01BF CDCC03    	CALL	SENDZ
 01C2 DBB0      	IN	HBCMD
 01C4 E610      	ANI	HERR
 01C6 C8        	RZ			; the folder is there
 01C7 CDD503    	CALL	REPERR		; "W: NOPE: no such file"
 01CA C30000    	JMP	0
                
 01CD 12        SD9:	STAX	D		; A is 0
 01CE C9        	RET
                
                ;-----------------------------------------------------------------------
                ; DIRHN: HNAME = the folder in HDIRP, then the name in the FCB.
                ;-----------------------------------------------------------------------
 01CF 213B0C    DIRHN:	LXI	H,HDIRP
 01D2 11FA0B    	LXI	D,HNAME
 01D5 7E        DH1:	MOV	A,M
 01D6 B7        	ORA	A
 01D7 CA6903    	JZ	FCB2HN		; tail call. DE is where the name goes.
 01DA 12        	STAX	D
 01DB 23        	INX	H
 01DC 13        	INX	D
 01DD C3D501    	JMP	DH1
                
                ;=======================================================================
                ; ONEF: copy the CP/M file in FCB to the host.
                ;
                ; INIFCB or SETFCB built the FCB. HNAME is the host name, or empty to
                ; use the CP/M name.
                ;=======================================================================
 01E0 CD9A02    ONEF:	CALL	PICKMD		; B or T for this file
 01E3 210000    	LXI	H,0
 01E6 22D10B    	SHLD	RECS
                
                ; Clear the FCB fields after the name before each OPEN. After the first
                ; match of a wildcard, they hold what BDOS left.
 01E9 AF        	XRA	A
 01EA 32E20B    	STA	FCB+12		; ex
 01ED 32E30B    	STA	FCB+13		; s1
 01F0 32E40B    	STA	FCB+14		; s2
 01F3 32E50B    	STA	FCB+15		; rc
 01F6 32F60B    	STA	FCB+32		; cr, the record cursor
                
                ; Open the CP/M file before the host file. OPEN_WRITE truncates a host
                ; file, so a CP/M name that is not on the disk must fail first.
 01F9 11D60B    	LXI	D,FCB
 01FC 0E0F      	MVI	C,FOPEN
 01FE CD0500    	CALL	BDOS
 0201 FEFF      	CPI	0FFH
 0203 CA1A06    	JZ	ENOCPM
                
 0206 AF        	XRA	A
 0207 32F60B    	STA	FCB+32		; BDOS OPEN does not always clear cr
                
 020A 3AFA0B    	LDA	HNAME
 020D B7        	ORA	A
 020E C21702    	JNZ	OF1		; the user gave a host name
 0211 11FA0B    	LXI	D,HNAME
 0214 CD6903    	CALL	FCB2HN		; or use the CP/M name
                OF1:
                
                ;---- Open the host file ----------------------------------------------
 0217 3E02      	MVI	A,CVOPENW
 0219 D3B0      	OUT	HBCMD
 021B 21FA0B    	LXI	H,HNAME
 021E CDCC03    	CALL	SENDZ		; the NUL commits the command
                
 0221 DBB0      	IN	HBCMD
 0223 E610      	ANI	HERR
 0225 C24602    	JNZ	ONEBAD		; read-only board, outside the sandbox, bad name
                
 0228 CDA504    	CALL	SAYXFR		; "W: FOO.ASM -> FOO.ASM"
                
 022B 114F0B    	LXI	D,BUF
 022E 0E1A      	MVI	C,FSETDMA
 0230 CD0500    	CALL	BDOS		; BDOS reads each record into BUF
                
 0233 CD4A02    	CALL	COPY
 0236 D8        	RC			; CY = it failed and printed why
                
                ;---- CLOSE commits the host file -------------------------------------
                ; The board holds the file in memory and writes it to the host at
                ; CLOSE. A write that is not closed is discarded.
 0237 3E03      	MVI	A,CCLOSE
 0239 D3B0      	OUT	HBCMD
 023B DBB0      	IN	HBCMD
 023D E610      	ANI	HERR
 023F C24602    	JNZ	ONEBAD		; the host disk is full or read-only
                
 0242 CDD504    	CALL	SAYREC		; "  3 records, 384 bytes"
 0245 C9        	RET
                
 0246 CDD503    ONEBAD: CALL	REPERR
 0249 C9        	RET
                
                ;-----------------------------------------------------------------------
                ; COPY: CP/M records -> the host. Returns CY on failure.
                ;
                ; There is no wait for TBE. The board stores the file in memory, so it
                ; always takes the next byte.
                ;-----------------------------------------------------------------------
 024A 210000    COPY:	LXI	H,0
 024D 22D10B    	SHLD	RECS
 0250 22D30B    	SHLD	BYTES		; the true byte count, 24 bits. T mode can
 0253 AF        	XRA	A		; stop in a record, so RECS*128 is wrong.
 0254 32D50B    	STA	BYTES+2
                
 0257 11D60B    CP0:	LXI	D,FCB
 025A 0E14      	MVI	C,FREAD
 025C CD0500    	CALL	BDOS
 025F B7        	ORA	A
 0260 C29302    	JNZ	CPEND		; 1 = end of file. Any other code ends it too.
                
 0263 2AD10B    	LHLD	RECS		; count the record now. T mode can stop
 0266 23        	INX	H		; in this record, and it was read.
 0267 22D10B    	SHLD	RECS
                
 026A 214F0B    	LXI	H,BUF
 026D 0680      	MVI	B,RECLEN
                
 026F 7E        CP1:	MOV	A,M
 0270 4F        	MOV	C,A		; keep the byte: LDA changes A
 0271 3ACF0B    	LDA	XMODE
 0274 FE54      	CPI	'T'
 0276 79        	MOV	A,C		; and get it back
 0277 C27F02    	JNZ	CP2		; B: send every byte
 027A FE1A      	CPI	CPMEOF
 027C CA9302    	JZ	CPEND		; T: the first ^Z ends the file
                
 027F D3B1      CP2:	OUT	HBDATA
 0281 CDEE04    	CALL	INCBYT		; count the byte sent
 0284 23        	INX	H
 0285 05        	DCR	B
 0286 C26F02    	JNZ	CP1
                
                ; Check HERR once for each record. While it streams, a write fails only
                ; at the board's 8 MB limit, so one IN for each record finds it soon.
 0289 DBB0      	IN	HBCMD
 028B E610      	ANI	HERR
 028D C29502    	JNZ	CPERR
 0290 C35702    	JMP	CP0
                
 0293 AF        CPEND:	XRA	A		; also clears CY: success
 0294 C9        	RET
                
 0295 CDD503    CPERR:	CALL	REPERR
 0298 37        	STC
 0299 C9        	RET
                
                ;-----------------------------------------------------------------------
                ; PICKMD: set XMODE, the mode for the file in FCB.
                ;
                ; A switch decides. With no switch, W looks for the extension in
                ; EXTTAB. On the list is T, and AUTO is set so SAYXFR says so. Off the
                ; list is B. The compare ignores bit 7 (see STASH).
                ;-----------------------------------------------------------------------
 029A AF        PICKMD: XRA	A
 029B 32D00B    	STA	AUTO
 029E 3A3A06    	LDA	MODSET
 02A1 B7        	ORA	A
 02A2 3A3906    	LDA	MODE		; (LDA does not change the flags)
 02A5 C2D102    	JNZ	PM9		; a switch was given
                
 02A8 113B06    	LXI	D,EXTTAB
 02AB 1A        PM1:	LDAX	D
 02AC B7        	ORA	A
 02AD 3E42      	MVI	A,'B'		; (MVI does not change the flags)
 02AF CAD102    	JZ	PM9		; the end of the table: B
                
 02B2 21DF0B    	LXI	H,FCB+9		; the extension
 02B5 0603      	MVI	B,3
 02B7 0E00      	MVI	C,0		; C collects the bits that differ
 02B9 1A        PM2:	LDAX	D
 02BA AE        	XRA	M
 02BB E67F      	ANI	7FH
 02BD B1        	ORA	C
 02BE 4F        	MOV	C,A
 02BF 23        	INX	H
 02C0 13        	INX	D
 02C1 05        	DCR	B
 02C2 C2B902    	JNZ	PM2		; all three, so DE ends on the next entry
 02C5 79        	MOV	A,C
 02C6 B7        	ORA	A
 02C7 C2AB02    	JNZ	PM1
                
 02CA 3E01      	MVI	A,1
 02CC 32D00B    	STA	AUTO
 02CF 3E54      	MVI	A,'T'
 02D1 32CF0B    PM9:	STA	XMODE
 02D4 C9        	RET
                
                ;=======================================================================
                ; THE CP/M DIRECTORY
                ;=======================================================================
                
                ;-----------------------------------------------------------------------
                ; INIFCB: copy the CCP's FCB at 005CH to FCB.
                ;
                ; The CCP's second FCB starts at 006CH, and an OPEN of the first writes
                ; into it. W uses a copy for this reason. Bytes 0-11 are the drive and
                ; the 8.3 name, with * already changed to ?. The rest starts at zero.
                ;-----------------------------------------------------------------------
 02D5 21D60B    INIFCB: LXI	H,FCB
 02D8 0624      	MVI	B,36
 02DA 3600      IF0:	MVI	M,0
 02DC 23        	INX	H
 02DD 05        	DCR	B
 02DE C2DA02    	JNZ	IF0
                
 02E1 215C00    	LXI	H,TFCB
 02E4 11D60B    	LXI	D,FCB
 02E7 060C      	MVI	B,12
 02E9 7E        IF1:	MOV	A,M
 02EA 12        	STAX	D
 02EB 23        	INX	H
 02EC 13        	INX	D
 02ED 05        	DCR	B
 02EE C2E902    	JNZ	IF1
                
 02F1 3AD60B    	LDA	FCB		; keep the drive. SETFCB puts it back
 02F4 325A06    	STA	DRIVE		; for each match.
 02F7 C9        	RET
                
                ;-----------------------------------------------------------------------
                ; HASWLD: A=1 if the FCB name holds a '?', else A=0. The CCP has
                ; already changed * to ?, so '?' is the only wildcard left.
                ;-----------------------------------------------------------------------
 02F8 21D70B    HASWLD: LXI	H,FCB+1
 02FB 060B      	MVI	B,11
 02FD 7E        HW1:	MOV	A,M
 02FE FE3F      	CPI	'?'
 0300 CA0A03    	JZ	HWYES
 0303 23        	INX	H
 0304 05        	DCR	B
 0305 C2FD02    	JNZ	HW1
 0308 AF        	XRA	A
 0309 C9        	RET
 030A 3E01      HWYES:	MVI	A,1
 030C C9        	RET
                
                ;-----------------------------------------------------------------------
                ; STASH: copy the name of the directory entry that BDOS found.
                ;
                ; BDOS SEARCH returns 0-3 in A. The entry is at BUF + A*32. Returns CY
                ; if the table is full.
                ;
                ; CP/M keeps R/O, SYSTEM and ARCHIVE in bit 7 of three name characters.
                ; STASH clears bit 7, because OPEN does not find a name that has it
                ; set. FLD, PICKMD and PRFCB also ignore bit 7, because a CP/M 3 OPEN
                ; writes the bits back into the FCB.
                ;-----------------------------------------------------------------------
 030D 4F        STASH:	MOV	C,A		; the directory code
                
 030E 3A6A0D    	LDA	NCNT
 0311 FE40      	CPI	MAXN
 0313 D23F03    	JNC	STFULL
 0316 3C        	INR	A
 0317 326A0D    	STA	NCNT
                
 031A 79        	MOV	A,C
 031B E603      	ANI	3		; documented as 0-3
 031D 87        	ADD	A
 031E 87        	ADD	A
 031F 87        	ADD	A
 0320 87        	ADD	A
 0321 87        	ADD	A		; *32: at most 96, so it fits in 8 bits
 0322 5F        	MOV	E,A
 0323 1600      	MVI	D,0
 0325 214F0B    	LXI	H,BUF
 0328 19        	DAD	D
 0329 23        	INX	H		; the name, after the user number byte
 032A EB        	XCHG			; DE = source
 032B 2A6C0D    	LHLD	NPTR		; HL = where it goes
 032E 060B      	MVI	B,11
 0330 1A        ST1:	LDAX	D
 0331 E67F      	ANI	7FH		; clear the attribute bit
 0333 77        	MOV	M,A
 0334 13        	INX	D
 0335 23        	INX	H
 0336 05        	DCR	B
 0337 C23003    	JNZ	ST1
 033A 226C0D    	SHLD	NPTR
 033D B7        	ORA	A		; also clears CY
 033E C9        	RET
                
 033F 37        STFULL: STC
 0340 C9        	RET
                
                ;-----------------------------------------------------------------------
                ; SETFCB: the next stashed name -> FCB, and move CPTR on.
                ;-----------------------------------------------------------------------
 0341 21D60B    SETFCB: LXI	H,FCB
 0344 0624      	MVI	B,36
 0346 3600      SF0:	MVI	M,0
 0348 23        	INX	H
 0349 05        	DCR	B
 034A C24603    	JNZ	SF0
                
 034D 3A5A06    	LDA	DRIVE		; the drive the user gave. A directory
 0350 32D60B    	STA	FCB		; entry has a user number in this byte.
                
 0353 2A6E0D    	LHLD	CPTR
 0356 EB        	XCHG			; DE = the stashed name
 0357 21D70B    	LXI	H,FCB+1
 035A 060B      	MVI	B,11
 035C 1A        SF1:	LDAX	D
 035D 77        	MOV	M,A
 035E 13        	INX	D
 035F 23        	INX	H
 0360 05        	DCR	B
 0361 C25C03    	JNZ	SF1
 0364 EB        	XCHG			; HL = the next name
 0365 226E0D    	SHLD	CPTR
 0368 C9        	RET
                
                ;-----------------------------------------------------------------------
                ; FCB2HN: the CP/M name in FCB -> "FOO.ASM" at DE.
                ;
                ; DE is HNAME, or the end of a folder already in it. The FCB pads each
                ; field with spaces, and a CP/M name has no space, so a space ends the
                ; field.
                ;-----------------------------------------------------------------------
 0369 21D70B    FCB2HN: LXI	H,FCB+1
 036C 0608      	MVI	B,8
 036E CD8A03    	CALL	FLD
                
 0371 3ADF0B    	LDA	FCB+9
 0374 E67F      	ANI	7FH		; ignore the attribute bit (see STASH)
 0376 FE20      	CPI	' '
 0378 CA8703    	JZ	F2Z		; no extension: no dot
 037B 3E2E      	MVI	A,'.'
 037D 12        	STAX	D
 037E 13        	INX	D
 037F 21DF0B    	LXI	H,FCB+9
 0382 0603      	MVI	B,3
 0384 CD8A03    	CALL	FLD
                
 0387 AF        F2Z:	XRA	A
 0388 12        	STAX	D		; the NUL that SENDZ needs
 0389 C9        	RET
                
                ; FLD: copy up to B characters from (HL) to (DE), and stop at a space.
                ; Bit 7 is cleared (see STASH).
 038A 7E        FLD:	MOV	A,M
 038B E67F      	ANI	7FH
 038D FE20      	CPI	' '
 038F C8        	RZ
 0390 12        	STAX	D
 0391 13        	INX	D
 0392 23        	INX	H
 0393 05        	DCR	B
 0394 C28A03    	JNZ	FLD
 0397 C9        	RET
                
                ;=======================================================================
                ; THE HOST BRIDGE
                ;=======================================================================
                
                ;-----------------------------------------------------------------------
                ; IDENT: check that the board is there before anything else.
                ;
                ; An IN from a port that no board decodes reads 0FFH, and 0FFH has HERR
                ; set. Without this check, W would report a host error.
                ;-----------------------------------------------------------------------
 0398 3E00      IDENT:	MVI	A,CIDENT
 039A D3B0      	OUT	HBCMD
                
 039C 21400D    	LXI	H,IDBUF
 039F 0620      	MVI	B,IDMAX
 03A1 DBB1      ID1:	IN	HBDATA
 03A3 77        	MOV	M,A
 03A4 B7        	ORA	A
 03A5 CAAF03    	JZ	ID2		; the terminator
 03A8 23        	INX	H
 03A9 05        	DCR	B
 03AA C2A103    	JNZ	ID1
 03AD 3600      	MVI	M,0		; no terminator: 0FFH, so no board
                
 03AF 21400D    ID2:	LXI	H,IDBUF
 03B2 112406    	LXI	D,IDWANT
 03B5 1A        ID3:	LDAX	D
 03B6 B7        	ORA	A
 03B7 C8        	RZ			; a match: the board is there. This is a
                				; prefix compare, so a later signature
                				; such as "... 2" also matches.
 03B8 BE        	CMP	M
 03B9 C2C103    	JNZ	IDBAD
 03BC 23        	INX	H
 03BD 13        	INX	D
 03BE C3B503    	JMP	ID3
                
 03C1 115B06    IDBAD:	LXI	D,MNOHB
 03C4 0E09      	MVI	C,PRSTR
 03C6 CD0500    	CALL	BDOS
 03C9 C30000    	JMP	0
                
                ;-----------------------------------------------------------------------
                ; SENDZ: send the string at HL to the data port, with its NUL. The NUL
                ; commits the command.
                ;-----------------------------------------------------------------------
 03CC 7E        SENDZ:	MOV	A,M
 03CD D3B1      	OUT	HBDATA
 03CF B7        	ORA	A
 03D0 C8        	RZ			; that was the NUL
 03D1 23        	INX	H
 03D2 C3CC03    	JMP	SENDZ
                
                ;-----------------------------------------------------------------------
                ; REPERR: print the board's error message. The board sends a code byte,
                ; then the host's message as text. W prints the text.
                ;-----------------------------------------------------------------------
 03D5 3E07      REPERR: MVI	A,CERROR
 03D7 D3B0      	OUT	HBCMD
 03D9 DBB1      	IN	HBDATA		; the code byte: skip it
                
 03DB 112C0A    	LXI	D,MERR
 03DE 0E09      	MVI	C,PRSTR
 03E0 CD0500    	CALL	BDOS
                
 03E3 DBB1      RPE1:	IN	HBDATA		; then the text, one character at a time.
 03E5 B7        	ORA	A		; No register is kept across the BDOS
 03E6 CAF203    	JZ	RPE2		; call: each byte comes from the port.
 03E9 5F        	MOV	E,A
 03EA 0E02      	MVI	C,CONOUT
 03EC CD0500    	CALL	BDOS
 03EF C3E303    	JMP	RPE1
                
 03F2 11300A    RPE2:	LXI	D,MCRLF
 03F5 0E09      	MVI	C,PRSTR
 03F7 C30500    	JMP	BDOS		; tail call
                
                ;=======================================================================
                ; THE COMMAND TAIL
                ;=======================================================================
                
                ;-----------------------------------------------------------------------
                ; PARSE: get up to three words from the command tail at 0080H.
                ;
                ;       W FOO.TXT                 CNAME=FOO.TXT
                ;       W FOO.TXT T               CNAME=FOO.TXT              MODE=T
                ;       W *.* B                   a wildcard takes the switch too
                ;       W FOO.TXT BAR.TXT         CNAME=FOO.TXT HNAME=BAR.TXT
                ;       W FOO.TXT SRC/BAR.TXT T   a subdirectory of hostdir
                ;       W *.ASM SRC               with a wildcard, HNAME is a folder
                ;
                ; A lone B or T as the second word is the switch. Write a host file
                ; named T as ./T, and a folder named B or T as B/.
                ;
                ; The FCB comes from the CCP (TFCB). CNAME only shows that the user
                ; typed something.
                ;
                ; PARSE clears HNAME first. HNAME is a DS, so it is not in the .COM and
                ; holds old data at the start. TOKEN puts a NUL in every other buffer,
                ; but HNAME gets one only from a second word.
                ;-----------------------------------------------------------------------
 03FA AF        PARSE:	XRA	A
 03FB 32FA0B    	STA	HNAME
                
 03FE 218000    	LXI	H,TAIL
 0401 46        	MOV	B,M		; the length of the tail
 0402 23        	INX	H		; the first character
                
 0403 CD7C04    	CALL	SKIPSP
 0406 117D0C    	LXI	D,CNAME
 0409 0E41      	MVI	C,HNMAX+1
 040B CD8804    	CALL	TOKEN
                
 040E CD7C04    	CALL	SKIPSP
 0411 11BE0C    	LXI	D,TOK2
 0414 0E41      	MVI	C,HNMAX+1
 0416 CD8804    	CALL	TOKEN
                
 0419 CD7C04    	CALL	SKIPSP
 041C 11FF0C    	LXI	D,TOK3
 041F 0E41      	MVI	C,HNMAX+1
 0421 CD8804    	CALL	TOKEN
                
 0424 3AFF0C    	LDA	TOK3
 0427 B7        	ORA	A
 0428 CA3704    	JZ	PA2		; two words or fewer
                
                ; Three words: the host name, then the switch.
 042B 21BE0C    	LXI	H,TOK2
 042E CD7004    	CALL	CPYHN
 0431 21FF0C    	LXI	H,TOK3
 0434 C35C04    	JMP	SETMOD
                
 0437 3ABE0C    PA2:	LDA	TOK2
 043A B7        	ORA	A
 043B C8        	RZ			; one word
                
 043C 3ABF0C    	LDA	TOK2+1
 043F B7        	ORA	A
 0440 C25604    	JNZ	PA3		; more than one character: a host name
 0443 3ABE0C    	LDA	TOK2
 0446 FE42      	CPI	'B'
 0448 CA5004    	JZ	PA2S
 044B FE54      	CPI	'T'
 044D C25604    	JNZ	PA3
 0450 21BE0C    PA2S:	LXI	H,TOK2
 0453 C35C04    	JMP	SETMOD
                
 0456 21BE0C    PA3:	LXI	H,TOK2
 0459 C37004    	JMP	CPYHN		; tail call
                
 045C 7E        SETMOD: MOV	A,M
 045D FE42      	CPI	'B'
 045F CA6704    	JZ	SM1
 0462 FE54      	CPI	'T'
 0464 C2EE05    	JNZ	EBADSW
 0467 323906    SM1:	STA	MODE
 046A 3E01      	MVI	A,1
 046C 323A06    	STA	MODSET		; a switch was given, so PICKMD does
 046F C9        	RET			; not look at the extension
                
 0470 11FA0B    CPYHN:	LXI	D,HNAME
 0473 7E        CH1:	MOV	A,M
 0474 12        	STAX	D
 0475 B7        	ORA	A
 0476 C8        	RZ			; the NUL is copied too
 0477 23        	INX	H
 0478 13        	INX	D
 0479 C37304    	JMP	CH1
                
 047C 78        SKIPSP: MOV	A,B
 047D B7        	ORA	A
 047E C8        	RZ			; nothing left
 047F 7E        	MOV	A,M
 0480 FE20      	CPI	' '
 0482 C0        	RNZ
 0483 23        	INX	H
 0484 05        	DCR	B
 0485 C37C04    	JMP	SKIPSP
                
                ; TOKEN: copy one word from (HL) to (DE), and end it with a NUL.
                ;   B = characters left in the tail   C = room at DE, with the NUL
                ; No word gives an empty string, which the callers test for. A word
                ; that does not fit stops W with an error. W does not cut the word: a
                ; cut host name can name a different file, and the rest of the word
                ; would become the next word.
 0488 78        TOKEN:	MOV	A,B
 0489 B7        	ORA	A
 048A CAA204    	JZ	TOKEND
 048D 7E        	MOV	A,M
 048E FE20      	CPI	' '
 0490 CAA204    	JZ	TOKEND
 0493 79        	MOV	A,C
 0494 FE01      	CPI	1
 0496 CAF905    	JZ	EWORD		; a character, and room for the NUL only
 0499 7E        	MOV	A,M
 049A 12        	STAX	D
 049B 23        	INX	H
 049C 13        	INX	D
 049D 05        	DCR	B
 049E 0D        	DCR	C
 049F C38804    	JMP	TOKEN
 04A2 AF        TOKEND: XRA	A
 04A3 12        	STAX	D
 04A4 C9        	RET
                
                ;=======================================================================
                ; TALKING TO THE USER
                ;=======================================================================
                
                ; "W: FOO.ASM -> SRC/FOO.ASM"
 04A5 11F909    SAYXFR: LXI	D,MPFX
 04A8 0E09      	MVI	C,PRSTR
 04AA CD0500    	CALL	BDOS
 04AD CD5B05    	CALL	PRFCB
 04B0 11FD09    	LXI	D,MARROW
 04B3 0E09      	MVI	C,PRSTR
 04B5 CD0500    	CALL	BDOS
 04B8 21FA0B    	LXI	H,HNAME
 04BB CD4C05    	CALL	PSTR
 04BE 3AD00B    	LDA	AUTO
 04C1 B7        	ORA	A
 04C2 CACD04    	JZ	SX1
 04C5 11020A    	LXI	D,MBYEXT	; " (text, by extension)"
 04C8 0E09      	MVI	C,PRSTR
 04CA CD0500    	CALL	BDOS
 04CD 11300A    SX1:	LXI	D,MCRLF
 04D0 0E09      	MVI	C,PRSTR
 04D2 C30500    	JMP	BDOS
                
                ; "  12 records, 1493 bytes"
 04D5 2AD10B    SAYREC: LHLD	RECS
 04D8 CDA105    	CALL	PRDEC
 04DB 11180A    	LXI	D,MRECS		; " records, "
 04DE 0E09      	MVI	C,PRSTR
 04E0 CD0500    	CALL	BDOS
 04E3 CDFF04    	CALL	PRBYT		; the bytes sent to the host
 04E6 11230A    	LXI	D,MBYTES	; " bytes",CR,LF
 04E9 0E09      	MVI	C,PRSTR
 04EB C30500    	JMP	BDOS
                
                ;-----------------------------------------------------------------------
                ; INCBYT: add one to the 24-bit count at BYTES. Keeps A, B, C and HL.
                ;-----------------------------------------------------------------------
 04EE E5        INCBYT: PUSH	H
 04EF 21D30B    	LXI	H,BYTES
 04F2 34        	INR	M
 04F3 C2FD04    	JNZ	IB1		; no carry: done
 04F6 23        	INX	H
 04F7 34        	INR	M
 04F8 C2FD04    	JNZ	IB1
 04FB 23        	INX	H
 04FC 34        	INR	M
 04FD E1        IB1:	POP	H
 04FE C9        	RET
                
                ;-----------------------------------------------------------------------
                ; PRBYT: print the 24-bit count at BYTES in decimal, as PRDEC does for
                ; HL. It divides BYTES by ten in place.
                ;-----------------------------------------------------------------------
 04FF 11690D    PRBYT:	LXI	D,NUMEND
 0502 3E24      	MVI	A,'$'
 0504 12        	STAX	D
 0505 1B        PRB1:	DCX	D
 0506 D5        	PUSH	D		; DIV10T changes DE
 0507 CD1F05    	CALL	DIV10T		; BYTES = BYTES/10, A = the remainder
 050A D1        	POP	D
 050B C630      	ADI	'0'
 050D 12        	STAX	D
 050E 3AD30B    	LDA	BYTES		; anything left?
 0511 21D40B    	LXI	H,BYTES+1
 0514 B6        	ORA	M
 0515 23        	INX	H
 0516 B6        	ORA	M
 0517 C20505    	JNZ	PRB1
 051A 0E09      	MVI	C,PRSTR
 051C C30500    	JMP	BDOS
                
                ; DIV10T: BYTES = BYTES/10, and A = the remainder. Long division from
                ; the top byte. The remainder r is below 10, so r*256+byte < 2560 fits
                ; in DE.
 051F AF        DIV10T: XRA	A		; the remainder starts at 0
 0520 21D50B    	LXI	H,BYTES+2	; the top byte first
 0523 CD2E05    	CALL	DT1
 0526 2B        	DCX	H
 0527 CD2E05    	CALL	DT1
 052A 2B        	DCX	H
 052B C32E05    	JMP	DT1		; tail call: A = the remainder
                
                ; DT1: acc = A*256 + (HL). (HL) = acc/10 and A = acc MOD 10. HL does
                ; not change.
 052E 57        DT1:	MOV	D,A		; DE = acc, D below 10
 052F 5E        	MOV	E,M
 0530 0600      	MVI	B,0		; the quotient byte
 0532 7A        DT2:	MOV	A,D
 0533 B7        	ORA	A
 0534 C23D05    	JNZ	DT3		; D is set: acc >= 256
 0537 7B        	MOV	A,E
 0538 FE0A      	CPI	10
 053A DA4905    	JC	DT4		; acc < 10: E is the remainder
 053D 7B        DT3:	MOV	A,E
 053E D60A      	SUI	10
 0540 5F        	MOV	E,A
 0541 7A        	MOV	A,D
 0542 DE00      	SBI	0
 0544 57        	MOV	D,A
 0545 04        	INR	B
 0546 C33205    	JMP	DT2
 0549 70        DT4:	MOV	M,B		; store the quotient byte
 054A 7B        	MOV	A,E		; the remainder, for the next byte
 054B C9        	RET
                
                ; PSTR: print the string at HL, up to its NUL. HL is kept across BDOS.
 054C 7E        PSTR:	MOV	A,M
 054D B7        	ORA	A
 054E C8        	RZ
 054F E5        	PUSH	H
 0550 5F        	MOV	E,A
 0551 0E02      	MVI	C,CONOUT
 0553 CD0500    	CALL	BDOS
 0556 E1        	POP	H
 0557 23        	INX	H
 0558 C34C05    	JMP	PSTR
                
                ; PRFCB: print the FCB as "d:NAME.EXT".
 055B 3AD60B    PRFCB:	LDA	FCB
 055E B7        	ORA	A
 055F CA6C05    	JZ	PF1		; drive 0 is the current drive: no letter
 0562 C640      	ADI	'A'-1
 0564 CD9B05    	CALL	PUTCH
 0567 3E3A      	MVI	A,':'
 0569 CD9B05    	CALL	PUTCH
 056C 21D70B    PF1:	LXI	H,FCB+1
 056F 0608      	MVI	B,8
 0571 CD8605    	CALL	PFLD
 0574 3ADF0B    	LDA	FCB+9
 0577 E67F      	ANI	7FH		; ignore the attribute bit (see STASH)
 0579 FE20      	CPI	' '
 057B C8        	RZ			; no extension
 057C 3E2E      	MVI	A,'.'
 057E CD9B05    	CALL	PUTCH
 0581 21DF0B    	LXI	H,FCB+9
 0584 0603      	MVI	B,3
 0586 7E        PFLD:	MOV	A,M		; print B characters at HL, but not
 0587 E67F      	ANI	7FH		; the spaces that pad an FCB. Bit 7
 0589 FE20      	CPI	' '		; is ignored (see STASH).
 058B CA9505    	JZ	PFL2
 058E C5        	PUSH	B
 058F E5        	PUSH	H
 0590 CD9B05    	CALL	PUTCH
 0593 E1        	POP	H
 0594 C1        	POP	B
 0595 23        PFL2:	INX	H
 0596 05        	DCR	B
 0597 C28605    	JNZ	PFLD
 059A C9        	RET
                
 059B 5F        PUTCH:	MOV	E,A
 059C 0E02      	MVI	C,CONOUT
 059E C30500    	JMP	BDOS
                
                ;-----------------------------------------------------------------------
                ; PRDEC: print HL in decimal. The digits go into NUMBUF from the end,
                ; and a '$' ends them, so one BDOS 9 call prints them.
                ;-----------------------------------------------------------------------
 05A1 11690D    PRDEC:	LXI	D,NUMEND
 05A4 3E24      	MVI	A,'$'
 05A6 12        	STAX	D
 05A7 1B        PD1:	DCX	D
 05A8 CDB805    	CALL	DIV10		; HL = HL/10, A = the remainder
 05AB C630      	ADI	'0'
 05AD 12        	STAX	D
 05AE 7C        	MOV	A,H
 05AF B5        	ORA	L
 05B0 C2A705    	JNZ	PD1		; until HL is 0
 05B3 0E09      	MVI	C,PRSTR
 05B5 C30500    	JMP	BDOS		; DE points at the first digit
                
                ; DIV10: HL = HL/10, A = the remainder, by repeated subtraction.
 05B8 C5        DIV10:	PUSH	B
 05B9 010000    	LXI	B,0
 05BC 7C        DV1:	MOV	A,H
 05BD B7        	ORA	A
 05BE C2C705    	JNZ	DV2		; H is not 0: HL >= 10
 05C1 7D        	MOV	A,L
 05C2 FE0A      	CPI	10
 05C4 DAD305    	JC	DV3		; HL < 10: HL is the remainder
 05C7 7D        DV2:	MOV	A,L
 05C8 D60A      	SUI	10
 05CA 6F        	MOV	L,A
 05CB 7C        	MOV	A,H
 05CC DE00      	SBI	0
 05CE 67        	MOV	H,A
 05CF 03        	INX	B
 05D0 C3BC05    	JMP	DV1
 05D3 7D        DV3:	MOV	A,L		; the remainder, before L changes
 05D4 60        	MOV	H,B
 05D5 69        	MOV	L,C		; HL = the quotient
 05D6 C1        	POP	B
 05D7 C9        	RET
                
                ;=======================================================================
                ; ERRORS
                ;
                ; Each error prints its message and does a warm boot, except ENOCPM.
                ; ENOCPM comes from inside ONEF and returns with CY set, so a wildcard
                ; continues with the next file.
                ;=======================================================================
 05D8 11C206    USAGE:	LXI	D,MUSAGE
 05DB 0E09      	MVI	C,PRSTR
 05DD CD0500    	CALL	BDOS
 05E0 C30000    	JMP	0
                
 05E3 11330A    ELONG:	LXI	D,MELONG
 05E6 0E09      	MVI	C,PRSTR
 05E8 CD0500    	CALL	BDOS
 05EB C30000    	JMP	0
                
 05EE 116E0A    EBADSW: LXI	D,MEBADSW
 05F1 0E09      	MVI	C,PRSTR
 05F3 CD0500    	CALL	BDOS
 05F6 C30000    	JMP	0
                
 05F9 11550A    EWORD:	LXI	D,MEWORD
 05FC 0E09      	MVI	C,PRSTR
 05FE CD0500    	CALL	BDOS
 0601 C30000    	JMP	0
                
 0604 11AD0A    ENOMAT: LXI	D,MENOMAT
 0607 0E09      	MVI	C,PRSTR
 0609 CD0500    	CALL	BDOS
 060C C30000    	JMP	0
                
 060F 11C80A    ETOOMNY:LXI	D,METOOM
 0612 0E09      	MVI	C,PRSTR
 0614 CD0500    	CALL	BDOS
 0617 C30000    	JMP	0
                
 061A 11370B    ENOCPM: LXI	D,MENOCPM
 061D 0E09      	MVI	C,PRSTR
 061F CD0500    	CALL	BDOS
 0622 37        	STC
 0623 C9        	RET
                
                ;=======================================================================
                ; DATA
                ;=======================================================================
 0624 414C544149IDWANT: DB	'ALTAIRSIM HOSTBRIDGE',0
                
 0639 42        MODE:	DB	'B'		; the switch, when one was given
 063A 00        MODSET: DB	0		; 1 = a switch was given. A DB, because it
                				; must start at 0 (a DS is not in the .COM)
                
                ; EXTTAB: the text extensions (see the header). Three characters each,
                ; and a 0 ends the table.
 063B 41534D4D41EXTTAB: DB	'ASM','MAC','Z80','HEX','PRN'
 064A 4C53545359	DB	'LST','SYM','INC','SUB','TXT'
 0659 00        	DB	0
 065A 00        DRIVE:	DB	0
                
 065B 0D0A573A20MNOHB:	DB	CR,LF,'W: no hostbridge board at port B0H.',CR,LF
 0682 4164642061	DB	'Add a hostbridge board to the machine, or set its port'
 06B8 20746F2042	DB	' to B0.',CR,LF,'$'
                
 06C2 0D0A57202DMUSAGE: DB	CR,LF,'W -- copy a file from CP/M out to the host.  (1.4)',CR,LF,CR,LF
 06FA 2020205720	DB	'   W <cpmfile> [hostfile] [B|T]',CR,LF
 071B 2020205720	DB	'   W <pattern> [hostfolder] [B|T]',CR,LF,CR,LF
 0740 4578616D70	DB	'Examples',CR,LF
 074A 2020205720	DB	'   W FOO.ASM            CP/M FOO.ASM -> host FOO.ASM',CR,LF
 0780 2020205720	DB	'   W FOO.ASM SRC/F.ASM  ...into a subdirectory of hostdir',CR,LF
 07BB 2020205720	DB	'   W FOO.DAT T          stop at the first ^Z',CR,LF
 07E9 2020205720	DB	'   W *.*                every match, each under its own name'
 0825 0D0A      	DB	CR,LF
 0827 2020205720	DB	'   W *.ASM SRC          ...into folder SRC, which must exist'
 0863 0D0A0D0A  	DB	CR,LF,CR,LF
 0867 4220636F70	DB	'B copies every byte of every record, so a text file arrives'
 08A2 2077697468	DB	' with',CR,LF
 08A9 7468652072	DB	'the rest of its last record: a ^Z and whatever follows it.'
 08E3 0D0A      	DB	CR,LF
 08E5 542073746F	DB	'T stops at the first ^Z, which TRUNCATES anything binary.'
 091E 0D0A      	DB	CR,LF
 0920 5769746820	DB	'With neither, the extension decides. These are text:',CR,LF
 0956 2020204153	DB	'   ASM MAC Z80 HEX PRN LST SYM INC SUB TXT',CR,LF
 0982 4576657279	DB	'Every other file, a .COM included, is copied byte for byte.'
 09BD 0D0A      	DB	CR,LF
 09BF 4844495220	DB	'HDIR lists what is on the host. R copies the other way.'
 09F6 0D0A24    	DB	CR,LF,'$'
                
 09F9 573A2024  MPFX:	DB	'W: $'
 09FD 202D3E2024MARROW: DB	' -> $'
 0A02 2028746578MBYEXT: DB	' (text, by extension)$'
 0A18 207265636FMRECS:	DB	' records, $'
 0A23 2062797465MBYTES: DB	' bytes',CR,LF,'$'
 0A2C 573A2024  MERR:	DB	'W: $'
 0A30 0D0A24    MCRLF:	DB	CR,LF,'$'
                
 0A33 573A207468MELONG: DB	'W: the folder name is too long.',CR,LF,'$'
 0A55 573A206120MEWORD: DB	'W: a name is too long.',CR,LF,'$'
 0A6E 573A207468MEBADSW:DB	'W: the switch is B (every byte) or T (stop at the first ^Z).'
 0AAA 0D0A24    	DB	CR,LF,'$'
 0AAD 573A206E6FMENOMAT:DB	'W: no CP/M file matches.',CR,LF,'$'
 0AC8 573A206D6FMETOOM: DB	'W: more than 64 files match. Narrow the pattern.',CR,LF
 0AFA 2020204E6F	DB	'   Nothing was copied -- half a backup is worse than none.'
 0B34 0D0A24    	DB	CR,LF,'$'
 0B37 573A206E6FMENOCPM:DB	'W: no such CP/M file.',CR,LF,'$'
                
                ;---- Variables -------------------------------------------------------
                ; BUF: the DMA buffer, one CP/M record. BDOS READ and SEARCH put their
                ; data here.
 0B4F           BUF:	DS	RECLEN
                
 0BCF           XMODE:	DS	1		; B or T for this file (PICKMD)
 0BD0           AUTO:	DS	1		; 1 = the extension chose T
 0BD1           RECS:	DS	2		; records read from CP/M
 0BD3           BYTES:	DS	3		; the true byte count. 8 MB needs 24 bits.
 0BD6           FCB:	DS	36		; W's copy of the CCP's FCB (INIFCB)
 0BFA           HNAME:	DS	HNMAX+1		; the host name, given or made
 0C3B           HDIRP:	DS	HNMAX+2		; a wildcard's host folder, "SRC/" (SETDIR)
 0C7D           CNAME:	DS	HNMAX+1		; the first word of the tail
 0CBE           TOK2:	DS	HNMAX+1
 0CFF           TOK3:	DS	HNMAX+1
 0D40           IDBUF:	DS	IDMAX+1		; the board's signature
 0D61           NUMBUF: DS	8		; 8 digits: 16777215 is the largest count
 0D69           NUMEND: DS	1		; PRDEC and PRBYT build back from here
                
 0D6A           NCNT:	DS	1		; how many matches W found
 0D6B           DONE:	DS	1		; how many it has copied
 0D6C           NPTR:	DS	2		; the collect cursor into NAMES
 0D6E           CPTR:	DS	2		; the copy cursor into NAMES
 0D70           NAMES:	DS	MAXN*11		; 11 characters each, no dot, no drive
                
 1030           	DS	64		; the stack. BDOS is the deepest call.
 1070 =         STACK	EQU	$
                
 1070           	END	START
