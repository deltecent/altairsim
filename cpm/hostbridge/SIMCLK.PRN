

                ;-----------------------------------------------------------------------
                ; SIMCLK.COM: show or set the processor clock rate.
                ;
                ;	SIMCLK			show the rate
                ;	SIMCLK 2000000		run the processor at 2 MHz
                ;	SIMCLK 0		run the processor flat out
                ;
                ; Part of the altairsim Host Bridge. Assemble it in the machine:
                ;
                ;	ASM SIMCLK		-> SIMCLK.HEX
                ;	LOAD SIMCLK		-> SIMCLK.COM
                ;
                ; Revisions:
                ;	2026-11-14  First version (issue #918).
                ;
                ; The rate is in Hz, as decimal digits. The CPU board checks the range,
                ; as it does for SET cpu0 CLOCK_HZ=n at the monitor. SIMCLK prints the
                ; board's own error text when the CPU board refuses the rate.
                ;
                ; A SUBMIT file can assemble flat out and then go back to 2 MHz:
                ;
                ;	SIMCLK 0
                ;	ASM FOO
                ;	LOAD FOO
                ;	SIMCLK 2000000
                ;
                ; SIMCLK makes no BDOS file calls. It uses the console and ports B0H and
                ; B1H only.
                ;-----------------------------------------------------------------------
                
 0100           	ORG	100H
                
                ;---- CP/M ------------------------------------------------------------
 0005 =         BDOS	EQU	0005H
 0080 =         TAIL	EQU	0080H		; the command tail: length, then the text
                
 0002 =         CONOUT	EQU	2		; E = char
 0009 =         PRSTR	EQU	9		; DE = string, ends in '$'
                
 0020 =         IDMAX	EQU	32		; room for the board's signature
 0014 =         RTMAX	EQU	20		; room for a rate in decimal
 000D =         CR	EQU	0DH
 000A =         LF	EQU	0AH
                
                ;---- The Host Bridge (HB.INC has the full list) ----------------------
 00B0 =         HBCMD	EQU	0B0H		; OUT = command   IN = status
 00B1 =         HBDATA	EQU	0B1H		; data, both ways
                
 0001 =         RDY	EQU	01H		; clear while the machine applies a rate
 0010 =         HERR	EQU	10H		; the last operation failed
                
 0000 =         CIDENT	EQU	0
 0007 =         CERROR	EQU	7
 0008 =         CRESET	EQU	8
 000A =         CSETCK	EQU	0AH		; then the rate in Hz and a NUL
 000B =         CGETCK	EQU	0BH		; -> the rate as decimal text and a NUL
                
                ;=======================================================================
                ; MAIN
                ;=======================================================================
 0100 310003    START:	LXI	SP,STACK
                
 0103 3E08      	MVI	A,CRESET	; one byte puts the board in a known
 0105 D3B0      	OUT	HBCMD		; state
                
 0107 CD8B01    	CALL	IDENT		; exits if there is no board
                
 010A 218000    	LXI	H,TAIL
 010D 46        	MOV	B,M		; the length of the tail
 010E 23        	INX	H
 010F CDF101    	CALL	SKIPSP
 0112 78        	MOV	A,B
 0113 B7        	ORA	A
 0114 CA3F01    	JZ	SHOWRT		; no argument: show the rate
                
                ;---- set the rate -----------------------------------------------------
                ; The digits go to the board as they are in the tail. The board checks
                ; them, so SIMCLK has no buffer to overflow.
 0117 3E0A      	MVI	A,CSETCK
 0119 D3B0      	OUT	HBCMD
 011B 7E        SET1:	MOV	A,M
 011C FE20      	CPI	' '
 011E CA2801    	JZ	SET2		; the end of the word
 0121 D3B1      	OUT	HBDATA
 0123 23        	INX	H
 0124 05        	DCR	B
 0125 C21B01    	JNZ	SET1
 0128 AF        SET2:	XRA	A
 0129 D3B1      	OUT	HBDATA		; the NUL commits the request
                
                ; Wait for RDY. The machine applies the rate within a few thousand
                ; instructions. Send no command before RDY is set: any command drops a
                ; request that the machine has not applied yet.
 012B DBB0      SET3:	IN	HBCMD
 012D E601      	ANI	RDY
 012F CA2B01    	JZ	SET3
                
 0132 DBB0      	IN	HBCMD
 0134 E610      	ANI	HERR
 0136 CA3F01    	JZ	SHOWRT		; the rate is set
 0139 CDCC01    	CALL	REPERR		; bad digits, or the CPU board refused it
 013C C30000    	JMP	0		; warm boot
                
                ;---- show the rate ----------------------------------------------------
 013F 3E0B      SHOWRT: MVI	A,CGETCK
 0141 D3B0      	OUT	HBCMD
 0143 DBB0      	IN	HBCMD
 0145 E610      	ANI	HERR
 0147 CA5001    	JZ	SHW1
 014A CDCC01    	CALL	REPERR		; an older altairsim: no such command
 014D C30000    	JMP	0
                
 0150 21AA02    SHW1:	LXI	H,RATE
 0153 0614      	MVI	B,RTMAX
 0155 CDBF01    	CALL	RECVZ
                
 0158 118D02    	LXI	D,MPFX
 015B 0E09      	MVI	C,PRSTR
 015D CD0500    	CALL	BDOS
                
 0160 21AA02    	LXI	H,RATE		; "0" is flat out
 0163 7E        	MOV	A,M
 0164 FE30      	CPI	'0'
 0166 C27A01    	JNZ	SHW2
 0169 23        	INX	H
 016A 7E        	MOV	A,M
 016B B7        	ORA	A
 016C C27A01    	JNZ	SHW2
 016F 119602    	LXI	D,MFLAT
 0172 0E09      	MVI	C,PRSTR
 0174 CD0500    	CALL	BDOS
 0177 C30000    	JMP	0
                
 017A 21AA02    SHW2:	LXI	H,RATE
 017D CDFD01    	CALL	PSTR
 0180 11A102    	LXI	D,MHZ
 0183 0E09      	MVI	C,PRSTR
 0185 CD0500    	CALL	BDOS
 0188 C30000    	JMP	0
                
                ;=======================================================================
                ; THE HOST BRIDGE
                ;=======================================================================
                
                ;-----------------------------------------------------------------------
                ; IDENT: check that the board is there before anything else.
                ;
                ; An IN from a port that no board decodes reads 0FFH, and 0FFH has RDY
                ; and HERR set. Without this check, SIMCLK would print a host error.
                ;-----------------------------------------------------------------------
 018B 3E00      IDENT:	MVI	A,CIDENT
 018D D3B0      	OUT	HBCMD
                
 018F 21BF02    	LXI	H,IDBUF
 0192 0620      	MVI	B,IDMAX
 0194 DBB1      ID1:	IN	HBDATA
 0196 77        	MOV	M,A
 0197 B7        	ORA	A
 0198 CAA201    	JZ	ID2		; the terminator
 019B 23        	INX	H
 019C 05        	DCR	B
 019D C29401    	JNZ	ID1
 01A0 3600      	MVI	M,0		; no terminator: 0FFH, so no board
                
 01A2 21BF02    ID2:	LXI	H,IDBUF
 01A5 110C02    	LXI	D,IDWANT
 01A8 1A        ID3:	LDAX	D
 01A9 B7        	ORA	A
 01AA C8        	RZ			; all of IDWANT matched
 01AB BE        	CMP	M
 01AC C2B401    	JNZ	IDBAD
 01AF 23        	INX	H
 01B0 13        	INX	D
 01B1 C3A801    	JMP	ID3
                
 01B4 112102    IDBAD:	LXI	D,MNOHB
 01B7 0E09      	MVI	C,PRSTR
 01B9 CD0500    	CALL	BDOS
 01BC C30000    	JMP	0
                
                ;-----------------------------------------------------------------------
                ; RECVZ: read a string from the data port into HL.
                ;        B = the room, with the NUL.
                ;-----------------------------------------------------------------------
 01BF DBB1      RECVZ:	IN	HBDATA
 01C1 77        	MOV	M,A
 01C2 B7        	ORA	A
 01C3 C8        	RZ
 01C4 23        	INX	H
 01C5 05        	DCR	B
 01C6 C2BF01    	JNZ	RECVZ
 01C9 3600      	MVI	M,0		; no room left: cut the string here
 01CB C9        	RET
                
                ;-----------------------------------------------------------------------
                ; REPERR: print the board's error message, in the host's words.
                ;-----------------------------------------------------------------------
 01CC 3E07      REPERR: MVI	A,CERROR
 01CE D3B0      	OUT	HBCMD
 01D0 DBB1      	IN	HBDATA		; the code byte: skip it
                
 01D2 118D02    	LXI	D,MPFX
 01D5 0E09      	MVI	C,PRSTR
 01D7 CD0500    	CALL	BDOS
                
 01DA DBB1      RPE1:	IN	HBDATA		; then the text, one character at a time
 01DC B7        	ORA	A
 01DD CAE901    	JZ	RPE2
 01E0 5F        	MOV	E,A
 01E1 0E02      	MVI	C,CONOUT
 01E3 CD0500    	CALL	BDOS
 01E6 C3DA01    	JMP	RPE1
                
 01E9 11A702    RPE2:	LXI	D,MCRLF
 01EC 0E09      	MVI	C,PRSTR
 01EE C30500    	JMP	BDOS		; tail call
                
                ;=======================================================================
                ; THE COMMAND TAIL
                ;=======================================================================
                
                ; SKIPSP: step HL past spaces.  B = characters left in the tail.
 01F1 78        SKIPSP: MOV	A,B
 01F2 B7        	ORA	A
 01F3 C8        	RZ
 01F4 7E        	MOV	A,M
 01F5 FE20      	CPI	' '
 01F7 C0        	RNZ
 01F8 23        	INX	H
 01F9 05        	DCR	B
 01FA C3F101    	JMP	SKIPSP
                
                ;=======================================================================
                ; MESSAGES TO THE USER
                ;=======================================================================
                
                ; PSTR: print the string at HL. HL is pushed across the BDOS call.
 01FD 7E        PSTR:	MOV	A,M
 01FE B7        	ORA	A
 01FF C8        	RZ
 0200 E5        	PUSH	H
 0201 5F        	MOV	E,A
 0202 0E02      	MVI	C,CONOUT
 0204 CD0500    	CALL	BDOS
 0207 E1        	POP	H
 0208 23        	INX	H
 0209 C3FD01    	JMP	PSTR
                
                ;=======================================================================
                ; DATA
                ;=======================================================================
 020C 414C544149IDWANT: DB	'ALTAIRSIM HOSTBRIDGE',0
                
 0221 0D0A53494DMNOHB:	DB	CR,LF,'SIMCLK: no host bridge at B0H.',CR,LF
 0243 5468697320	DB	'This machine has no `hostbridge` board in it, or it is at'
 027C 20616E6F74	DB	' another port.',CR,LF,'$'
                
 028D 53494D434CMPFX:	DB	'SIMCLK: $'
 0296 666C617420MFLAT:	DB	'flat out',CR,LF,'$'
 02A1 20487A0D0AMHZ:	DB	' Hz',CR,LF,'$'
 02A7 0D0A24    MCRLF:	DB	CR,LF,'$'
                
                ;---- variables --------------------------------------------------------
 02AA           RATE:	DS	RTMAX+1		; the rate from the board, as text
 02BF           IDBUF:	DS	IDMAX+1
                
 02E0           	DS	32		; the stack
 0300 =         STACK	EQU	$
                
 0300           	END	START
