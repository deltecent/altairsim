scc$init:
	call baud$adr			;				wbd-1
	mov l,m ! mov h,0 ! dad h	; get baud rate, times   ;
;      S      D  D   S       Y Y   S        T    E      M MM M  S             ;
;       SSS   D  D    SSS     Y     SSS     T    EEE    M    M   SSS          ;
;         S   D  D       S    Y        S    T    E      M    M      S         ;
;     S up default baud rates
	mov a,c	! cpi max$devices	; c holds device number 0-15
	rnc				; invalid device
	call	setix
	ldx	l,init$off
	ldx	h,init$off+1
	pchl

vdb$init:				; vdb board, no init req'd	wbd-2
pio$init:				; 200 parallel, no init req'd	w===================;

	; Character I/O for the Modular CP/M 3 BIOS

	; limitations:

	;		baud rates 7200,3600 and 1800 are approximations.

	;		9600 is the maximum baud rate that is likely
	;			to work.

	;		baud rate 19200 is not supported.

 2
	pop d ! dad d			; point to counter entry
	mov a,m ! sta speed$lsb		; get and save scc count
	inx h ! mov a,m ! sta speed$msb
	ldx a,stat$off
	sta scc$port			; get status port byte
	lxi h,scc$init$tbl
	jmp stream$out

	endif	; io8 or io4

