io8$base	equ	0A0h		; io8 board base address
io8$clk		equ	001h
sys$clk		equ	003h
cl$4mhz		equ	false		; not using buss clock
baud$loc	equ	0FF80h+10	; location of baud rate constants

	cseg

?cinit:
	if not loader

	call get$bauds			; setck save routine in ?ci and ?co		      dkb,wbd.7/8/83  ;
