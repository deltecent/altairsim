data$off	equ	0	; offsets into device tables
stat$off	equ	1
rxmask$off	equ	2
tx$mask$off	equ	3
strob$off	equ	4
inv$mask$off	equ	5
init$off	equ	6

null$strobe	equ	0
inv$data	equ	1111$1111b
non$inv$data	equ	0000$00 a,4Fh ! jrc hispeed
