	inx h ! mov c,m ! inx h
	outirееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее   ; No external clock.
?time:
	ret

	; CP/M BDOS Function Interfaces

open:
	mvi c,15 ! jmp bdos		; open file control block

setdma:
	mvi c,26 ! jmp bdos		; set data transfer address

setmulti:
	mvi c,44 ! jmp bdos		; set record count

read;***********************************************************************;
;									;
;     SSS   DDDD      SSS   Y   Y   SSS   TTTTT  EEEEE  M    M   SSS    ;
;    S   S  D  D     S   S  Y   Y  S   S    T    E      MM  MM  S   S   ;
;    S      D  D  $dev ! shld @covec		; and console out vector
	lhld lst$out$dev ! shld @lovec		; and list output vector
	lhld aux$in$dev ! shld @aivec		; and auxilary input vector
	lhld aux$out$dev ! shld @aovec		; and auxilary output vector
						; from init sector atD ?time routine for MPC4 clock	wbd...7/26/83   ;
;	1.6	RELEASE for distribution CPM30 rel 1.6	wbd...7/26/83	;
;***********************************************************************;

	extrn 	@date,@hour,@min,@sec,diretrn,eiretrn	;	wbd..1.6d
	public	,a ! inx h ! mov c,m ! inx h	; get byte in b,port in c
	outir					; send byte
	jmp out$blocks				; loop til done


?time:						
	if io8 or io4 or mpc4			;		wbd..1.6d
	push h ! push d	! mov a,c		; save regs
	lxi h,timout ! push h			; set return addr   S       Y Y   S        T    E      M MM M  S       ;
;     SSS   D  D      SSS     Y     SSS     T    EEE    M    M   SSS    ;
;       S   D  D         S    Y        S    T    E      M    M      S   ;
;   S   S   D  D     S   S    Y    S   S    T     ff80h
	page
;*****************************************************************
;*	This Subroutine save the location of the drives swapped	*
;*		into location 0ffb0h thru 0ffbfh in ram		*
;**************************************************************?init,?ldccp,?rlccp,?time,@slice
	extrn	?pmsg,?conin,?sldsk,?bank		;	wbd..1.6d
	extrn	@civec,@covec,@aivec,@aovec,@lovec
	extrn 	@cbnk,@dbnk,?bnksl,@dtbl

	maclib ports
	maclib z80
	maclib cond
	page
bdos		equ 5
dtbl$order	equ	0ffb0h		; drive tabess
	mvi c,rtc ! mvi b,1			; set c for port, b as filler
	ora a ! jz gettm			; is it set or get?
	jmp settm				; DO NOT REMOVE
	endif	;io8 or io4 or mpc4				wbd..1.6d

	if io8 or io4				;		wbd..1.6d
settm:	
	xra a ! sta @sec			; set seconds to zeroE      M    M  S   S   ;
;    SSS    DDDD      SSS     Y     SSS     T    EEEEE  M    M   SSS    ;
;									;
;									;
;	 		SD SYSTEMS, INC.				;
;			10111 MILLER RD.				;
;			DALLAS, TX 75238				;
;									;
;		       (214) - 340 - 0303				;***
;
	lxi	h,100h				; set hl at drive table
	lxi	d,101h				; and de at destination
	push d	! lxi b,32			; setup for zero mem
	xra	a ! mov m,a	
	ldir					; zero filled 100-120h
	pop d ! dcx d				; restore de,hl
	lxi h,@dtbl				; point to drive tablle orders dkb...r1.6
con$in$dev	equ	0FF80H				; rm..v1.03
con$out$dev	equ	con$in$dev+2
aux$in$dev	equ	con$out$dev+2
aux$out$dev	equ	aux$in$dev+2
lst$out$dev	equ	aux$out$dev+2
itable	equ	0fff0h		; WARNING  save room in gencpm **********
ctc0	equ	78h
	mvi a,15h ! out rtcrs ! outp b		; start clock at 0.000 seconds
	mvi a,03h ! out rtcrs ! lhld @hour ! outp h	; set the minutes
	mvi a,04h ! out rtcrs ! outp l		; set the hours
updt:	mvi a,06h ! out rtcrs ! outp b		; set d-o-m to 1
	mvi a,07h ! out rt
