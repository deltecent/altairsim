	Title 'BOOT loader module for CP/M3 linked BIOS'

;***************************************************************e
	pushix
	mvi	b,16
	lxix	dtbl$order			; set ix to order table
mov$lop1:
	push b ! mvi b,0 ! push h		; setup for index save @dtbl
	ldx	a,0				; get order byte
	ani 15					; strip top nibble off
	rlc ! mov c,a ! dad b			; set up hl for move
	ldi
	
ctc1	equ	ctc0+1
ctc2	equ	ctc0+2
ctc3	equ	ctc0+3
rtcrs	equ	0A5h		; io8 clock address		wbd...1.6
rtc	equ	0A6h		; io8 clock address		wbd...1.6
mpcadr	equ	07h		; mpc4 addresses		wbd..1.6d
mpcmem	equ	1000h		;				wbd..1.6d
sec	equ	mpcmem+3AAh	;				wbd..1crs ! outp b		; set month to 1
	lhld @date				; get date from scb
	mvi a,0Bh ! out rtcrs ! outp l		; store msb in clk ram (min)
	mvi a,0Ch ! out rtcrs ! outp h		; store lsb in clk ram (hrs)
	ret					; return to caller
	page
gettm:	
	mvi a,06h ! out ********;
;	Rev.    Description				Initials-Date	;
;-----------------------------------------------------------------------;
;	0.1	1st working Version			dkb...1/17/83	;
;	1.0	1st release Version			dkb...1/23/83	;
;	1.1  	set up timer interrupt, clock ldi					; move two bytes
	inxix					; increment ix pointer
	pop h ! pop b! djnz mov$lop1		; do all of them
	popix					; restore ix register
	lxi h,100h ! lxi d,@dtbl ! lxi b,32	; setup for  move
	ldir					; move it in
;
;****************************.6d
min	equ	mpcmem+3A9h	;				wbd..1.6d
hour	equ	mpcmem+3A8h	;				wbd..1.6d
day	equ	mpcmem+3A7h	;				wbd..1.6d
mon	equ	mpcmem+3A6h	;				wbd..1.6d
date	equ	mpcmem+3A2h	; cpm date storage in mpc4	wbd..1.6d

	if banked
tpa$bank	equ 1
	else
tpa$bank	ertcrs ! inp a		; get day from clock
	lxi h,@date ! mov m,a ! xra a ! rld	; save it and clear a
	add a ! mov e,a	! add a ! add a		; high nibble x2, save in e
	add e ! mov e,a	! xra a	! rld		; high nib x10, save in e
	add e ! dcr a ! mov e,a			; day is nstuff  B. Asner.1/29/83	;
;	1.2	put conditional flag in maclib cond.lib dkb...2/02/83	;
;	1.3	modified release message to 1.4		rm....3/25/83	;
