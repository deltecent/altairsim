	db	0,0,0,0,0,0,0,0,0	; bios scratch area
	db	0			; media flag
dubadr:	dw	ramdub			; disk parameter block (dpb)
	dw	-2			; checksum allocated by gencpm
	dw	-2			; alloc vector allocateееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее
	call	?pderr			
	lxi	h,ckms
	call	?pmsg
	lhld	hladr			; dkb-1
	call	?pdec
	lxi	h,ckms1
	call	?pmsg
	lhld	deadr			; dkb-1
	call	?pdec
	lxi	h,crlf
