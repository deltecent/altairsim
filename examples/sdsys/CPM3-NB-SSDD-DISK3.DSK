;	The following drive table was used to create this system
;	
;------------------------------------------------------------------
@dtbl:
UNIT$A:	dw	fdsd0		; use floppy as logical  unit 'A'
UNIT$B:	dw	fdsd1		; use floppy as logical  unidirs,?off,?ncks
    local ?spt,?bsh,?blm,?exm,?dsm,?drm,?al0,?al1,?cks,?psh,?psm
    local ?n
;; physical sector mask and physical sector shift
    ?psh	set 0
    ?n		set ?psize/128
    ?psm	set ?n-1
	rept 8
	?n	set ?n/2
 	    if ?n = 0 
	    exi
;									;
;		       COPYRIGHT (C) 1983				;
;									;
;***********************************************************************;

	title	'DRVTBL for SDSystems 1983'

;***********************************************************************;
;	Re;	Macro Definitions for CP/M3 BIOS Data Structures.

	; dtbl	<dph0,dph1,...>		- drive table

	; dph	translate$table,	- disk parameter header
	;	disk$parameter$block,
	;	checksum$size,			(optional)
	;	alloc$size			(optional)

	; skew	sectors,		- skt 'B'
UNIT$C:	dw	0
UNIT$D:	dw	0
UNIT$E:	dw	0
UNIT$F:	dw	0
UNIT$G:	dw	0		; use zero value for unused logical units
UNIT$H:	dw	0
UNIT$I:	dw	0
UNIT$J:	dw	0		; *************************************
UNIT$K:	dw	0		; NOTE: This table must contain 16 wordtm
	    endif
	?psh	set ?psh + 1
	endm
    ?spt	set ?pspt*(?psize/128)

    ?bsh	set 3
    ?n		set ?bls/1024
	rept 8
	?n	set ?n/2
	    if ?n = 0
	    exitm
	    endif
	?bsh	set ?bsh + 1
	endm
    ?blm	set ?bls/128-1
    ?size	set (?trks-?ofv.    Description				Initials-Date	;
;-----------------------------------------------------------------------;
;	0.10	1st working Version			dkb...1/17/83	;
;	1.00	1st release Version			dkb...1/23/83	;
;									;
;*************************************ew table
	;	skew$factor,
	;	first$sector$number

	; dpb	physical$sector$size,	- disk parameter block
	;	physical$sectors$per$track,
	;	number$tracks,
	;	block$size,
	;	number$dir$entries,
	;	track$offset,
	;	checksum$vec$size		(optional)


;	D 
UNIT$L:	dw	0		; entries for gencpm.com
UNIT$M:	dw	0		; *************************************
UNIT$N:	dw	0
UNIT$O:	dw	0
UNIT$P:	dw	0
	end
f)*?spt
    ?dsm	set ?size/(?bls/128)-1

    ?exm	set ?bls/1024
	if ?dsm > 255
	    if ?bls = 1024
.'Error, can''t have this size disk with 1k block size'
	    exitm
	    endif
	?exm	set ?exm/2
	endif
    ?exm	set ?exm-1
    ?all	set 0
    ?n	**********************************;
;
;	The drvtbl.asm file is used to configure hardware drivers
;	into a CP/M 3.0 plus operating system.
;
;	To add a driver or reconfigure the operating system the
;	following steps must be completed.
;
;		1- Defirive Table.  Contains 16 one word entries.

dtbl macro ?list
    local ?n
?n  set 0
    irp ?drv,<?list>
?n  set ?n+1
	dw	?drv
    endm

    if ?n > 16
.' Too many drives.  Max 16 allowed'
	exitm
    endif

    if ?n < 16
	rept (16-?n)
	dwееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее	set (?ndirs*32+?bls-1)/?bls
	rept ?n
	?all	set (?all shr 1) or 8000h
	endm
    ?al0	set high ?all
    ?al1	set low ?all
    ?drm	set ?ndirs-1
    if not nul ?ncks
    	?cks	set ?ncks
    else
	?cks	set ?ndirs/4
    endif
	dw	?spt		; 128 byte rne the new driver xdph as an external referance
;		   The current driver definitions are:
;			fdsdX = floppy disk where X = 0..3
;			wdsvX = winchester 2isk where X = 0 or 1
;			rdsd0 = ramdisk  
;			rdsd1 = romdisk
;			hdsdX = CDC-9448 where X is 0.	0
	endm
    endif
 endm

dph macro ?trans,?dpb,?csize,?asize
    local ?csv,?alv
	dw ?trans		; translate table address
	db 0,0,0,0,0,0,0,0,0	; BDOS Scratch area
	db 0			; media flag
	dw ?dpb			; disk parameter block
    if not nul ?csize
	dw ?ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееecords per track
	db	?bsh,?blm	; block shift and mask
	db	?exm		; extent mask
	dw	?dsm		; maximum block number
	dw	?drm		; maximum directory entry number
	db	?al0,?al1	; alloc vector for directory
	dw	?cks		; checksum size
	dw	?off		; offset for sys.11 
;
;		2- Enter the externally defined xdph in the drive table.
;
;		   Enter the xdph name in the drive table at the relative
;		   location in the table to obtain the logical drive
;		   value desired (i.e. logical drive A..P). 
;
;		   Enter csv			; checksum vector
    else
	dw 0FFFEh		; checksum vector allocated by
    endif			; GENCPM
    if not nul ?asize
	dw ?alv			; allocation vector
    else
	dw 0FFFEh		; alloc vector allocated by GENCPM
    endif
	dw 0fffeh,0fffeh,0fffeh	; dirbееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееtem tracks
	db	?psh,?psm	; physical sector size shift
				; and mask
    endm

;
gcd macro ?m,?n
	    ;;	greatest common divisor of m,n
		    ;;	produces value gcdn as result
		    ;;	(used in sector translate table generation)
    ?gcdm	set ?m	;a zero value in the drive table for logical drives
;		   which are not used. 
;------------------------------------------------------------------

	public @dtbl
	extrn	fdsd0,fdsd1			; floppy disks
;----------------------------------------------------cb, dtabcb, hash alloc'd
				; by GENCPM
	db 0			; hash bank

    if not nul ?csize
?csv	ds	?csize		; checksum vector
    endif
    if not nul ?asize
?alv	ds	?asize		; allocation vector
    endif

    endm

dpb macro ?psize,?pspt,?trks,?bls,?n;variable for m
    ?gcdn	set ?n	;;variable for n
    ?gcdr	set 0	;;variable for r
	rept 65535
	?gcdx	set ?gcdm/?gcdn
	?gcdr	set ?gcdm - ?gcdx*?gcdn
	    if ?gcdr = 0
	    exitm
	    endif
	?gcdm	set ?gcdn
	?gcdn	set ?gcdr
	endm
    endm

ske   S       Y Y   S        T    E      M MM M  S       ;
;     SSS   D  D      SSS     Y     SSS     T    EEE    M    M   SSS    ;
;       S   D  D         S    Y        S    T    E      M    M      S   ;
;   S   S   D  D     S   S    Y    S   S    T    
;									;
