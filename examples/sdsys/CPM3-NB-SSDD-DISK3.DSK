	Title	'Cold booter for CP/M+'

;=======================================================================;
;  Rev. ===========================================;
;
;
; conditional assembly switches
;
false		equ	0
true		equ	not false
;
function$keys	equ	false
loader		equ	false
mpc4 		equ	false
io4		equ	false
io8		equ	false
banked		equ	false
hardsk		equ	falsel:
	shld sctr ! shld nohds ! xchg		; update sector and #heads

loader:
	call expchl ! jrnz cold2		; start up cpmldr

dismem:
	jmpr sw 				; go do it

expchl:
	pchl

cold2:
	lxi h,ermsg

cold0:
	mov a,m ! ora a ! jrz cold		; exit if zero
	m	set ?nelts-1
	    if ?nelts = 0
	    ?nxtbas	set ?nxtbas+1
	    ?nxtsec	set ?nxtbas
	    ?nelts	set ?neltst
	    endif
	endm
    endm
