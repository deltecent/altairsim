	title 'System Control Block Definition for CP/M3 BIOS'

;*********************************************************	title 'System Control Block Definition for CP/M3 BIOS'

	public @civec, @covec, @aivec, @aovec, @lovec, @bnkbf
	public @crdma, @crdsk, @vinfo, @resel, @fx, @usrcd 
        public @mltio, @ermde, @erdsk, @media, @bflgs
	public @date, @hour, @min, @secееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее**************;
;	Rev.    Description				Initials-Date	;
;-----------------------------------------------------------------------;
;	1.00	1st release Version			dkb...1/23/83	;
;									;
;**************************************************************************
        org     100h    ;base of tpa
;
reboot  equ     0000h   ;system reboot
bdos    equ     0005h   ;bdos entry point
;
coninp  equ     1       ;console input function
conout  equ     2       ;console output function
pstring equ     Multi-Sector Count
				; (byte,r/w)
@ERMDE  equ     scb$base+4Bh    ; BDOS Error Mode (byte, r/o)
@ERDSK	equ	scb$base+51h	; BDOS Error Disk (byte,r/o)
@MEDIA	equ	scb$base+54h	; Set by BIOS to indicate
				; open door (byte,r/w)
@BFLGS  equ     scb$ba     jnz     ready
;
;       cannot open file, so create it
        mvi     c,makef
        lxi     d,fcb
        call    bdos
        inr     a       ;err 255 becomes zero
        jnz     ready
;
;       cannot create file, directory full
      *********;


	public @civec, @covec, @aivec, @aovec, @lovec, @bnkbf
	public @crdma, @crdsk, @vinfo, @resel, @fx, @usrcd 
        public @mltio, @ermde, @erdsk, @media, @bflgs
	public @date, @hour, @min, @sec, ?erjmp, @mxtpa


scb$base equ    0FE009       ;print string until '$'
rstring equ     10      ;read console buffer
version equ     12      ;return version number
openf   equ     15      ;file open function
closef  equ     16      ;close function
makef   equ     22      ;make file functionse+57h    ; BDOS Message Size Flag (byte,r/o)  
@DATE   equ     scb$base+58h    ; Date in Days Since 1 Jan 78 
                                ; (word, r/w)
@HOUR   equ     scb$base+5Ah    ; Hour in BCD (byte, r/w)
@MIN    equ     scb$base+5Bh    ; Min  lxi     d,nospace
        call    print
        jmp     reboot  ;back to ccp
;
;***************************************************
;*                                                 *
;*  loop back to "ready" after each command        *
;*       H          ; Base of the SCB

@CIVEC  equ     scb$base+22h    ; Console Input Redirection 
                                ; Vector (word, r/w)
@COVEC  equ     scb$base+24h    ; Console Output Redirection 
                                ; Vector (wor
readr   equ     33      ;read random
writer  equ     34      ;write random
wrtrzf	equ	40	;write random zero fill
parsef  equ     152	;parse function
;
fcb     equ     005ch   ;default file control block
ranrec  equ     fcb+33  ;random record positiute in BCD (byte, r/w)
@SEC    equ     scb$base+5Ch    ; Second in BCD (byte, r/w)
?ERJMP  equ     scb$base+5Fh    ; BDOS Error Message Jump
                                ; (word, r/w)
@MXTPA  equ     scb$base+62h    ; Top of User TPA 
                                                       *
;***************************************************
;
ready:
;       file is ready for processing
;
        call    readcom ;read next command
        shld    ranrec  ;store input record#
        lxi    d, r/w)
@AIVEC  equ     scb$base+26h    ; Auxiliary Input Redirection 
                                ; Vector (word, r/w)
@AOVEC  equ     scb$base+28h    ; Auxiliary Output Redirection 
                                ; Vector (word, r/w)
@LOVEC  eqon
ranovf  equ     fcb+35  ;high order (overflow) byte
buff    equ     0080h   ;buffer address
;
cr      equ     0dh     ;carriage return
lf      equ     0ah     ;line feed
;
;***************************************************
;*                                     ; (address at 6,7)(word, r/o)
	end

r Message Jump
                                ; (word, r/w)
@MXTPA  equ     scb$base+62h    ; Top of User TPA 
              h,ranovf
        mov     m,c     ;set ranrec high byte
        cpi     'Q'     ;quit?
        jnz     notq
;
;       quit processing, close file
        mvi     c,closef
        lxi     d,fcb
        call    bdos
        inr     a       ;err 255 u     scb$base+2Ah    ; List Output Redirection 
                                ; Vector (word, r/w)
@BNKBF  equ     scb$base+35h    ; Address of 128 Byte Buffer 
                                ; for Banked BIOS (word, r/o)
@CRDMA  equ     scb$base+3                               *
;* load SP, set-up file for random access          *
;*                                                 *
;***************************************************
        lxi     sp,stack
;
;       version 3.1?
        mееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееbecomes 0
        jz      error   ;error message, retry
        jmp     reboot  ;back to ccp
;
;***************************************************
;*                                                 *
;* end of quit command, process write            Ch    ; Current DMA Address 
                                ; (word, r/o)
@CRDSK  equ     scb$base+3Eh    ; Current Disk (byte, r/o)
@VINFO  equ     scb$base+3Fh    ; BDOS Variable "INFO" 
                                ; (word, r/o)
@RESEL  equ    vi     c,version
        call    bdos
        cpi     31h     ;version 3.1 or better?
        jnc     versok
;       bad version, message and go back
        lxi     d,badver
        call    print
        jmp     reboot
;
versok:
;       correct ;***************************************************
;*                                                 *
;* sample random access program for cp/m 3         *
;*                                                 *
;***************************************  *
;*                                                 *
;***************************************************
notq:
;       not the quit command, random write?
        cpi     'W'
        jnz     notw
;
;       this is a random write, fill buffer u scb$base+41h    ; FCB Flag (byte, r/o)
@FX     equ     scb$base+43h    ; BDOS Function for Error 
                                ; Messages (byte, r/o)
@USRCD  equ     scb$base+44h    ; Current User Code (byte, r/o)
@MLTIO	equ	scb$base+4Ah	; Current version for random access
        mvi     c,openf ;open default fcb
rdname: lda     fcb+1
	cpi	' '
	jnz	opfile
	lxi	d,entmsg
	call 	print
	call 	parse
	jmp	versok
opfile:	lxi	d,fcb
	call    bdos
        inr     a       ;err 255 becomes zero
   ntil cr
        lxi     d,datmsg
        call    print   ;data prompt
        mvi     c,127   ;up to 127 characters
        lxi     h,buff  ;destination
rloop:  ;read next character to buff
        push    b       ;save counter
        push    h    
        push    h       ;save next to get
        cpi     ' '     ;graphic?
        cnc     putchr  ;skip output if not
        pop     h
        pop     b
        dcr     c       ;count=count-1
        jnz     wloop
        jmp     ready
;
;***  pop     b       ;restore next to fill
        cpi     cr      ;end of line?
        jz      erloop1
;       not end, store character
        mov     m,a
        inx     h       ;next to fill
        dcr     c       ;counter goes down
        jnz  d,prompt
        call    print   ;command?
        mvi     c,rstring
        lxi     d,conbuf
        call    bdos    ;read command line
;       command line is present, scan it
	mvi	c,0	;start with 00
        lxi     h,0     ;           0000
        ;next destination
        call    getchr  ;character to a
        pop     h       ;restore counter
        pop     b       ;restore next to fill
        cpi     cr      ;end of line?
        jz      erloop
;       not end, store character
       ************************************************
;*                                                 *
;* end of read command, all errors end-up here     *
;*                                                 *
;*******************************************   rloop1  ;end of buffer?
erloop1:
;       end of read loop, store 00
        mvi     m,0
;
;       write the record to selected record number
        mvi     c,wrtrzf
        lxi     d,fcb
        call    bdos
        ora     a       ;error code   lxi     d,conlin;command line
readc:  ldax    d       ;next command character
        inx     d       ;to next command position
        ora     a       ;cannot be end of command
        rz
;       not zero, numeric?
        sui     '0'
        cp mov     m,a
        inx     h       ;next to fill
        dcr     c       ;counter goes down
        jnz     rloop   ;end of buffer?
erloop:
;       end of read loop, store 00
        mvi     m,0
;
;       write the record to selected record numbe********
;
error:
        lxi     d,errmsg
        call    print
        jmp     ready
;
;***************************************************
;*                                                 *
;* utility subroutines for console i/o             * zero?
        jnz     error   ;message if not
        jmp     ready   ;for another record
;
;***************************************************
;*                                                 *
;* end of write commands, process read             i     10      ;carry if numeric
        jnc     endrd
;       add-in next digit
	push 	psw
	mov	a,c	;value = ahl
	dad	h
	adc	a	;*2
	push	a	;save value * 2
	push	h
        dad     h       ;*4
	adc	a
	dad	h	;*8
	adc	a
	pop	b	;*2 + *8 = *10
	dadr
        mvi     c,writer
        lxi     d,fcb
        call    bdos
        ora     a       ;error code zero?
        jnz     error   ;message if not
        jmp     ready   ;for another record
;
;
;**********************************************
;*                                                 *
;***************************************************
getchr:
        ;read next console character to a
        mvi     c,coninp
        call    bdos
        ret
;
putchr:
        ;write charac*
;*                                                 *
;***************************************************
notf:
;       not a write command, read record?
        cpi     'R'
        jnz     error   ;skip if not
;
;       read random record
     	b
	pop	b
	adc	b
	pop	b  	;+digit
	mov	c,b
	mvi	b,0
	dad	b
	aci	0
	mov	c,a
	jnc	readc
        jmp     readcom
endrd:
;       end of read, restore value in a
        adi     '0'     ;command
        cpi     'a'     ;translate case?
        rc**********
;*                                                      *
;* end of write command, process write random zero fill *
;*                                                      *
;********************************************************
notw:
;ter from a to console
        mvi     c,conout
        mov     e,a     ;character to send
        call    bdos    ;send character
        ret
;
crlf:
        ;send carriage return line feed
        mvi     a,cr    ;carriage return
        call       mvi     c,readr
        lxi     d,fcb
        call    bdos
        ora     a       ;return code 00?
        jnz     error
;
;       read was successful, write to console
        call    crlf    ;new line
        mvi     c,128   ;max 128 characte
;       lower case, mask lower case bits
        ani     101$1111b
        ret		;return with value in chl
;
;***************************************************
;*                                                 *
;* string data area for console me       not the quit command, random write zero fill?
        cpi     'F'
        jnz     notf
;
;       this is a random write, fill buffer until cr
        lxi     d,datmsg
        call    print   ;data prompt
        mvi     c,127   ;up to 127 chaputchr
        mvi     a,lf    ;line feed
        call    putchr
        ret
;
parse:
	;read and parse filespec
	lxi	d,conbuf
	mvi	c,rstring
	call 	bdos
	lxi	d,pfncb
	mvi	c,parsef
	call 	bdos
	ret
;
print:
        ;print the buffer addressers
        lxi     h,buff  ;next to get
wloop:
        mov     a,m     ;next character
        inx     h       ;next to get
        ani     7fh     ;mask parity
        jz      ready   ;for another command if 00
        push    b       ;save counterssages           *
;*                                                 *
;***************************************************
badver:
        db      'sorry, you need cp/m version 3$'
nospace:
        db      'no directory space$'
datmsg:
        dbracters
        lxi     h,buff  ;destination
rloop1: ;read next character to buff
        push    b       ;save counter
        push    h       ;next destination
        call    getchr  ;character to a
        pop     h       ;restore counter
      d by de until $
        push    d
        call    crlf
        pop     d       ;new line
        mvi     c,pstring
        call    bdos    ;print the string
        ret
;
readcom:
        ;read the next command line to the conbuf
        lxi           'type data: $'
errmsg:
        db      'error, try again.$'
prompt:
        db      'next command? $'
entmsg:
	db	'enter filename: $' 
;
;***************************************************
;*                                                 
; 1.1	Updated for 4 Ram boards			       wbd... 3/7/83  ;
; 1.2	Checksum added					       wbd... 3/9/83  ;
; 1.3	Rom read and login routines corrected		       wbd... 3/15/83 ;
; 1.4	Correct match byte on rom login			       wbd... 3/30/83 ;
; 1.5	RELEAееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееof normal entry   dkb 1.7a
	mvi a,jmp 			; jump instruction	    dkb 1.7a
	sta ram$init ! shld ram$init+1	; set up bypass for future  dkb 1.7a
	jr ram$sel  			; now do normal thing	    dkb 1.7a

ram$check$byte:
	xra	a
	sta	track+1
	sta	sector
	lda	*
;* fixed and variable data area                    *
;*                                                 *
;***************************************************
conbuf: db      conlen  ;length of console buffer
consiz: ds      1       ;resulting size SE for distribution CPM30 rel 1.5		       dkb... 5/23/83 ;
; 1.6a	Change bank selects thru ?bank                         efj... 7/13/83 ;
; 1.6b 	Change Initialization for new release		       dkb... 7/13/83 ;
; 1.6	RELEASE for distribution CPM30 rel 1.6******************************************************************************;
;									      ;
;            SSS   DDDD     SSS   Y   Y   SSS   TTTTT  EEEEE  M    M   SSS    ;
;          S   S   D  D   S   S   Y Y   S   S    T    E      MM  MM  S   S offset
	sta	track
	call	diskaddr		; set sector and track
	dcx	h			; backup one
	mov 	a,l ! out latch1 
	mov	a,h ! out latch2
	ret

;********************NEW INIT******************************
ram$sel:				;			..dkb 1.7a
	lda	init$flag		; get init fafter read
conlin: ds      32      ;length 32 buffer
conlen  equ     $-consiz
;
pfncb:
	dw	conlin
	dw	fcb
;
        ds      32      ;16 level stack
stack:
        end
		       wbd... 7/13/83 ;
; 1.7a  Fix initialization problem			       wbd... 8/2/83  ;
; 1.7b	Fix error return				       efj... 8/11/83 ;
;=============================================================================;
;
;	This program reads and writes   ;
;         S       D  D   S       Y Y   S        T    E      M MM M  S         ;
;         SSS    D  D    SSS     Y     SSS     T    EEE    M    M   SSS       ;
;           S   D  D       S    Y        S    T    E      M    M      S       ;
;      lag		..dkb-3
	ora	a			; non zero		..dkb-3
	cnz 	init			; go init it		..dkb-3
	xra	a			; clear flag		..dlb-3
	sta	init$flag		; so next no initiali	..dkb-3
	jmp	ram$find$size		; terminate as usaul	..dkb-3
 
init:
	push	h
	call	ram$find$size		; get sееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее to a Ramdisk
;	the addressing provided is track and sector
;	the register conventions conform to cpm


	extrn	@cbnk,@dbnk,@dma,@sect,@trk,@rdrv,?pderr,?pdec,?pmsg
	extrn	?bank
	public	rdsd0,rdsd1
	maclib	z80
;
;		equates for ramdisk
bdseldsk	eqS   S   D  D   S   S    Y    S   S    T    E      M    M  S   S        ;
;      SSS   DDDD     SSS     Y     SSS     T    EEEEE  M    M   SSS          ;
;									      ;
;									      ;
;		 		SD SYSTEMS, INC.			      ;
;				10111 MILLER RD.			     ize of ramdisk
	pop	h
	mvi	a,0			; get sector # for initialization
	sta	sector
	sta	track+1
;
	lda	offset			; get # of system tracks
	sta	track
	lhld	dsksize
	inx	h			; bump one for count 		..dkb-3
	lda	spt+2			; get shift factor
setsize:
	dad	ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееu	0c0h		; board select address
latch0	equ	bdseldsk
latch1	equ	bdseldsk+1
latch2	equ	bdseldsk+2
;
romdisk	equ	0			; romdisk is a: disk
rombdsel	equ	0b8h
rom0	equ	rombdsel+7
rom1	equ	rombdsel+6
rom2	equ	rombdsel+5
intioby	equ	0
false	equ	0
true	e ;
;				DALLAS, TX 75228			      ;
;									      ;
;			       COPYRIGHT (C) 1983			      ;
;									      ;
;*****************************************************************************;

	Title	'RAMDRVR  Ram/Rom-Disk driver for cpm 3.0'

;===h
	dcr	a
	jnz	setsize			; setup # sectors per disk
	push	h			;				..dkb-3
	call	prtsiz			; go print size			..dkb-3
	pop	h			;				..dkb-3
	mov	c,h			; msb in c			..dkb-3
	inr	c			; bump one for count		..dkb-3
	mov	b,l			; and lsb in b for loop		..dkееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееqu	not false
;
floppy	equ	0
hard	equ	1
remote	equ	2
rom	equ	3
ram	equ	4
winches	equ	5
;
	dseg
ram$init:
	return				; no init at cold start  ..dkb 1.7a
ram$login:				;   dkb 1.7a
	call	ram$find$size		; size the ramdisk	..dkb-3
	call	ram$check$==========================================================================;
; V/R   Description					       Initials-Date  ;
;-----------------------------------------------------------------------------;
; 1.0	Original Version				       dkb... 2/5/83  ;b-3

wrtlop:
	lxi	h,dumsec		; get "E5" dummy sector
	shld	dmaadr
	push	b			; save reg b (sector count)
	call	ram$wrt			; write sector
	lda	sector
	inr	a			; incr sector #
	cpi	26			; last sector ?
	cz	inctrk			; yes, bump track
	sta	sector
	popееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееbyte		; setup latch
	in	latch0
	cpi	0e5h
	jrz	ENDCK			; init done set normal entry dkb1.7a
	call	ram$check$byte		; reset latch again
	mvi	a,0e5h
	out	latch0			; set byte 
	sta	init$flag
;	ret				;			dkb 1.7a

endck:
	lxi h,ram$sel  			; address 	b			; restore count
	djnz	wrtlop			; add this here		..dkb-3
	dcr	c
	jnz	wrtlop			; do all sectors
;	djnz	wrtlop			;			..dkb-3
	lxi	h,donms			; finished
	jmp	?pmsg			; exit thru printmesage	..dkb-3

inctrk:
	lhld	track
	inx	h
	shld	track
	push	mp	d			;				wbd-2
	jnz	ckserr			;				wbd-2
	xra	a			; successful cp/m return	wbd-2
	ret				;				wbd-2
;
rom$read:
	call	sethst			; set dma,sector,track,drive
	call	diskaddr		; load address to rom disk
	mov	a,l
	out	rom1
	mov	a,h
	out	rom2
	mvi	b			; save c reg			wbd-1
	mov	a,c			; 				dkb-3
	sta	nbrds			; save # boards			dkb-3
	lxi	h,dubtbl		; get dubtbl addrs		wbd-1
	mvi	b,0			; index into table		wbd-1
	dad	b			; by twice value		wbd-1
	dad	b			; in c reg			wbd-1
	mov	a,m			; get the 2 bys		wbd-2
	srlr	c			; to adjust counter		wbd-2
	srlr	c			;				wbd-2
	srlr	c			;				wbd-2
	dad	d			; add track/sector offset	wbd-2
	mov	a,l			; to board offset		wbd-2
	out	latch1			; put address to ramdisk	wbd-2
	mov	a,h			;				wbd-2
	out	latch2			; h
	lxi	h,backup
	call	?pmsg
	pop	h
	call	?pdec			; print track nmbr..dkb-3
	xra	a
	ret
;
;
backup:	db	8,8,8,8,8,0
prtsiz:	
	lxi	h,initms		; get sig-ms
	call	?pmsg			; print i
	lhld	dsksize			; get disk size for printing
	inx	h			; adjust for b,128			; sector size
	mvi	c,rom0			; address of rom data ...  dkb
	lhld	dmaadr			; get dma address
	call	read			; go read it			wbd-3
	xra	a			; successful cp/m return	wbd-3
	ret				;				wbd-3
;
ram$write:
	call	sethst			; set dma,sector,track,drivtes		wbd-1
	inx	h
	mov	h,m
	mov	l,a
	lxi	d,ramdub		; put table data into		wbd-1
	lxi	b,dublength		; disk parameter block		wbd-1
	ldir
	xra	a
	pop	b			;				wbd-1
	ret				; return with zero set		wbd-1
ramsiz:
	call	boot0			; determine size of ramd				wbd-2
	inr	c			; allow for c=0			wbd-2
chkad4:
	dcr	c			;				wbd-2
	jrz	chkad5			;				wbd-2
	in	latch0			; read ramdisk to point to	wbd-2
	jmp	chkad4			; checksum			wbd-2
chkad5:
	ret				;				wbd-2

rom$write:
	mvi	a,2			; read only error 		blksize-1
	lda	spt+2			; get block mask
	sui	3			; check for single density
	jz	singles			; yes, do single
	dad	h			; double blocksize for 2-density
singles:
	call	?pdec			; setup decimal size
	lxi	h,sizk			; get rest of message
	call	?pmsg			; prie
ram$wrt:
	call	diskaddr		; load address to ram disk
	mov	a,l
	out	latch1
	mov	a,h
	out	latch2
	mvi	b,128			; sector size
	mvi	c,latch0		; address for data  ... dkb
	lhld	dmaadr			; get dma addr
	call	write			; go do write			wbd-2
	push	d			; cisk
	in	latch0			; save current data
	sta	savbyt
	call	boot0
	mvi	a,55h			; test byte
	out	latch0
	call	boot0
	in	latch0			; read back test byte
	cpi	55h
	rnz				;				wbd-1
	call	boot0			; restore data byte
	lda	savbyt
	out	latch0
	xra	a			; rwbd-3
	ret				;				wbd-3

	cseg				; this must be in common
read:
	di				;				wbd-4
	push	psw			; save a			wbd-4
	push	b			; save byte count		wbd-2
	push	h			; save dma addr			wbd-2
	lda	@dbnk
;	out	banksel			; set bank for transfer
	call	?bank	nt it
	ret
;********************END NEW INIT**************************

rom$init:
	ret

rom$login:
	xra	a			; set rom addr to 0
	out	rom1
	out	rom2
	in	rom0			; get char in rom
	cpi	31h			; is it a 31?			wbd-4
	rz				; yes- return OK
	jmp	errhecksum returned in de	wbd-2
	call	chkadr			; set up checksum addr in ramdisk
	pop	d			;				wbd-2
	mov	a,e			;				wbd-2
	out	latch0			; write checksum to ramdisk	wbd-2
	mov	a,d			;				wbd-2
	out	latch0			;				wbd-2
	xra	a			; no error return		wbd-2eturn with zero set		wbd-1
	ret
;
boot0:
	mvi	a,0
	out	latch1			; set ramdisk address for 192k
	mov	a,b
	out	latch2
	ret
;
dubtbl:
	dw	ram1dub
	dw	ram2dub
	dw	ram3dub
	dw	ram4dub
;
ram$read:
	call	sethst			; set dma,sector,track,drive
	ca		; set bank for transfer
	inir				; read sector
	jmp	cksum			;				wbd-2
write:
	di				;				wbd-4
	push	psw			;				wbd-4
	push	b			; save byte count		wbd-2
	push	h			; save dma addr			wbd-2
	lda	init$flag		; check init flag		wd1.7a
	ora	a
	jrnz	iexit			; not there error exit

ram$find$size:
	mvi 	c,0			; initialize dubtbl pointer
	mvi	b,30h
	call	ramsiz			; check for 1st board
	jrz	ck2			; there- try for 2
errexit:
	pop	h			; "call ram$find$size" return address
	pop	h			; "call ipchl" ret
	ret				;				wbd-2
;
chkadr:					; compute and load checksum address
	lxi	h,0			; start at block 0		wbd-2
	lda	psh			; size of sector (128*log2)	wbd-2
	ora	a			; 				wbd-2
	jrz	chkad1			;				wbd-2
	dad	h			; correct for 256 bytes/sector	wbd-2
chkall	diskaddr		; load address to ram disk
	mov	a,l
	out	latch1
	mov	a,h
	out	latch2
	mvi	b,128			; sector size
	mvi	c,latch0		; address for data  .. dkb
	lhld	dmaadr			; get dma address
	call	read			; go do read			wbd-2
	push	d			; checksum returnednit$wrt		; if so, skip bank switch	wd1.7a
	lda	@dbnk
;	out	banksel			; set bank for transfer
	call	?bank			; set bank for transfer
init$wrt:
	outir				; write a sector 
	jmp 	cksum			;				wbd-2

cksum:
	pop	h			; restore dma addr		wbd-2
	pop	b			urn address  1.7b
	pop	h			; "push h": dph pointer
	lxi	h,0			; flag invalid drive with hl=0
	ret				; return to ?sctrn caller
ck2:
	mvi	b,60h			; 2nd board there?
	call	ramsiz
	jrnz	setsiz			; no- set for 1 board
	inr	c			; increment tbl pntr
	mvd1:
	mvi	b,6			; multiply by 2^6		wbd-2
chkad2:
	dad	h			;				wbd-2
	djnz	chkad2			;				wbd-2
	xchg				; put offset in de		wbd-2
	lhld	tempdskaddr		; get track and sector offset	wbd-2
	dad	h			; x2 for 2-byte table		wbd-2
	mvi	b,4			; divide by 16  in de	wbd-2
	call	chkadr			; set up ramdisk address	wbd-2
	pop	d			; restore checksum		wbd-2
	in	latch0			; read checksum from ramdisk	wbd-2
	cmp	e			; 				wbd-2
	mov	l,a
	in	latch0			; 				wbd-2
	mov	h,a
	jnz	ckserr			; local error msg		wbd-2
	c; restore byte count		wbd-2
	mvi	d,0			; initialize checksum msb	wbd-2
	mvi	a,0			; initialize checksum lsb	wbd-2
cksum2:
	add	m			;				wbd-2
	jrnc	cksum1			;				wbd-2
	inr	d			;				wbd-2
cksum1:
	inx	h			; increment data pointer	wbd-2
	djnz	cksumi	b,0A0h			; and try for 3rd board
	call	ramsiz
	jrnz	setsiz			; no- set for 2 boards
	inr	c			; increment tbl pntr
	mvi	b,0E0h			; and try for 4th board
	call	ramsiz
	jrnz	setsiz			; no- set for 3 boards
	inr	c			; must be 4 boards
setsiz:
	push	and save modulo	wbd-2
	mvi	c,0			; in reg c			wbd-2
chkad3:					; do a 16 bit shift right	wbd-2
	srlr	h			; on reg hl and save remainder	wbd-2
	rarr	l			; in reg c			wbd-2
	rarr	c			;				wbd-2
	djnz	chkad3			;				wbd-2
	srlr	c			; shift right 4 time2			; loop nr of bytes/sector	wbd-2
	mov	e,a			; return result in de		wbd-2
	lda	@cbnk
;	out	banksel
	call	?bank			; set bank 
	pop	psw			;				wbd-4
	ei				;				wbd-4
	ret				;				wbd-2

	dseg
;
diskaddr:				; compute and load ramdisk address
	ated by gencpm
	dw	-2			; alloc vector allocated by gencpm
	dw	-2,-2,-2		; dirbcb,dtabcb,hask alloc'd by gencpm
	db	0			; hash bank
;
	cseg
ramdub:
spt:	dw	26		; spt
	db	4,15,0		; blm bls exm
dsksize:
	dw	502		; dsm
	dw	255		; drm
	dw	0F0h		; ave			; save it 
	lda	@sect			; get host sector number
	dcr	a			; make it 0 to 25
	sta	sector			; set local value
	lhld	@trk			; get host track 
	shld	track			; set local value
	ret
;
multiply:				; in: de=# of tracks, b=26 (sectors)
					; out: hl2			; storage for dma address
track:	ds	2			; storage for track
sector:	ds	1			; storage for current sector
drive:	ds	1			; currently selected drive

savbyt:	ds	1			; save area for ramsiz		wbd-1

dumsec:	rept	8
	dw	0e5e5h,0e5e5h,0e5e5h,0e5e5h,0e5e5mvi	b,26			; offset for 26 sectors per track
	lded	track			; get number of tracks		wbd-2
	call	multiply
	lda	sector			; get sector number
	add	l
	mov	l,a
	jnc	dskadr1
	inr	h
dskadr1:
	shld	tempdskaddr		; save result for checksum	wbd-2
	mvi	c,3			lloc vector for directory
	dw	64		; checksum size cks
offset:	dw	5		; offset for system tracks (off)
psh:	db	0,0		; sector size, and shift mask
dublength	equ	$-ramdub

	dseg
	
ram1dub:
	dw	26		; spt
	db	3,7,0		; blm bls exm
	dw	248		; dsm
	dw	6 contains result	wbd-2
	lxi	h,0			; zero out hl (accumulator)	wbd-2
	mov	a,e			; chk for zero tracks		wbd-2
	ora	d
	rz				; 0 tracks? return with 0 result
mult1:	dad	d			; add de to hl for b times
	djnz	mult1			;				wbd-2
	ret				; done - return to h,0e5e5h,0e5e5h,0e5e5h
	endm


	end
