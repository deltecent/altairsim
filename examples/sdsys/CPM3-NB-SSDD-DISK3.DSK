	ret
;
fd$login:
		; This entry is called when a logical drive is about to
		; be logged into for the purpose of density determination.

	sded	dph$sav			; save current dph
	lxi	d,stdsdt+1
	lxi	h,step$var
	mvi	b,4
lopstp:
	push	b
ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееublic	taddr,?drvar
	public	sctr,trk,homed,@dtype,ixsav

