#!/usr/bin/expect -f
#
# THE TARBELL #2022 BOOTS CP/M off the SAME 32-byte boot PROM as the #1011, but off a
# MIXED-DENSITY disk: the PROM and cold loader read the single-density track 0, then the
# CBIOS reads the double-density tracks 1-76 through the FD1791. If the card ever built
# the wrong FD177x part, or read a DD track as SD, this hangs mid-load -- so reaching A>
# is the whole proof. No monitor, no 'C'.
#
# It has to be an expect test for the same reason as the #1011: DIR must be typed at the
# prompt, which a pipe cannot do.
#
# THE DISK MUST NOT MOVE. Mounted write-protected; shasummed before and after.
#
# usage: expect -f tarbelldd.exp <altairsim>
#
set timeout 60
log_user 0

set exe [lindex $argv 0]
set dsk "examples/tarbell/TARBELLDD-CPM22-SSDD-48K.DSK"

set before [exec shasum $dsk]

spawn $exe tests/acceptance/tarbelldd.toml

# The PROM boots CP/M automatically off the mixed-density master.
expect {
    -ex "Tarbell" {}
    eof     { puts "FAIL: the machine died before CP/M signed on"; exit 1 }
    timeout { puts "FAIL: CP/M never booted off the Tarbell DD PROM (no sign-on)"; exit 1 }
}

# ...and it reaches the A> prompt -- proving the DD tracks read cleanly.
expect {
    -ex "A>" {}
    eof     { puts "FAIL: CP/M signed on but died before its prompt (a DD track hung?)"; exit 1 }
    timeout { puts "FAIL: CP/M signed on but never reached the A> prompt"; exit 1 }
}

# The directory is readable off the double-density tracks.
send "DIR\r"
expect {
    -ex "STAT" {}
    eof     { puts "FAIL: the machine died running DIR"; exit 1 }
    timeout { puts "FAIL: DIR did not list the disk (no STAT COM)"; exit 1 }
}

set after [exec shasum $dsk]
if {$before ne $after} {
    puts "FAIL: THE IMAGE CHANGED. `writeprotect` did not protect the master:"
    puts "  before: $before"
    puts "  after:  $after"
    exit 1
}

puts "OK: the Tarbell #2022 auto-booted CP/M 2.2 off its boot PROM across the SD track 0\
      and DD tracks 1-76 to A>, DIR read the disk, and the master is byte-identical."
exit 0
