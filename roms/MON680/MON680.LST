0001                                 NAM    PROM MONITOR
0002                         **
0003                         **ALTAIR 680B PROM MONITOR
0004                         **ACIA VERSION 1.0
0005                         **
0006 0100                    MIVEC   EQU    $100
0007 0104                    NMIVEC  EQU    $104
0008 f002                    STRAPS  EQU    $F002
0009 0000                    NOTERM  EQU    0
0010 f000                    ACIACS  EQU    $F000
0011 f001                    ACIADA  EQU    $F001
0012                         **
0013                         **MONITOR STACK AND FLAGS
0014                         **
0015 00f1                            ORG    $F1
0016 00f1                    STACK   RMB    1         BOTTOM OF MONITOR'S STACK
0017 00f2                    BRKADR  RMB    1         BREAKPOINT ADDRESS FLAG
0018 00f3                    ECHO    RMB    1         TTY ECHO FLAG
0019 00f4                    EXTFLG  RMB    1         EXTENDED CHARACTER FLAG
0020 00f5                    BUFULL  RMB    1         BUFFER FULL FLAG
0021 00f6                    SAVSTK  RMB    2         TEMP FOR STACK POINTER
0022 00f8                    TEMP    RMB    1         TEMPORARY STORAGE
0023 00f9                    BYTECT  RMB    1         BYTE COUNT
0024 00fa                    XHI     RMB    1         XREG HIGH
0025 00fb                    XLOW    RMB    1         XREG LOW
0026 00fc                    SHIFT   RMB    1         BAUDOT SHIFT FLAG
0027 00fd                    SAVEX   RMB    2         TEMP FOR INDEX RG
0028 00ff                    BUFFER  RMB    1         BAUDOT CHARACTER FLAG
0029                         **
0030                         * START OF PROM
0031                         **
0032 ff00                            ORG    $FF00
0033                         **
0034                         * INPUT ONE CHAR INTO B-REGISTER
0035                         * ECHO CHARACTER IF BIT 7 OF ECHO FLAG IS CLEAR
0036                         **
0037 ff00 8d 22              INCH    BSR    POLCAT    ACIA STATUS TO A REG
0038 ff02 24 fc                      BCC    INCH      RECEIVE NOT READY
0039 ff04 c6 7f                      LDAB   #$7F      MASK FOR PARITY REMOVAL
0040 ff06 d1 f3                      CMPB   ECHO      CHECK ECHO FLAG
0041 ff08 f4 f0 01                   ANDB   ACIADA    GET CARACTER
0042 ff0b 24 74                      BCC    OUTCH     ECHO
0043 ff0d 39                         RTS              NO ECHO
0044                         **
0045                         * THE FOLLOWING NOP LINES LINES UP THE ENTRY
0046                         * POINTS TO POLCAT IN THE TWO VERSIONS
0047                         * OF THE MONITOR
0048                         **
0049 ff0e 01                         NOP
0050                         **
0051                         * INPUT ONE HEX DIGIT INTO B REG
0052                         * RETURN TO CALLING PROGRAM IF
0053                         * CHARACTER RECEIVED IS A HEX
0054                         * DIGIT. IF NOT HEX, GO TO CRLF
0055                         **
0056 ff0f 8d ef              INHEX   BSR    INCH      GET A CHARACTER
0057 ff11 c0 30                      SUBB   #'0
0058 ff13 2b 3c                      BMI    C1        NOT HEX
0059 ff15 c1 09                      CMPB   #$9
0060 ff17 2f 0a                      BLE    IN1HG     NOT HEX
0061 ff19 c1 11                      CMPB   #$11
0062 ff1b 2b 34                      BMI    C1        NOT HEX 
0063 ff1d c1 16                      CMPB   #$16
0064 ff1f 2e 30                      BGT    C1        NOT HEX
0065 ff21 c0 07                      SUBB   #7        IT'S A LETTER-GET BCD
0066 ff23 39                 IN1HG   RTS              RETURN
0067                         **
0068                         * POLL FOR CHARACTER
0069                         * SETS CARRY IF CHARACTER IS IN BUFFER
0070                         * CLOBBERS B REG
0071                         **
0072 ff24 f6 f0 00           POLCAT  LDAB   ACIACS    ACIA STATUS TO B
0073 ff27 57                         ASRB             ROTATE RDRF BIT INTO CARRY
0074 ff28 39                         RTS              RETURN
0075                         **
0076                         * LOAD PAPER TAPE
0077                         * LOAD ONLY S1 TYPE RECORDS 
0078                         * TERMINATE ON S9 OR CHECKSUM ERROR
0079                         **
0080 ff29 8d d5              LOAD    BSR    INCH      READ CHARACTER
0081 ff2b c0 53                      SUBB   #'S
0082 ff2d 26 fa                      BNE    LOAD      FIRST CHAR NOT (S)
0083 ff2f 8d cf                      BSR    INCH      READ CHARACTER
0084 ff31 c1 39                      CMPB   #'9
0085 ff33 27 1c                      BEQ    C1        S9 END OF FILE
0086 ff35 c1 31                      CMPB   #'1
0087 ff37 26 f0                      BNE    LOAD      SECOND CHAR NOT (1)
0088 ff39 4f                         CLRA             ZERO THE CHECKSUM
0089 ff3a 8d 17                      BSR    BYTE      READ BYTE
0090 ff3c c0 02                      SUBB   #2
0091 ff3e d7 f9                      STAB   BYTECT    BYTE COUNT
0092 ff40 8d 20                      BSR    BADDR     GET ADDRESS OF BLOCK
0093 ff42 8d 0f              LOAD11  BSR    BYTE      GET DATA BYTE
0094 ff44 7a 00 f9                   DEC    BYTECT    DECREMENT BYTE COUNT
0095 ff47 27 05                      BEQ    LOAD15    DONE WITH THIS BLOCK
0096 ff49 e7 00                      STAB   0,X       STORE DATA
0097 ff4b 08                         INX              BUMP POINTER
0098 ff4c 20 f4                      BRA    LOAD11    GO BACK FOR MORE
0099 ff4e 4c                 LOAD15  INCA             INCREMENT CHECKSUM
0100 ff4f 27 d8              LLOAD   BEQ    LOAD      ALL OK - IT'S ZERO
0101 ff51 20 58              C1      BRA    CRLF      CHECKSUM ERROR - QUIT
0102                         **
0103                         * READ BYTE (2 HEX DIGITS)
0104                         * INTO B REG
0105                         * A IS USED FOR PAPER TAPE CHECKSUM
0106                         **
0107 ff53 8d ba              BYTE    BSR    INHEX     GET FIRST HEX DIG
0108 ff55 58                         ASLB             SHIFT TO HIGH ORDER 4 BITS
0109 ff56 58                         ASLB
0110 ff57 58                         ASLB
0111 ff58 58                         ASLB
0112 ff59 1b                         ABA              ADD TO CHEKSUM
0113 ff5a d7 f8                      STAB   TEMP      STORE DIGIT
0114 ff5c 8d b1                      BSR    INHEX     GET 2ND HEX DIG
0115 ff5e 1b                         ABA              ADD TO CHECKSUM
0116 ff5f db f8                      ADDB   TEMP      COMBINE DIGITS TO GET BYTE
0117 ff61 39                         RTS              RETURN
0118                         **
0119                         * READ 16 BIT ADDRESS INTO X
0120                         * STORE SAME ADDRESS IN XHI & XLO
0121                         * CLOBBERS B REG
0122                         **
0123 ff62 8d ef              BADDR   BSR    BYTE      GET HIGH ORDER ADDRESS
0124 ff64 d7 fa                      STAB   XHI       STORE IT
0125 ff66 8d eb                      BSR    BYTE      GET LOW ORDER ADDRESS
0126 ff68 d7 fb                      STAB   XLOW      STORE IT
0127 ff6a de fa                      LDX    XHI       LOAD X WITH ADDRESS BUILT
0128 ff6c 39                         RTS              RETURN
0129                         **
0130                         * PRINT BYTE IN A REG
0131                         * CLOBBERS B REG
0132                         **
0133 ff6d 16                 OUT2H   TAB              COPY BYTE TO B
0134 ff6e 54                         LSRB             SHIFT TO RIGHT
0135 ff6f 54                         LSRB
0136 ff70 54                         LSRB
0137 ff71 54                         LSRB
0138 ff72 8d 01                      BSR    OUTHR     OUTPUT FIRST DIGIT
0139 ff74 16                         TAB              BYTE INTO B AGAIN
0140 ff75 c4 0f              OUTHR   ANDB   #$F       GET RID OF LEFT DIG
0141 ff77 cb 30                      ADDB   #$30      GET ASCII
0142 ff79 c1 39                      CMPB   #$39
0143 ff7b 23 04                      BLS    OUTCH
0144 ff7d cb 07                      ADDB   #7        IF IT'S A LETTER ADD 7
0145 ff7f 01                         NOP              LINE UP OUTCH ENTRY POINTS
0146 ff80 01                         NOP
0147 ff81 8c                 OUTCH   FCB     $8C      USE CPX SKIP TRICK
0148 ff82 c6 20              OUTS    LDAB   #$20      OUTS PRINTS A SPACE
0149                         **
0150                         * OUTCH OUTPUTS CHARACTER IN B
0151                         **
0152 ff84 37                         PSHB             SAVE CHAR
0153 ff85 8d 9d              OUTC1   BSR    POLCAT    ACIA STATUS TO B REG
0154 ff87 57                         ASRB
0155 ff88 24 fb                      BCC    OUTC1     XMIT NOT READY
0156 ff8a 33                         PULB             CHAR BACK TO B REG
0157 ff8b f7 f0 01                   STAB   ACIADA    OUTPUT CHARACTER
0158 ff8e 39                         RTS
0159                         **
0160                         * EXAMINE AND DEPOSIT NEXT
0161                         * USES CONTENTS OF XHI & XLO AS POINTER
0162                         **
0163 ff8f de fa              NCHANG  LDX    XHI       INCREMENT POINTER
0164 ff91 08                         INX
0165 ff92 df fa                      STX    XHI
0166 ff94 96 fa                      LDAA   XHI
0167 ff96 8d d5                      BSR    OUT2H     PRINT OUT ADDRESS
0168 ff98 96 fb                      LDAA   XLOW
0169 ff9a 8d d1                      BSR    OUT2H
0170 ff9c 8c                         FCB    $8C       USE CPX SKIP TRICK
0171                         **
0172                         * EXAMINE & DEPOSIT
0173                         **
0174 ff9d 8d c3              CHANGE  BSR    BADDR     BUILD ADDRESS
0175 ff9f 8d e1                      BSR    OUTS      PRINT SPACE
0176 ffa1 a6 00                      LDAA   0,X       BYTE INTO A
0177 ffa3 8d c8                      BSR    OUT2H     PRINT BYTE
0178 ffa5 8d db                      BSR    OUTS      PRINT SPACE
0179 ffa7 8d aa                      BSR    BYTE      GET NEW BYTE
0180 ffa9 e7 00                      STAB   0,X       STORE NEW BYTE
0181                         **
0182                         * COMMAND DECODING SECTION
0183                         **
0184 ffab 9e f6              CRLF    LDS    SAVSTK
0185 ffad c6 0d                      LDAB   #$D       CARRIAGE RETURN
0186 ffaf 8d d0                      BSR    OUTCH
0187 ffb1 c6 0a                      LDAB   #$A       LINE FEED
0188 ffb3 8d cc                      BSR    OUTCH
0189 ffb5 c6 2e                      LDAB   #'.       PROMPT CHARACTER
0190 ffb7 8d c8                      BSR    OUTCH
0191 ffb9 bd ff 00                   JSR    INCH      READ CHARACTER
0192 ffbc 17                         TBA              MAKE A COPY
0193 ffbd 8d c3                      BSR    OUTS      PRINT SPACE
0194 ffbf 81 4c                      CMPA   #'L
0195 ffc1 27 8c                      BEQ    LLOAD     LOAD PAPER TAPE
0196 ffc3 81 4a                      CMPA   #'J
0197 ffc5 26 04                      BNE    NOTJ
0198 ffc7 8d 99                      BSR    BADDR     GET ADDRESS TO JUMP TO
0199 ffc9 6e 00                      JMP    0,X       JUMP TO IT
0200 ffcb 81 4d              NOTJ    CMPA   #'M
0201 ffcd 27 ce                      BEQ    CHANGE    EXAMINE & DEPOSIT
0202 ffcf 81 4e                      CMPA   #'N
0203 ffd1 27 bc                      BEQ    NCHANG    E & D NEXT
0204 ffd3 81 50                      CMPA   #'P
0205 ffd5 26 d4                      BNE    CRLF
0206 ffd7 3b                         RTI              PROCEED FROM BREAKPOINT
0207                         **
0208                         * RESET ENTRY POINT
0209                         **
0210 ffd8 8e 00 f3           RESET   LDS    #ECHO     INITIALIZE STACK POINTER
0211 ffdb c6 03                      LDAB   #3        INIT ECHO AND BRKADR FLAGS
0212 ffdd 37                         PSHB
0213 ffde 37                         PSHB
0214 ffdf f7 f0 00                   STAB   ACIACS    MASTER RESET ACIA
0215 ffe2 f6 f0 02                   LDAB   STRAPS    LOOK AT STRAPS
0216 ffe5 2b 19                      BMI    NOTERM    NO TERM - JUMP TO 0
0217 ffe7 c4 04                      ANDB   #4        GET # OF STOP BITS
0218 ffe9 ca d1                      ORAB   #$D1
0219 ffeb f7 f0 00                   STAB   ACIACS    INIT ACIA PORT
0220                         **
0221                         * SOFTWARE INTERRUPT ENTRY POINT
0222                         **
0223 ffee 9f f6              INTRPT  STS    SAVSTK    SAVE STACK POINTER
0224 fff0 9f fa                      STS    XHI       SAVE SP FOR N COMMAND
0225 fff2 d6 f2                      LDAB   BRKADR    IF BIT 7 OF BRKADR IS SET
0226 fff4 2b 0a                      BMI    NOTERM    JUMP TO 0
0227 fff6 20 b3                      BRA    CRLF      GOTO COMMAND DECODER
0228                         **
0229                         * NOW COME THE INTERRUPT VECTORS
0230                         **
0231 fff8                            ORG    $FFF8
0232 fff8 01 00                      FDB    MIVEC     MI VECTOR
0233 fffa ff ee                      FDB    INTRPT    SWI VECTOR
0234 fffc 01 04                      FDB    NMIVEC    NMI VECTOR
0235 fffe ff d8                      FDB    RESET     RESET VECTOR
0236                                 END    
0237                         


