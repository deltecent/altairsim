                 0002         NAME    DDB200
                 0003 ;
                 0004 ;       FLOPPY DISK DRIVER FOR SDOS-COSMOS
                 0005 ;
                 0006 ;               BY      REX BROWN
                 0007 ;
                 0008 ;       VERSION 3.1     5/10/80
                 0009 ;                       8/13/80 SPLIT DDBIOS FOR SD100/200
                 0010 ;               3.2     8/13/81 TRK 0 DTYPE ON BOOT FOR OASIS...DKB
                 0011 ;               3.3     6/24/82 SET UNIT BYTE TO ZERO FOR BOOT UP..DKB
                 0012 ;
                 0013 ;       RUNS ON SD200/700 SYSTEMS
                 0014 ;
                 0015 ;
                 0016 ;       COPYRIGHT 1980 SD SYSTEMS 
                 0017 ;
                 0018 ;
                 0019 ;       VERSION 3.0 OF DDBIOS IS CAPABLE OF SUPPORTING BOTH
                 0020 ;       DOUBLE DENSITY AND SINGLE DENSITY FORMATS ON EITHER
                 0021 ;       THE 8" OR THE 5" DRIVES. DDBIOS V3.0 WILL SUPPORT USE
                 0022 ;       OF EITHER THE 1795 OR THE 1791 CONTROLLER CHIPS.
                 0023 ;
                 0024 ;       VERSION 3.1 ALLOWS COLD BOOT FROM HARD DISK WITHOUT 
                 0025 ;       FLOPPY DISKS IN SYSTEM
                 0026 ;
                 0027 ;       *****************************************
                 0028 ;       *                                       *
                 0029 ;       *                                       *
                 0030 ;       *       The BOOT routine dumps track 0  *
                 0031 ;       *       SECTOR 1 data to address 0080H. *
                 0032 ;       *                                       *
                 0033 ;       *****************************************
                 0034 ;
                 0035         PSECT   ABS
 >F000           0036         ORG      0F000H
                 0037 ;
                 0038 ;
                 0039 ;
                 0040 ;
 >0031           0041 COBYTE  EQU     031H    ;CAP-CPP CHK DATA
 >E800           0042 COBSYS  EQU     0E800H  ;CAP-CPP SYS ADDR
 >00E0           0043 MNBYTE  EQU     0E0H    ;MONITOR CHECK DATA
 >E002           0044 MNITR   EQU     0E002H  ;MONITOR CHECK ADDR
 >E003           0045 MONITR  EQU     0E003H  ;MONITOR ENTRY POINT
 >E800           0046 HDBIOS  EQU     0E800H  ;HARD DISC LINKAGE
 >0080           0047 NBYTES  EQU     128     ;BYTES PER SECTOR
                 0048 ;
                 0049 ;
 >0000           0050 RBASE   EQU     0000H           ; START OF RAM
 >0040           0051 TADDR   EQU     RBASE+40H       ; TRANSFER ADDRESS
 >0042           0052 UNIT    EQU     RBASE+42H       ; NEW UNIT BYTE
 >0043           0053 SCTR    EQU     RBASE+43H       ; SECTOR
 >0044           0054 TRK     EQU     RBASE+44H       ; TRACK
 >0045           0055 NREC    EQU     RBASE+45H       ; # OF SECTORS
 >0046           0056 ERMASK  EQU     RBASE+46H       ; ERROR MASK
 >0047           0057 ERSTAT  EQU     RBASE+47H       ; ERROR STATUS
 >0048           0058 IDSV    EQU     RBASE+48H       ; 4 BYTES
 >0049           0059 SIDE    EQU     RBASE+49H       ; ID SIDE BYTE





