                 0244 ;
                 0245 ;       BOOT LOADS A SECTOR FROM DISK TO ADDR 0080H AFTER
                 0246 ;       CHECKING THE DISK TYPE.  IF THE SECTOR
                 0247 ;       IS VALID DATA CONTROL IS TRANSFERED TO
                 0248 ;       THE LOAD ADDRESS.
                 0249 ;
                 0250 ;
 F06C  318000    0251 BOOT    LD      SP,SSTACK       ;SET UP STACK POINTER
 F06F  DB7F      0252         IN      A,(7FH)
 F071  3E00      0253         LD      A,0
 F073  324200    0254         LD      (UNIT),A        ; SET UNIT BYTE TO 0 ;3.3 DKB
 F076  7B        0255         LD      A,E             ;*
 F077  FE04      0256         CP      4
 F079  D203E8    0257         JP      NC,HDBIOS+3
 F07C  F5        0258         PUSH    AF      ;*
 F07D  3EEF      0259         LD      A,0EFH          ;STEP DRIVES AWAY FROM TRK 0
 F07F  E5        0260         PUSH    HL
 F080  ED734D00  0261         LD      (SPSV),SP
 F084  E1        0262         POP     HL
 F085  0F        0263 BT1:    RRCA                    ; SET UP DRIVE SELECT
 F086  301A      0264         JR      NC,BT2
 F088  D363      0265         OUT     (SELECT),A
 F08A  CDB7F3    0266         CALL    FRCINT
 F08D  E604      0267         AND     4
 F08F  280D      0268         JR      Z,BT3
 F091  AF        0269         XOR     A
 F092  D365      0270         OUT     (TRACK),A               ;TELL CNTRLLR ITS AT 0
 F094  3E02      0271         LD      A,2
 F096  324400    0272         LD      (TRK),A
 F099  3E1A      0273         LD      A,1AH
 F09B  CD0AF3    0274         CALL    SEEK4
 F09E  DB63      0275 BT3:    IN      A,(SELECT)
 F0A0  18E3      0276         JR      BT1
 F0A2  F1        0277 BT2:    POP     AF      ;*
 F0A3  F5        0278         PUSH    AF              ; 3.2
 F0A4  CD6AF1    0279         CALL    HOME            ; 3.2 OASIS MOD
 F0A7  F1        0280         POP     AF              ; 3.2
 F0A8  CD1BF1    0281         CALL    UNITSL          ;CHECK DISKETTE TYPE
 F0AB  2019      0282         JR      NZ,GOMON
 F0AD  CDD0F0    0283 BT4:    CALL    BOOTLD          ;LOAD IN BOOT LOADER
 F0B0  218000    0284         LD      HL,COLD
 F0B3  7E        0285         LD      A,(HL)          ;LOOK FOR
 F0B4  E6CE      0286         AND     0CEH            ;CPM OR SDOS
 F0B6  2005      0287         JR      NZ,BT5          ;LOADER
 F0B8  CB46      0288         BIT     0,(HL)  
 F0BA  C28000    0289         JP      NZ,COLD         
 F0BD  3E31      0290 BT5:    LD      A,COBYTE        ;CHK FOR CAP SFTWRE
 F0BF  2100E8    0291         LD      HL,COBSYS
 F0C2  BE        0292         CP      (HL)
 F0C3  CA00E8    0293         JP      Z,COBSYS
 F0C6  3EE0      0294 GOMON:  LD      A,MNBYTE        ;IF LOADR DIDN'T MAKE IT
 F0C8  2102E0    0295         LD      HL,MNITR        ;CHK 1ST BYTE OF MONITOR
 F0CB  BE        0296         CP      (HL)            ;IF IT'S THERE JUMP TO IT
 F0CC  CA03E0    0297         JP      Z,MONITR
 F0CF  76        0298 HLT:    HALT 
 F0D0  218000    0299 BOOTLD  LD      HL,COLD         ;COLD=BOOT LOAD ADDR
 F0D3  224000    0300 BOOT1   LD      (TADDR),HL





DDB200 SDOS-COSMOS FLOPPY CONTROLLER   SD SYSTEMS Z80 ASSEMBLER PAGE 0008 
 ADDR  CODE      STMT SOURCE STATEMENT

 F0D6  AF        0301 BOOT2   XOR     A
 F0D7  324400    0302         LD      (TRK),A         ;SET TO TRACK 0
 F0DA  3C        0303         INC     A
 F0DB  324300    0304         LD      (SCTR),A        ;SET TO SECTOR 1
 F0DE  CD8DF1    0305         CALL    READ            ;READ BOOT SECTOR
 F0E1  C8        0306         RET     Z               ;RETURN IF NO ERROR
 F0E2  18E2      0307         JR      GOMON
 F0E4  3A4200    0308 CHGTYP: LD      A,(UNIT)        ;GET UNIT TYPE REGISTER
 F0E7  5F        0309         LD      E,A             ;STORE UNIT TYPE IN E
 F0E8  3E04      0310         LD      A,4             ;IF ERROR CHECK DRIVE TYPE
 F0EA  B8        0311         CP      B
 F0EB  2819      0312         JR      Z,DD8256        ;TRY DOUBLE DENSITY 8" 256 BYTE
 F0ED  3D        0313         DEC     A               ;IF NOT DD-8
 F0EE  B8        0314         CP      B               ;TRY SINGL DENSE 8"
 F0EF  280C      0315         JR      Z,SD8
 F0F1  3D        0316         DEC     A               ;IF NOT SD8
 F0F2  B8        0317         CP      B               ;TRY SINGLE DENSITY 5"
 F0F3  2818      0318         JR      Z,SD5-$
 F0F5  3D        0319         DEC     A               ;IT'S NOT SD-5
 F0F6  B8        0320         CP      B               ;TRY DOUBLE DENSITY 5"
 F0F7  281B      0321         JR      Z,DD5-$
 F0F9  F601      0322         OR      1               ;MUST NOT BE ANY THING OUT
                 0323                                 ;THERE SET ERROR FLAG
 F0FB  E1        0324         POP     HL              ;ADJUST RET ADDR
 F0FC  C9        0325         RET                     ;AND RETURN







































