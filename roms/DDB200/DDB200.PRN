 F5B4  F680      1294         OR      80H             ;GET RID OF MSB(NEG LOG)
 F5B6  CB7D      1295         BIT     7,L             ;CHK SIDE BIT
 F5B8  2810      1296         JR      Z,INCTRK-$      ;SKP SIDE CHG IF 1 SIDED
 F5BA  CB44      1297         BIT     0,H             ;CHECK SIDE
 F5BC  CB84      1298         RES     0,H
 F5BE  200A      1299         JR      NZ,INCTRK-$     ;IF PREV SIDE = 2 INC TRK
