                                ;*
                                ;* ZERO OR FILL MEMORY WITH A CONSTANT
  E27D    CD E4D3               ZEROM:	CALL	PTSTNG
  E280    46 49 4C 4C           	DC	'FILL '
  E284    A0                    
  E285    CD E10E               	CALL	TAHEX			;READ ADDRESSES
  E288    E5                    	PUSH	H			;SAVE H
  E289    CD E10A               	CALL	AHE2			;READ 2 DIGITS
  E28C    EB                    	XCHG
  E28D    E3                    	XTHL				;RESTORE H,L
  E28E    C1                    	POP	B
  E28F    71                    ZLOOP:	MOV	M,C			;WRITE INTO MEM
