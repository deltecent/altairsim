  E32E    CD E10E               SRCHENT:	CALL	TAHEX
  E331    E5                    	PUSH	H			;SAVE H
  E332    CD E10A               	CALL	AHE2			;READ 2 DIGITS
  E335    EB                    	XCHG				;H=CODE,D=F
  E336    45                    	MOV	B,L			;PUT CODE IN B
  E337    E1                    	POP	H			;RESTORE H
  E338    F1                    	POP	PSW
  E339    FE 53                 	CPI	'S'
  E33B    F5                    	PUSH	PSW
                                	JRZ	CONT
  E33C    28              +     	DB	28H
  E33D    07              +     	DB	CONT-$-1
  E33E    E5                    	PUSH	H
  E33F    CD E10A               	CALL	AHE2			;READ 2 DIGITS
