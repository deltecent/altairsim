  E230    1F                    	RAR
  E231    E6 0F                 BINL:	ANI	0FH			;LOW 4 BITS
  E233    C6 30                 	ADI	48			;ASCII BIAS
  E235    FE 3A                 	CPI	58			;DIGIT 0-9
  E237    DA E0DC               	JC	PTCN
