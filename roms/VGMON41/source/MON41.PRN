  E290    CD E23F               	CALL	BMP			;COMP ADD, INCR H
  E293    C8                    	RZ				;RETURN IF DONE
                                	JR	ZLOOP			;CONTINUE TIL DONE
  E294    18              +     	DB	18H
  E295    F9              +     	DB	ZLOOP-$-1
                                ;* EXCHANGE OR MOVE A BLOCK OF MEMORY
