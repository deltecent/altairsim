  E43F    F6 07                 	ORI	7
                                	JR	EOL+3
  E441    18              +     	DB	18H
  E442    A9              +     	DB	EOL+3-$-1
                                ;* CLEAR THE SCREEN AND HOME UP
  E443    CD E49C               FORM:	CALL	CLEAR
  E446    AF                    HOME:	XRA	A
  E447    32 FFDC               	STA	LINENO
  E44A    32 FFDD               	STA	VFL			;CLR VID FLAG
                                ;* CARRIAGE RETURN
  E44D    AF                    CRET:	XRA	A
  E44E    32 FFDB               TABRET:	STA	CURPOS
                                ;* RETURN TO THE CALLING ROUTINE
  E451    CD E46F               VRET:	CALL	LIFTCURS
  E454    E1                    	POP	H
  E455    D1                    	POP	D
  E456    C1                    	POP	B
  E457    F1                    	POP	PSW
  E458    C9                    	RET
  E459    3A FFDD               TVIDF:	LDA	VFL
  E45C    EE 80                 	XRI	80H
  E45E    32 FFDD               	STA	VFL
                                	JR	VRET
  E461    18              +     	DB	18H
  E462    EE              +     	DB	VRET-$-1
                                ;*
                                ;* MOVE THE CURSOR UP
  E463    3A FFDC               CURSUP:	LDA	LINENO
  E466    A7                    	ANA	A
                                	JRZ	VRET
  E467    28              +     	DB	28H
  E468    E8              +     	DB	VRET-$-1
  E469    3D                    	DCR	A
  E46A    32 FFDC               STORLN:	STA	LINENO
