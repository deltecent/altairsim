  E2E8    7E                    	MOV	A,M
  E2E9    B8                    	CMP	B
  E2EA    C2 E21D               ERRJP:	JNZ	ERR
  E2ED    71                    	MOV	M,C
  E2EE    23                    	INX	H
                                	JR	NDLOP
  E2EF    18              +     	DB	18H
  E2F0    EB              +     	DB	NDLOP-$-1
                                ;* COMPARE TWO BLOCKS OF MEMORY
  E2F1    CD E4D3               COMPR:	CALL	PTSTNG
  E2F4    43 4F 4D 50           	DC	'COMPARE '
  E2F8    41 52 45 A0           
  E2FC    CD E10E               	CALL	TAHEX
  E2FF    E5                    	PUSH	H
  E300    CD E0BD               	CALL	AHEX
  E303    EB                    	XCHG
  E304    7E                    VMLOP:	MOV	A,M
