  E40B    20              +     	DB	20H
  E40C    F7              +     	DB	SCRL-$-1
  E40D    7D                    	MOV	A,L
  E40E    FE 80                 	CPI	LOW (HORIZ*VERT+VPAGE)
                                	JRNZ	SCRL
  E410    20              +     	DB	20H
  E411    F2              +     	DB	SCRL-$-1
  E412    3A FFDC               	LDA	LINENO
                                ;* ERASE BOTTOM LINE
  E415    EB                    EBOTL:	XCHG
  E416    06 50                 	MVI	B,HORIZ
  E418    36 20                 ELOP:	MVI	M,SPACE
  E41A    23                    	INX	H
  E41B    05                    	DCR	B
                                	JRNZ	ELOP
  E41C    20              +     	DB	20H
  E41D    FA              +     	DB	ELOP-$-1
  E41E    3D                    	DCR	A
  E41F    3C                    NOSCRL:	INR	A
  E420    32 FFDC               	STA	LINENO
                                	JR	VRET
  E423    18              +     	DB	18H
  E424    2C              +     	DB	VRET-$-1
                                ;*
                                ;* ERASE BEFORE BACKSPACING
  E425    36 20                 DBACKSP:	MVI	M,20H
  E427    3A FFDB               	LDA	CURPOS
  E42A    A7                    	ANA	A
                                	JRZ	VRET
  E42B    28              +     	DB	28H
  E42C    24              +     	DB	VRET-$-1
  E42D    3D                    	DCR	A
  E42E    2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  E42F    36 20                 	MVI	M,20H
                                	JR	TABRET
  E431    18              +     	DB	18H
  E432    1B              +     	DB	TABRET-$-1
                                ;* MOVE THE CURSOR BACK
  E433    3A FFDB               BACKSP:	LDA	CURPOS
  E436    3D                    	DCR	A
  E437    F2 E44E               	JP	TABRET
                                	JR	CRET
  E43A    18              +     	DB	18H
