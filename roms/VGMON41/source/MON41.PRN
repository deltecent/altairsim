	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ;  VECTOR MZ MONITOR 4.1, converted from the printed listing to M80 source.
                                ;
                                ;  Assemble and link with M80 and L80:
                                ;
                                ;	M80 MON41,MON41=MON41.ASM
                                ;	L80 /P:E000,MON41,MON41/N/X/E
                                ;
                                ;  L80 asks "Origin above loader memory" twice. Answer Y, which writes
                                ;  MON41.HEX, then N, which returns to CP/M.
                                ;
                                ;  Changes from the listing, made because M80 needs them. The object
                                ;  code is the same:
                                ;	RET, PAGE, HEXRULER	renamed VRET, VPAGE, HEXRLR
                                ;	DTH, DT			written as DC, DB
                                ;	PUSH IX, PUSH IY	written as DB
                                ;	*			comment lines start with ;*
                                ;	LINK			kept as a comment
                                ;	ORG BASE		written as .PHASE BASE, L80 /P sets the origin
                                ;	ORG MSEND		kept as a comment
                                ;	ORG and DS above ROM	written as EQU, so nothing lands in RAM
                                ;	ORG KTABL+30		written as DS with a zero fill
                                ;	E7FB-E7FF		not in the listing, filled with zero
                                ;	strict left-to-right expressions rewritten with HIGH, LOW, ()
                                ;
                                	.8080
                                ;
                                ;  The listing's Z-80 instructions, as macros
                                ;
                                JR	MACRO	ADDR
                                	DB	18H
                                	DB	ADDR-$-1
                                	ENDM
                                JRNZ	MACRO	ADDR
                                	DB	20H
                                	DB	ADDR-$-1
                                	ENDM
                                JRZ	MACRO	ADDR
                                	DB	28H
                                	DB	ADDR-$-1
                                	ENDM
                                JRNC	MACRO	ADDR
                                	DB	30H
                                	DB	ADDR-$-1
                                	ENDM
                                JRC	MACRO	ADDR
                                	DB	38H
                                	DB	ADDR-$-1
                                	ENDM
                                LDED	MACRO	ADDR
                                	DB	0EDH,5BH
                                	DW	ADDR
                                	ENDM
                                SDED	MACRO	ADDR
                                	DB	0EDH,53H
                                	DW	ADDR
                                	ENDM
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                                SBCD	MACRO	ADDR
                                	DB	0EDH,43H
                                	DW	ADDR
                                	ENDM
                                LDI	MACRO
                                	DB	0EDH,0A0H
                                	ENDM
                                LDIR	MACRO
                                	DB	0EDH,0B0H
                                	ENDM
                                CCI	MACRO
                                	DB	0EDH,0A1H
                                	ENDM
                                OUTIR	MACRO
                                	DB	0EDH,0B3H
                                	ENDM
                                EXAF	MACRO
                                	DB	08H
                                	ENDM
                                EXX	MACRO
                                	DB	0D9H
                                	ENDM
                                INP	MACRO	R
                                	DB	0EDH,40H+(R*8)
                                	ENDM
                                OUTP	MACRO	R
                                	DB	0EDH,41H+(R*8)
                                	ENDM
                                DD	MACRO	V
                                	DB	HIGH (V)
                                	DB	LOW (V)
                                	ENDM
                                ;
  E000                          BASE	EQU	0E000H			;ASSEMBLY ADDRESS
  E000                          PR	EQU	0E000H			;PROM/RAM ADDRESS
                                ;	LINK	'M6'
                                ;*******************************************************
                                ;*                                                     *
                                ;*           VECTOR MZ MONITOR - VERSION 4.1           *
                                ;*       R. S. HARP  7/16/79  MODIFIED 6/1/80          *
                                ;*                                                     *
                                ;*******************************************************
                                ;*
                                ;* SYSTEM EQUATES
  0000                          CONS	EQU	0			;CONS STATUS PRT
  0001                          COND	EQU	1			;CONS DATA PORT
  0040                          RDA	EQU	40H			;RECEIVE FLAG
  0000                          STPOL	EQU	0			;STATUS POLARITY
  FFD0                          SPTR	EQU	PR+01FD0H		;STACK POINTER
  E800                          DSBOOT	EQU	0E800H			;DUALSTOR BOOTSTRAP
  E802                          MSBOOT	EQU	0E802H			;MEGASTOR BOOTSTRAP
                                ;*
                                ;****************** COMMAND FORMAT *******************
                                ;*   A SSSS FFFF ASCII DUMP OF MEMORY                  *
                                ;*   B JUMP TO BOOTSTRAP LOADER                        *
                                ;*   C SSSS FFFF CCCC COMPARE BLOCKS                   *
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                                ;*   D SSSS FFFF DUMP MEMORY IN HEX & ASCII            *
                                ;*   E EXTERNAL COMMUNICATIONS                         *
                                ;*   F SSSS FFFF DD DD TWO BYTE SEARCH                 *
                                ;*   G SSSS GO TO AND EXECUTE                          *
                                ;*   H JUMP TO HIGH RAM AT FC00                        *
                                ;*   I PP INPUT FROM PORT                              *
                                ;*   J JUMP TO DOS                                     *
                                ;*   K LLLL SET A BREAKPOINT                           *
                                ;*   L JUMP TO LOW RAM AT 0                            *
                                ;*   M SSSS FFFF DDDD MOVE BLOCK                       *
                                ;*   N NON DESTRUCTIVE MEMORY TEST                     *
                                ;*   O PP DD OUTPUT TO PORT                            *
                                ;*   P LLLL PROGRAM MEMORY                             *
                                ;*   Q SSSS FFFF COMPUTE CHECKSUM                      *
                                ;*   R DUMP Z-80 REGISTERS                             *
                                ;*   S SSSS FFFF DD SEARCH FOR SINGLE BYTE             *
                                ;*   T SSSS FFFF TEST MEMORY                           *
                                ;*   U JUMP TO USER AREA AT 2B00                      *
                                ;*   V BOOT FROM 8 INCH DISK                           *
                                ;*   W BOOT WINCHESTER DISK                            *
                                ;*   X SSSS FFFF DDDD EXCHANGE BLOCK                   *
                                ;*   Y KEYBOARD ECHO                                   *
                                ;*   Z SSSS FFFF DD ZERO OR FILL MEMORY                *
                                ;*******************************************************
                                ;*
                                	.PHASE	BASE
                                ;* JUMP TABLE OF ENTRY POINTS
  E000    C3 E018               MONIT:	JMP	INIT			;INITIALIZE ALL
  E003    C3 E13C               KEYTST:	JMP	KEYSTAT			;TEST KEYBOARD
  E006    C3 E141               KEYDATA:	JMP	CONVERT			;INPUT KEYBOARD
  E009    C3 E38A               CRT:	JMP	VIDEO			;OUTPUT TO SCREEN
  E00C    C3 E12F               ESC:	JMP	ESCAPE			;KEYBOARD INPUT
  E00F    00                    	NOP
  E010    00                    	NOP
  E011    00                    	NOP
                                ;*
                                ;* TABLE OF COMMANDS FOR USART
  E012    00 00 00 40           INITABLE:	DB	0,0,0,40H,0CEH,27H
  E016    CE 27                 
                                ;*
  E018    31 FFD0               INIT:	LXI	SP,SPTR			;INIT STACK
  E01B    CD E12F               	CALL	ESCAPE			;DUMP LATCH
  E01E    AF                    	XRA	A
  E01F    32 FFEA               	STA	XYFLAG
                                ;* INITIALIZE USARTS AT PORTS 3,5,7
  E022    0E 03                 	MVI	C,3			;STARTING PORT
  E024    06 06                 INILOOP:	MVI	B,6			;NO OF COMMANDS
  E026    21 E012               	LXI	H,INITABLE
                                	OUTIR				;BLOCK OUTPUT
  E029    ED B3           +     	DB	0EDH,0B3H
  E02B    0C                    	INR	C
  E02C    0C                    	INR	C
  E02D    79                    	MOV	A,C
  E02E    FE 09                 	CPI	9			;DO 3 PORTS
                                	JRNZ	INILOOP
  E030    20              +     	DB	20H
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


  E031    F2              +     	DB	INILOOP-$-1
                                ;* PATCH RST 7
  E032    3E C3                 	MVI	A,0C3H			;JUMP
  E034    32 0038               	STA	38H			;RST 7
  E037    21 E6D7               	LXI	H,DUMPREGS
  E03A    22 0039               	SHLD	39H
                                ;* DISPLAY SIGN ON
  E03D    CD E4DE               	CALL	SIGN
                                ;* CLEAR BREAKPOINT
  E040    2A FFE7               CLRBRK:	LHLD	BKPTLOC
  E043    11 FFE9               	LXI	D,BRKCODE
                                	SDED	BKPTLOC
  E046    ED 53           +     	DB	0EDH,53H
  E048    FFE7            +     	DW	BKPTLOC
  E04A    1A                    	LDAX	D
  E04B    77                    	MOV	M,A
  E04C    31 FFD0               START:	LXI	SP,SPTR			;INITIALIZE STACK
  E04F    21 F000               	LXI	H,VPAGE			;FULL SCREEN SCROLL
  E052    22 FFDF               	SHLD	TOSCN
  E055    CD E53A               	CALL	PROMPT
  E058    CD E12F               KEYPOL:	CALL	ESCAPE			;READ KEYBOARD
                                	JRZ	KEYPOL
  E05B    28              +     	DB	28H
  E05C    FB              +     	DB	KEYPOL-$-1
  E05D    E6 5F                 	ANI	5FH			;UPPER AND LOWER
  E05F    21 E04C               	LXI	H,START
  E062    E5                    	PUSH	H
  E063    FE 04                 	CPI	'D'-64
  E065    CC E38A               	CZ	VIDEO			;ECHO CLEARSCN
  E068    FE 41                 	CPI	'A'
  E06A    D8                    	RC				;TOO SMALL
  E06B    FE 5B                 	CPI	05BH
  E06D    D0                    	RNC				;TOO LARGE
  E06E    21 E0F9               	LXI	H,CMDTB+7EH
  E071    F5                    	PUSH	PSW
  E072    87                    	ADD	A
  E073    85                    	ADD	L
  E074    6F                    	MOV	L,A
  E075    5E                    	MOV	E,M
  E076    23                    	INX	H
  E077    56                    	MOV	D,M
  E078    EB                    	XCHG
  E079    F1                    	POP	PSW
  E07A    E9                    	PCHL				;AWAY WE GO
                                ;* COMMAND TABLE
  E07B    E543                  CMDTB:	DW	WASCII			;A
  E07D    E247                  	DW	BOOT			;B
  E07F    E2F1                  	DW	COMPR			;C
  E081    E5C7                  	DW	HEXRUL			;D
  E083    E7DC                  	DW	EXTCOM			;E
  E085    E314                  	DW	FIND			;F
  E087    E0AF                  	DW	EXEC			;G
  E089    E265                  	DW	RAM			;H
  E08B    E362                  	DW	PINPT			;I
  E08D    E196                  	DW	WARM			;J
  E08F    E7C1                  	DW	SETBRK			;K
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  E091    E271                  	DW	LORAM			;L
  E093    E2A5                  	DW	MOVEB			;M
  E095    E2CD                  	DW	NDMT			;N
  E097    E374                  	DW	POUTP			;O
  E099    E614                  	DW	PROGRAM			;P
  E09B    E179                  	DW	CHKSM			;Q
  E09D    E6CB                  	DW	DREGS			;R
  E09F    E321                  	DW	SRCH			;S
  E0A1    E1C3                  	DW	TMEM			;T
  E0A3    E256                  	DW	USER			;U
  E0A5    E800                  	DW	DSBOOT			;V
  E0A7    E802                  	DW	MSBOOT			;W
  E0A9    E296                  	DW	EXCHG			;X
  E0AB    E1AE                  	DW	ECHO			;Y
  E0AD    E27D                  	DW	ZEROM			;Z
                                ;*
                                ;*** EXECUTE THE PROGRAM AT THE ADDRESS ***
                                ;*
  E0AF    CD E4D3               EXEC:	CALL	PTSTNG
  E0B2    47 4F 20 54           	DC	'GO TO '
  E0B6    4F A0                 
  E0B8    CD E0BD               	CALL	AHEX			;READ ADD FROM KB
  E0BB    EB                    	XCHG
  E0BC    E9                    	PCHL				;JUMP TO IT
                                ;*
                                ;*** CONVERT UP TO 4 HEX DIGITS TO BIN
                                ;*
  E0BD    0E 04                 AHEX:	MVI	C,4			;COUNT OF 4 DIGITS
  E0BF    21 0000               AHE0:	LXI	H,0			;16 BIT ZERO
  E0C2    CD E12F               AHE1:	CALL	ESCAPE
  E0C5    FE 20                 	CPI	' '			;SPACE?
  E0C7    CA E0E8               	JZ	SPCOVR
  E0CA    CD E0ED               	CALL	HEX			;CHECK VALUE
                                	JRC	AHE1
  E0CD    38              +     	DB	38H
  E0CE    F3              +     	DB	AHE1-$-1
  E0CF    29                    	DAD	H			;MULT H*16
  E0D0    29                    	DAD	H
  E0D1    29                    	DAD	H
  E0D2    29                    	DAD	H
  E0D3    85                    	ADD	L
  E0D4    6F                    	MOV	L,A
  E0D5    0D                    	DCR	C			;4 DIGITS?
  E0D6    C2 E0C2               	JNZ	AHE1			;KEEP READING
  E0D9    EB                    	XCHG
  E0DA    3E 20                 SPCE:	MVI	A,20H			;PRINT SPACE
  E0DC    C3 E38A               PTCN:	JMP	VIDEO
  E0DF    3E 0D                 CRLF:	MVI	A,0DH			;PRINT CR
  E0E1    CD E0DC               	CALL	PTCN
  E0E4    3E 0A                 	MVI	A,0AH
                                	JR	PTCN
  E0E6    18              +     	DB	18H
  E0E7    F4              +     	DB	PTCN-$-1
                                ;*
  E0E8    CD E38A               SPCOVR:	CALL	VIDEO
                                	JR	SPCE-1
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  E0EB    18              +     	DB	18H
  E0EC    EC              +     	DB	SPCE-1-$-1
                                ;*
                                ;* CHECK FOR HEX VALUE, CONVERT
  E0ED    FE 30                 HEX:	CPI	30H			;<0
  E0EF    D8                    	RC
  E0F0    FE 3A                 	CPI	':'			;>9
                                	JRC	NUM
  E0F2    38              +     	DB	38H
  E0F3    09              +     	DB	NUM-$-1
  E0F4    E6 5F                 	ANI	5FH			;UPPER & LOWER CASE
  E0F6    FE 41                 	CPI	'A'			;<A
  E0F8    D8                    	RC
  E0F9    FE 47                 	CPI	'G'			;>F
  E0FB    3F                    	CMC
  E0FC    D8                    	RC
  E0FD    CD E38A               NUM:	CALL	VIDEO
  E100    D6 30                 	SUI	48			;ASCII BIAS
  E102    FE 0A                 	CPI	10			;DIGIT 0-10
                                	JRC	ALFA
  E104    38              +     	DB	38H
  E105    02              +     	DB	ALFA-$-1
  E106    D6 07                 	SUI	7			;ALPHA BIAS
  E108    A7                    ALFA:	ANA	A			;CLEAR CY
  E109    C9                    	RET				;WITH CY CLEAR
                                ;*
                                ;* READ 2 DIGITS FROM THE CONSOLE
  E10A    0E 02                 AHE2:	MVI	C,2
                                	JR	AHE0
  E10C    18              +     	DB	18H
  E10D    B1              +     	DB	AHE0-$-1
                                ;*
                                ;* SHORT ROUTINE TO SAVE CODE
  E10E    CD E0BD               TAHEX:	CALL	AHEX
                                	JR	AHEX
  E111    18              +     	DB	18H
  E112    AA              +     	DB	AHEX-$-1
                                ;*
                                ;*** READ FROM CONSOLE TO REG A ***
                                ;*
  E113    CD E12F               RDCN:	CALL	ESCAPE			;READ KEYBOARD
                                	JRZ	RDCN
  E116    28              +     	DB	28H
  E117    FB              +     	DB	RDCN-$-1
  E118    FE 60                 	CPI	60H
                                	JRC	PTCN
  E11A    38              +     	DB	38H
  E11B    C0              +     	DB	PTCN-$-1
  E11C    E6 5F                 	ANI	5FH
                                	JR	PTCN
  E11E    18              +     	DB	18H
  E11F    BC              +     	DB	PTCN-$-1
                                ;*
  E120    CD E12F               PAUSE:	CALL	ESCAPE
  E123    FE 20                 	CPI	20H
  E125    C0                    	RNZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  E126    CD E12F               PLOOP:	CALL	ESCAPE
  E129    FE 20                 	CPI	20H
  E12B    C2 E126               	JNZ	PLOOP
  E12E    C9                    	RET
                                ;*
  E12F    CD E13C               ESCAPE:	CALL	KEYSTAT
  E132    C8                    	RZ
  E133    CD E141               	CALL	CONVERT
  E136    FE 1B                 	CPI	1BH			;ESCAPE
  E138    CA E04C               	JZ	START
  E13B    C9                    	RET
                                ;*
  E13C    DB 00                 KEYSTAT:	IN	CONS
  E13E    E6 40                 	ANI	RDA
  E140    C9                    	RET
                                ;*
                                ;* KEYBOARD CODE CONVERSION
  E141    DB 01                 CONVERT:	IN	COND			;KEYBOARD DATA
  E143    E5                    	PUSH	H
  E144    C5                    	PUSH	B
  E145    01 0005               	LXI	B,(TABLEND-KTABL)/2
  E148    21 E15B               	LXI	H,KTABL
  E14B                          LOOP:	CCI				;COMPARE TABLE
  E14B    ED A1           +     	DB	0EDH,0A1H
                                	JRZ	FND
  E14D    28              +     	DB	28H
  E14E    06              +     	DB	FND-$-1
  E14F    23                    	INX	H
  E150    EA E14B               	JPE	LOOP			;CONT LOOKING
                                	JR	NFND
  E153    18              +     	DB	18H
  E154    01              +     	DB	NFND-$-1
  E155    7E                    FND:	MOV	A,M			;NEW CODE
  E156    E6 7F                 NFND:	ANI	7FH			;MASK DOWN
  E158    C1                    	POP	B
  E159    E1                    	POP	H
  E15A    C9                    	RET
                                ;*
                                ;* THIS TABLE CAN BE EXTENDED IF DESIRED
  E15B                          KTABL:	DD	0E15DH			;]
  E15B    E1              +     	DB	HIGH (0E15DH)
  E15C    5D              +     	DB	LOW (0E15DH)
                                	DD	0F15BH			;[
  E15D    F1              +     	DB	HIGH (0F15BH)
  E15E    5B              +     	DB	LOW (0F15BH)
                                	DD	0A17EH			;~
  E15F    A1              +     	DB	HIGH (0A17EH)
  E160    7E              +     	DB	LOW (0A17EH)
                                	DD	0B15CH			;\
  E161    B1              +     	DB	HIGH (0B15CH)
  E162    5C              +     	DB	LOW (0B15CH)
                                	DD	06015H			;CURSOR UP
  E163    60              +     	DB	HIGH (06015H)
  E164    15              +     	DB	LOW (06015H)
  E165                          TABLEND	EQU	$
  E165                          	DS	KTABL+30-$,0		;ROOM FOR 15 CONVS
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


                                ;*
                                ;* CHECKSUM ROUTINE
  E179    CD E4D3               CHKSM:	CALL	PTSTNG
  E17C    43 48 45 43           	DC	'CHECKSUM '
  E180    4B 53 55 4D           
  E184    A0                    
  E185    CD E10E               	CALL	TAHEX
  E188    06 00                 	MVI	B,0
  E18A    7E                    CHKSMLP:	MOV	A,M
  E18B    80                    	ADD	B
  E18C    47                    	MOV	B,A
  E18D    CD E23F               	CALL	BMP
                                	JRNZ	CHKSMLP
  E190    20              +     	DB	20H
  E191    F8              +     	DB	CHKSMLP-$-1
  E192    78                    	MOV	A,B
  E193    C3 E226               	JMP	PT2
                                ;*
                                ;* WARM START
                                ;*
  E196    CD E4D3               WARM:	CALL	PTSTNG
  E199    4A 55 4D 50           	DC	'JUMP TO DOS'
  E19D    20 54 4F 20           
  E1A1    44 4F D3              
  E1A4    21 04E7               	LXI	H,04E7H			;MDOS RESTART
  E1A7    7E                    	MOV	A,M
  E1A8    FE C3                 	CPI	0C3H
  E1AA    C2 0000               	JNZ	0			;CP/M RESTART
  E1AD    E9                    	PCHL				;MDOS WARM START
                                ;*
                                ;* KEYBOARD ECHO ROUTINE
  E1AE    CD E4D3               ECHO:	CALL	PTSTNG
  E1B1    45 43 48 4F           	DC	'ECHO KEYS '
  E1B5    20 4B 45 59           
  E1B9    53 A0                 
  E1BB    CD E12F               ECOLP:	CALL	ESCAPE			;LOOK AT KEYBOARD
  E1BE    C4 E0DC               	CNZ	PTCN			;PRINT IF KEYPRESS
                                	JR	ECOLP			;CONTINUE LOOPING
  E1C1    18              +     	DB	18H
  E1C2    F8              +     	DB	ECOLP-$-1
                                ;*
                                ;*** MEMORY TEST ROUTINE ***
                                ;*
  E1C3    CD E4D3               TMEM:	CALL	PTSTNG
  E1C6    54 45 53 54           	DC	'TEST '
  E1CA    A0                    
  E1CB    CD E10E               	CALL	TAHEX			;READ ADDRESSES
  E1CE    01 5A5A               	LXI	B,5A5AH			;INI B,C
  E1D1    CD E1FD               CYCL:	CALL	RNDM
  E1D4    C5                    	PUSH	B			;KEEP ALL REGS
  E1D5    E5                    	PUSH	H
  E1D6    D5                    	PUSH	D
  E1D7    CD E1FD               TLOP:	CALL	RNDM
  E1DA    70                    	MOV	M,B			;WRITE IN MEM
  E1DB    CD E23F               	CALL	BMP
  E1DE    C2 E1D7               	JNZ	TLOP			;REPEAT LOOP
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  E1E1    D1                    	POP	D
  E1E2    E1                    	POP	H			;RESTORE ORIG
  E1E3    C1                    	POP	B			;VALUES OF
  E1E4    E5                    	PUSH	H
  E1E5    D5                    	PUSH	D
  E1E6    CD E1FD               RLOP:	CALL	RNDM			;GEN NEW SEQ
  E1E9    7E                    	MOV	A,M			;READ MEM
  E1EA    B8                    	CMP	B			;COMP MEM
  E1EB    C4 E21D               	CNZ	ERR			;CALL ERROR RTN
  E1EE    CD E23F               	CALL	BMP
  E1F1    C2 E1E6               	JNZ	RLOP
  E1F4    D1                    	POP	D
  E1F5    E1                    	POP	H
  E1F6    3E 2E                 	MVI	A,'.'
  E1F8    CD E38A               	CALL	VIDEO
                                	JR	CYCL
  E1FB    18              +     	DB	18H
  E1FC    D4              +     	DB	CYCL-$-1
                                ;*** THIS ROUTINE GENERATES RANDOM NOS ***
  E1FD    CD E120               RNDM:	CALL	PAUSE
  E200    78                    	MOV	A,B			;LOOK AT B
  E201    E6 B4                 	ANI	0B4H			;MASK BITS
  E203    A7                    	ANA	A			;CLEAR CY
  E204    EA E208               	JPE	PEVE			;JUMP IF EVEN
  E207    37                    	STC
  E208    79                    PEVE:	MOV	A,C			;LOOK AT C
  E209    17                    	RAL				;ROTATE CY IN
  E20A    4F                    	MOV	C,A			;RESTORE C
  E20B    78                    	MOV	A,B			;LOOK AT B
  E20C    17                    	RAL				;ROTATE CY IN
  E20D    47                    	MOV	B,A			;RESTORE B
  E20E    C9                    	RET				;RETURN W NEW B,C
                                ;*
                                ;*** ERROR PRINT OUT ROUTINE
                                ;*
  E20F    CD E0DF               PTAD:	CALL	CRLF			;PRINT CR,LF
  E212    CD E120               	CALL	PAUSE
  E215    7C                    	MOV	A,H			;PRINT
  E216    CD E226               	CALL	PT2			;ASCII
  E219    7D                    	MOV	A,L			;CODES
  E21A    C3 E72B               	JMP	PT2S			;FOR ADDRESS
                                ;*
  E21D    F5                    ERR:	PUSH	PSW			;SAVE ACC
  E21E    CD E20F               	CALL	PTAD			;PRINT ADD.
  E221    78                    	MOV	A,B			;DATA
  E222    CD E72B               	CALL	PT2S			;WRITTEN
  E225    F1                    	POP	PSW			;DATA READ
  E226    F5                    PT2:	PUSH	PSW
  E227    CD E22D               	CALL	BINH
  E22A    F1                    	POP	PSW
                                	JR	BINL
  E22B    18              +     	DB	18H
  E22C    04              +     	DB	BINL-$-1
  E22D    1F                    BINH:	RAR				;SHIFT RHT 4 BITS
  E22E    1F                    	RAR
  E22F    1F                    	RAR
