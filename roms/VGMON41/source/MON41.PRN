	MACRO-80 3.44	09-Dec-81	PAGE	1-13


                                ;*        VIDEO DRIVER FOR  FLASHWRITER II       *
                                ;*                                               *
                                ;*************************************************
                                ;*
  F000                          VPAGE	EQU	PR+1000H		;SCREEN LOCATION
  0020                          SPACE	EQU	20H
  0004                          CLRSCRN	EQU	4
                                ;*************************************************
                                ;*                                               *
                                ;* CONTROL CODE COMMANDS:                        *
                                ;*     (B) HOME CURSOR                           *
                                ;*     (D) CLEAR SCREEN                          *
                                ;*     (E) PRINT CONTROL CODE                    *
                                ;*     (H) BACKSPACE                             *
                                ;*     (I) TAB                                   *
                                ;*     (J) LINEFEED                              *
                                ;*     (M) CARRIAGE RETURN                       *
                                ;*     (N) NO CURSOR                             *
                                ;*     (P) CLEAR TO END OF SCREEN                *
                                ;*     (Q) CLEAR TO END OF LINE                  *
                                ;*     (R) CURSOR DOWN                           *
                                ;*     (T) TOGGLE REVERSE VIDEO                  *
                                ;*     (U) CURSOR UP                             *
                                ;*     (W) CURSOR LEFT                           *
                                ;*     (X) CLEAR TO START OF LINE                *
                                ;*     (Z) CURSOR RIGHT                          *
                                ;*     ESC XY POSITION LEAD-IN                   *
                                ;*                                               *
                                ;*************************************************
                                ;*
                                ;* VIDEO BOARD PARAMETERS
  0050                          HORIZ	EQU	80			;NO. OF CHARACTERS
  0018                          VERT	EQU	24			;NO. OF LINES
                                ;*
  E388    3E 14                 TVIDEO:	MVI	A,'T'-64		;TOGGLE VIDEO
                                ;*
  E38A    F5                    VIDEO:	PUSH	PSW
  E38B    C5                    	PUSH	B
  E38C    D5                    	PUSH	D
  E38D    E5                    	PUSH	H
  E38E    E6 7F                 	ANI	07FH
  E390    4F                    	MOV	C,A
  E391    3A E800               	LDA	BASE+800H
  E394    FE C3                 	CPI	0C3H			;PROM THERE?
  E396    79                    	MOV	A,C
  E397    CC E800               	CZ	BASE+800H		;CALL IT IF SO
  E39A    CD E46F               DISPL:	CALL	LIFTCURS		;ERASE CURSOR
  E39D    3A FFEA               	LDA	XYFLAG
  E3A0    A7                    	ANA	A
                                	JRZ	NOXY
  E3A1    28              +     	DB	28H
  E3A2    0A              +     	DB	NOXY-$-1
  E3A3    3D                    	DCR	A
  E3A4    32 FFEA               	STA	XYFLAG
  E3A7    CA E4BE               	JZ	YPOS
  E3AA    C3 E4B5               	JMP	XPOS
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  E3AD    79                    NOXY:	MOV	A,C			;RECOVER CHARACTER
  E3AE    FE 20                 	CPI	SPACE			;PRINTING CODE?
  E3B0    F2 E3E4               	JP	PRINT
  E3B3    FE 1C                 	CPI	PCL-TABL		;TOO LARGE?
  E3B5    F2 E451               	JP	VRET
  E3B8    E5                    	PUSH	H			;CURSOR IN MEMORY
  E3B9    21 E3C7               	LXI	H,TABL			;TABLE START
  E3BC    5F                    	MOV	E,A
  E3BD    16 00                 	MVI	D,0
  E3BF    19                    	DAD	D
  E3C0    5E                    	MOV	E,M
  E3C1    21 E3E3               	LXI	H,PCL
  E3C4    19                    	DAD	D
  E3C5    E3                    	XTHL				;RECOVER H
  E3C6    C9                    	RET				;EXECUTE ROUTINE
                                ;* CONTROL CHARACTER JUMP TABLE
  E3C7    6E                    TABL:	DB	VRET-PCL		;@
  E3C8    6E                    	DB	VRET-PCL		;A
  E3C9    63                    	DB	HOME-PCL		;B HOME CURSOR
  E3CA    6E                    	DB	VRET-PCL		;C
  E3CB    60                    	DB	FORM-PCL		;D CLEAR SCREEN
  E3CC    00                    	DB	PCL-PCL			;E PRT CONTROL
  E3CD    6E                    	DB	VRET-PCL		;F
  E3CE    6E                    	DB	VRET-PCL		;G
  E3CF    42                    	DB	DBACKSP-PCL		;H BACKSPACE
  E3D0    59                    	DB	TAB-PCL			;I TAB OVER
  E3D1    12                    	DB	LINF-PCL		;J LINE FEED
  E3D2    6E                    	DB	VRET-PCL		;K
  E3D3    6E                    	DB	VRET-PCL		;L
  E3D4    6A                    	DB	CRET-PCL		;M CARRIAGE RET
  E3D5    71                    	DB	VRET+3-PCL		;N NO CURSOR
  E3D6    6E                    	DB	VRET-PCL		;O
  E3D7    A7                    	DB	CLEND-PCL		;P CLR SCN TO END
  E3D8    AC                    	DB	CLLINE-PCL		;Q CLR LINE TO END
  E3D9    12                    	DB	LINF-PCL		;R CURSOR DOWN
  E3DA    6E                    	DB	VRET-PCL		;S
  E3DB    76                    	DB	TVIDF-PCL		;T TOGGLE VIDEO
  E3DC    80                    	DB	CURSUP-PCL		;U CURSOR UP
  E3DD    6E                    	DB	VRET-PCL		;V
  E3DE    50                    	DB	BACKSP-PCL		;W CURSOR LEFT
  E3DF    E4                    	DB	CLSTRT-PCL		;X CLR START OF LN
  E3E0    6E                    	DB	VRET-PCL		;Y
  E3E1    06                    	DB	EOL-PCL			;Z CURSOR RIGHT
  E3E2    CB                    	DB	LEDIN-PCL		;[ ESC=XY LEADIN
                                ;*
                                ;* PRINT CODE IN B REGARDLESS
  E3E3    48                    PCL:	MOV	C,B
                                ;* PRINT THE CHARACTER ON THE SCREEN
  E3E4    3A FFDD               PRINT:	LDA	VFL
  E3E7    A9                    	XRA	C
  E3E8    77                    	MOV	M,A
                                ;* EOL CHECKS THE CURS POS FOR END OF LINE
  E3E9    3A FFDB               EOL:	LDA	CURPOS
  E3EC    3C                    	INR	A
  E3ED    FE 50                 	CPI	HORIZ
                                	JRC	TABRET
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  E3EF    38              +     	DB	38H
  E3F0    5D              +     	DB	TABRET-$-1
  E3F1    AF                    	XRA	A
  E3F2    32 FFDB               	STA	CURPOS
                                ;* MOVE DN 1 LINE
  E3F5    3A FFDC               LINF:	LDA	LINENO
