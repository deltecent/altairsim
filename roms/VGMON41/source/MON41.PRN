  E2B9    78                    	MOV	A,B
  E2BA    FE 4D                 	CPI	'M'
                                	JRZ	NEXCH
  E2BC    28              +     	DB	28H
  E2BD    04              +     	DB	NEXCH-$-1
  E2BE    7E                    	MOV	A,M
  E2BF    E3                    	XTHL
  E2C0    77                    	MOV	M,A
  E2C1    E3                    	XTHL
  E2C2    71                    NEXCH:	MOV	M,C
  E2C3    23                    	INX	H
  E2C4    E3                    	XTHL
  E2C5    CD E23F               	CALL	BMP
  E2C8    CA E04C               	JZ	START
                                	JR	MLOOP
  E2CB    18              +     	DB	18H
  E2CC    EA              +     	DB	MLOOP-$-1
                                ;* NON DESTRUCTIVE MEMORY TEST
  E2CD    CD E4D3               NDMT:	CALL	PTSTNG
  E2D0    4D 45 4D 20           	DC	'MEM CHECK'
  E2D4    43 48 45 43           
  E2D8    CB                    
  E2D9    21 0000               	LXI	H,0			;START AT ZERO
  E2DC    4E                    NDLOP:	MOV	C,M
  E2DD    06 FF                 	MVI	B,0FFH
  E2DF    70                    	MOV	M,B
  E2E0    7E                    	MOV	A,M
  E2E1    B8                    	CMP	B
  E2E2    C2 E2EA               	JNZ	ERRJP			;PRINT ERROR
  E2E5    06 00                 	MVI	B,0
  E2E7    70                    	MOV	M,B
