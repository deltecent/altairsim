  E259    55 53 45 52           	DC	'USER AREA'
  E25D    20 41 52 45           
  E261    C1                    
  E262    C3 0100               	JMP	0100H
                                ;*
                                ;* JUMP TO RAM AT PR+1C00
  E265    CD E4D3               RAM:	CALL	PTSTNG
  E268    48 49 20 52           	DC	'HI RAM'
  E26C    41 CD                 
  E26E    C3 FC00               	JMP	PR+1C00H
                                ;*
                                ;* JUMP TO RAM AT 0
  E271    CD E4D3               LORAM:	CALL	PTSTNG
  E274    4C 4F 20 52           	DC	'LO RAM'
  E278    41 CD                 
