  E26B    C3 0000               	JMP	0
                                ;*
                                ;* ZERO OR FILL MEMORY WITH A CONSTANT
  E26E    CD E4C4               ZEROM:	CALL	PTSTNG
  E271    46 49 4C 4C           	DC	'FILL '
  E275    A0                    
  E276    CD E10E               	CALL	TAHEX			;READ ADDRESSES
  E279    E5                    	PUSH	H			;SAVE H
  E27A    CD E10A               	CALL	AHE2			;READ 2 DIGITS
  E27D    EB                    	XCHG
  E27E    E3                    	XTHL				;RESTORE H,L
  E27F    C1                    	POP	B
  E280    71                    ZLOOP:	MOV	M,C			;WRITE INTO MEM
  E281    CD E23F               	CALL	BMP			;COMP ADD, INCR H
  E284    C8                    	RZ				;RETURN IF DONE
                                	JR	ZLOOP			;CONTINUE TIL DONE
