                                ;* COMPARE ADDRESSES AND INCREMENT H
  E23F    7B                    BMP:	MOV	A,E
  E240    95                    	SUB	L
                                	JRNZ	GOON
  E241    20              +     	DB	20H
  E242    02              +     	DB	GOON-$-1
  E243    7A                    	MOV	A,D
  E244    9C                    	SBB	H
  E245    23                    GOON:	INX	H
  E246    C9                    	RET
                                ;*
                                ;* JUMP TO USER RAM
  E247    CD E4C4               USER:	CALL	PTSTNG
  E24A    55 53 45 52           	DC	'USER AREA'
  E24E    20 41 52 45           
  E252    C1                    
  E253    C3 0100               	JMP	0100H
                                ;*
                                ;* JUMP TO RAM AT PR+1C00
  E256    CD E4C4               RAM:	CALL	PTSTNG
  E259    48 49 20 52           	DC	'HI RAM'
  E25D    41 CD                 
  E25F    C3 FC00               	JMP	PR+1C00H
                                ;*
                                ;* JUMP TO RAM AT 0
