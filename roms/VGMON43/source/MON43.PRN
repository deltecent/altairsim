  E2AF    7E                    	MOV	A,M
  E2B0    E3                    	XTHL
  E2B1    77                    	MOV	M,A
  E2B2    E3                    	XTHL
  E2B3    71                    NEXCH:	MOV	M,C
  E2B4    23                    	INX	H
  E2B5    E3                    	XTHL
