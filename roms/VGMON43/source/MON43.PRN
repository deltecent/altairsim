  E2C1    4D 45 4D 20           	DC	'MEM CHECK'
  E2C5    43 48 45 43           
  E2C9    CB                    
  E2CA    21 0000               	LXI	H,0			;START AT ZERO
  E2CD    4E                    NDLOP:	MOV	C,M
