  E2D0    70                    	MOV	M,B
  E2D1    7E                    	MOV	A,M
  E2D2    B8                    	CMP	B
  E2D3    C2 E2DB               	JNZ	ERRJP			;PRINT ERROR
  E2D6    06 00                 	MVI	B,0
  E2D8    70                    	MOV	M,B
  E2D9    7E                    	MOV	A,M
  E2DA    B8                    	CMP	B
  E2DB    C2 E21D               ERRJP:	JNZ	ERR
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  E2DE    71                    	MOV	M,C
  E2DF    23                    	INX	H
                                	JR	NDLOP
  E2E0    18              +     	DB	18H
  E2E1    EB              +     	DB	NDLOP-$-1
                                ;* COMPARE TWO BLOCKS OF MEMORY
  E2E2    CD E4C4               COMPR:	CALL	PTSTNG
  E2E5    43 4F 4D 50           	DC	'COMPARE '
  E2E9    41 52 45 A0           
  E2ED    CD E10E               	CALL	TAHEX
  E2F0    E5                    	PUSH	H
  E2F1    CD E0BD               	CALL	AHEX
  E2F4    EB                    	XCHG
  E2F5    7E                    VMLOP:	MOV	A,M
  E2F6    23                    	INX	H
  E2F7    E3                    	XTHL
  E2F8    BE                    	CMP	M
  E2F9    46                    	MOV	B,M
