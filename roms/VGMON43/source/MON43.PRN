                                	OUTP	E
  E376    ED 59           +     	DB	0EDH,41H+(E*8)
  E378    C9                    	RET
                                ;*
                                ;*
                                ;*************************************************
                                ;*                                               *
                                ;*        VIDEO DRIVER FOR  FLASHWRITER II       *
                                ;*                                               *
                                ;*************************************************
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


                                ;*
  F000                          VPAGE	EQU	PR+1000H		;SCREEN LOCATION
  0020                          SPACE	EQU	20H
  0004                          CLRSCRN	EQU	4
                                ;*************************************************
                                ;*                                               *
                                ;* CONTROL CODE COMMANDS:                        *
                                ;*     (B) HOME CURSOR                           *
                                ;*     (D) CLEAR SCREEN                          *
                                ;*     (E) PRINT CONTROL CODE                    *
                                ;*     (H) BACKSPACE                             *
                                ;*     (I) TAB                                   *
                                ;*     (J) LINEFEED                              *
                                ;*     (M) CARRIAGE RETURN                       *
                                ;*     (N) NO CURSOR                             *
                                ;*     (P) CLEAR TO END OF SCREEN                *
                                ;*     (Q) CLEAR TO END OF LINE                  *
                                ;*     (R) CURSOR DOWN                           *
                                ;*     (T) TOGGLE REVERSE VIDEO                  *
                                ;*     (U) CURSOR UP                             *
                                ;*     (W) CURSOR LEFT                           *
                                ;*     (X) CLEAR TO START OF LINE                *
                                ;*     (Z) CURSOR RIGHT                          *
                                ;*     ESC XY POSITION LEAD-IN                   *
                                ;*                                               *
                                ;*************************************************
                                ;*
                                ;* VIDEO BOARD PARAMETERS
  0050                          HORIZ	EQU	80			;NO. OF CHARACTERS
  0018                          VERT	EQU	24			;NO. OF LINES
                                ;*
  E379    3E 14                 TVIDEO:	MVI	A,'T'-64		;TOGGLE VIDEO
                                ;*
  E37B    F5                    VIDEO:	PUSH	PSW
  E37C    C5                    	PUSH	B
  E37D    D5                    	PUSH	D
  E37E    E5                    	PUSH	H
  E37F    E6 7F                 	ANI	07FH
  E381    4F                    	MOV	C,A
  E382    3A E800               	LDA	BASE+800H
  E385    FE C3                 	CPI	0C3H			;PROM THERE?
  E387    79                    	MOV	A,C
  E388    CC E800               	CZ	BASE+800H		;CALL IT IF SO
  E38B    CD E460               DISPL:	CALL	LIFTCURS		;ERASE CURSOR
  E38E    3A FFEA               	LDA	XYFLAG
  E391    A7                    	ANA	A
                                	JRZ	NOXY
  E392    28              +     	DB	28H
  E393    0A              +     	DB	NOXY-$-1
  E394    3D                    	DCR	A
  E395    32 FFEA               	STA	XYFLAG
  E398    CA E4AF               	JZ	YPOS
  E39B    C3 E4A6               	JMP	XPOS
  E39E    79                    NOXY:	MOV	A,C			;RECOVER CHARACTER
  E39F    FE 20                 	CPI	SPACE			;PRINTING CODE?
  E3A1    F2 E3D5               	JP	PRINT
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  E3A4    FE 1C                 	CPI	PCL-TABL		;TOO LARGE?
  E3A6    F2 E442               	JP	VRET
  E3A9    E5                    	PUSH	H			;CURSOR IN MEMORY
  E3AA    21 E3B8               	LXI	H,TABL			;TABLE START
  E3AD    5F                    	MOV	E,A
  E3AE    16 00                 	MVI	D,0
  E3B0    19                    	DAD	D
  E3B1    5E                    	MOV	E,M
  E3B2    21 E3D4               	LXI	H,PCL
  E3B5    19                    	DAD	D
  E3B6    E3                    	XTHL				;RECOVER H
  E3B7    C9                    	RET				;EXECUTE ROUTINE
                                ;* CONTROL CHARACTER JUMP TABLE
  E3B8    6E                    TABL:	DB	VRET-PCL		;@
  E3B9    6E                    	DB	VRET-PCL		;A
  E3BA    63                    	DB	HOME-PCL		;B HOME CURSOR
  E3BB    6E                    	DB	VRET-PCL		;C
  E3BC    60                    	DB	FORM-PCL		;D CLEAR SCREEN
  E3BD    00                    	DB	PCL-PCL			;E PRT CONTROL
  E3BE    6E                    	DB	VRET-PCL		;F
  E3BF    6E                    	DB	VRET-PCL		;G
  E3C0    42                    	DB	DBACKSP-PCL		;H BACKSPACE
  E3C1    59                    	DB	TAB-PCL			;I TAB OVER
  E3C2    12                    	DB	LINF-PCL		;J LINE FEED
  E3C3    6E                    	DB	VRET-PCL		;K
  E3C4    6E                    	DB	VRET-PCL		;L
  E3C5    6A                    	DB	CRET-PCL		;M CARRIAGE RET
  E3C6    71                    	DB	VRET+3-PCL		;N NO CURSOR
  E3C7    6E                    	DB	VRET-PCL		;O
  E3C8    A7                    	DB	CLEND-PCL		;P CLR SCN TO END
  E3C9    AC                    	DB	CLLINE-PCL		;Q CLR LINE TO END
  E3CA    12                    	DB	LINF-PCL		;R CURSOR DOWN
  E3CB    6E                    	DB	VRET-PCL		;S
  E3CC    76                    	DB	TVIDF-PCL		;T TOGGLE VIDEO
  E3CD    80                    	DB	CURSUP-PCL		;U CURSOR UP
  E3CE    6E                    	DB	VRET-PCL		;V
  E3CF    50                    	DB	BACKSP-PCL		;W CURSOR LEFT
  E3D0    E4                    	DB	CLSTRT-PCL		;X CLR START OF LN
  E3D1    6E                    	DB	VRET-PCL		;Y
  E3D2    06                    	DB	EOL-PCL			;Z CURSOR RIGHT
  E3D3    CB                    	DB	LEDIN-PCL		;[ ESC=XY LEADIN
                                ;*
                                ;* PRINT CODE IN B REGARDLESS
  E3D4    48                    PCL:	MOV	C,B
                                ;* PRINT THE CHARACTER ON THE SCREEN
  E3D5    3A FFDD               PRINT:	LDA	VFL
  E3D8    A9                    	XRA	C
  E3D9    77                    	MOV	M,A
                                ;* EOL CHECKS THE CURS POS FOR END OF LINE
  E3DA    3A FFDB               EOL:	LDA	CURPOS
  E3DD    3C                    	INR	A
  E3DE    FE 50                 	CPI	HORIZ
                                	JRC	TABRET
  E3E0    38              +     	DB	38H
  E3E1    5D              +     	DB	TABRET-$-1
  E3E2    AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  E3E3    32 FFDB               	STA	CURPOS
                                ;* MOVE DN 1 LINE
  E3E6    3A FFDC               LINF:	LDA	LINENO
  E3E9    FE 17                 	CPI	VERT-1
                                	JRNZ	NOSCRL
  E3EB    20              +     	DB	20H
  E3EC    23              +     	DB	NOSCRL-$-1
                                ;* SCROLL UP ONE LINE
  E3ED    21 0050               SCROLL:	LXI	H,HORIZ
                                	LDED	TOSCN
  E3F0    ED 5B           +     	DB	0EDH,5BH
  E3F2    FFDF            +     	DW	TOSCN
  E3F4    19                    	DAD	D
