  E336    7E                    CONT:	MOV	A,M			;READ MEMORY
  E337    B8                    	CMP	B			;COMPARE TO CODE
                                	JRNZ	SKP			;SKIP IF NO COMP
  E338    20              +     	DB	20H
  E339    12              +     	DB	SKP-$-1
