                                	JRZ	OBCP
  E33E    28              +     	DB	28H
  E33F    06              +     	DB	OBCP-$-1
  E340    23                    	INX	H
  E341    7E                    	MOV	A,M
  E342    2B                    	DCX	H
  E343    B9                    	CMP	C
                                	JRNZ	SKP
  E344    20              +     	DB	20H
  E345    06              +     	DB	SKP-$-1
  E346    23                    OBCP:	INX	H
  E347    7E                    	MOV	A,M			;READ NEXT BYTE
  E348    2B                    	DCX	H			;DECR ADDRESS
  E349    CD E21D               	CALL	ERR			;PRINT CODES
  E34C    CD E23F               SKP:	CALL	BMP			;CHECK IF DONE
