  E322    E5                    	PUSH	H			;SAVE H
  E323    CD E10A               	CALL	AHE2			;READ 2 DIGITS
  E326    EB                    	XCHG				;H=CODE,D=F
  E327    45                    	MOV	B,L			;PUT CODE IN B
