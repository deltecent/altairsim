  E3FC    20              +     	DB	20H
  E3FD    F7              +     	DB	SCRL-$-1
  E3FE    7D                    	MOV	A,L
  E3FF    FE 80                 	CPI	LOW (HORIZ*VERT+VPAGE)
                                	JRNZ	SCRL
  E401    20              +     	DB	20H
  E402    F2              +     	DB	SCRL-$-1
  E403    3A FFDC               	LDA	LINENO
                                ;* ERASE BOTTOM LINE
  E406    EB                    EBOTL:	XCHG
  E407    06 50                 	MVI	B,HORIZ
  E409    36 20                 ELOP:	MVI	M,SPACE
  E40B    23                    	INX	H
  E40C    05                    	DCR	B
                                	JRNZ	ELOP
  E40D    20              +     	DB	20H
  E40E    FA              +     	DB	ELOP-$-1
  E40F    3D                    	DCR	A
  E410    3C                    NOSCRL:	INR	A
  E411    32 FFDC               	STA	LINENO
                                	JR	VRET
  E414    18              +     	DB	18H
  E415    2C              +     	DB	VRET-$-1
                                ;*
                                ;* ERASE BEFORE BACKSPACING
  E416    36 20                 DBACKSP:	MVI	M,20H
  E418    3A FFDB               	LDA	CURPOS
  E41B    A7                    	ANA	A
                                	JRZ	VRET
  E41C    28              +     	DB	28H
  E41D    24              +     	DB	VRET-$-1
  E41E    3D                    	DCR	A
  E41F    2B                    	DCX	H
  E420    36 20                 	MVI	M,20H
                                	JR	TABRET
  E422    18              +     	DB	18H
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  E423    1B              +     	DB	TABRET-$-1
                                ;* MOVE THE CURSOR BACK
  E424    3A FFDB               BACKSP:	LDA	CURPOS
  E427    3D                    	DCR	A
  E428    F2 E43F               	JP	TABRET
                                	JR	CRET
  E42B    18              +     	DB	18H
  E42C    11              +     	DB	CRET-$-1
                                ;* TAB OVER TO THE NEXT 8 MULTIPLE
  E42D    3A FFDB               TAB:	LDA	CURPOS
  E430    F6 07                 	ORI	7
                                	JR	EOL+3
  E432    18              +     	DB	18H
  E433    A9              +     	DB	EOL+3-$-1
                                ;* CLEAR THE SCREEN AND HOME UP
  E434    CD E48D               FORM:	CALL	CLEAR
  E437    AF                    HOME:	XRA	A
  E438    32 FFDC               	STA	LINENO
  E43B    32 FFDD               	STA	VFL			;CLR VID FLAG
                                ;* CARRIAGE RETURN
  E43E    AF                    CRET:	XRA	A
  E43F    32 FFDB               TABRET:	STA	CURPOS
                                ;* RETURN TO THE CALLING ROUTINE
  E442    CD E460               VRET:	CALL	LIFTCURS
  E445    E1                    	POP	H
  E446    D1                    	POP	D
  E447    C1                    	POP	B
  E448    F1                    	POP	PSW
  E449    C9                    	RET
  E44A    3A FFDD               TVIDF:	LDA	VFL
