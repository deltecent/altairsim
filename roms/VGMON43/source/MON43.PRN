  E235    FE 3A                 	CPI	58			;DIGIT 0-9
  E237    DA E0DC               	JC	PTCN
  E23A    C6 07                 	ADI	7			;DIGIT A-F
  E23C    C3 E0DC               	JMP	PTCN
