  522 F009  C3 F05B     ZCO:		JP	HIGH_CO			;CONSOL OUTPUT
  523 F00C  C3 F052     ZPOO:		JP	NoHighPageError		;This routine resides on the LOW page ROM
  524 F00F  C3 F173     ZLO:		JP	HIGH_LO			;Printer Output
