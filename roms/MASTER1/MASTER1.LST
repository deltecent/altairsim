 1133 F2C1  C3 F05B     	JP	HIGH_CO
 1134                   
 1135 F2C4              PRTDOT:
 1136 F2C4  F5          	PUSH	AF
 1137 F2C5  C5          	PUSH	BC
 1138 F2C6  0E 2E       	LD	C,'.'
 1139 F2C8  CD F05B     	CALL	HIGH_CO
 1140 F2CB  C1          	POP	BC
 1141 F2CC  F1          	POP	AF
 1142 F2CD  C9          	RET
