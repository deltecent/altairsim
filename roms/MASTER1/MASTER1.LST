  643 F0B4  CD F0BD     	CALL	DELAY
  644 F0B7  3E 07       	LD	A,07H
  645 F0B9  D3 01       	OUT	(CONSOL_OUT),A
  646 F0BB  18 D1       	JR	SDCON5
  647                   
  648                   
  649 F0BD  3D          DELAY:	DEC	A			;GENERAL COUNT DOWN TIME DELAY
  650 F0BE  C8          	RET	Z			;LENGTH SET IN [A]
  651 F0BF  F5          	PUSH	AF
  652 F0C0  3E 05       	LD	A,05H
  653 F0C2  3D          MORE:	DEC	A
  654 F0C3  F5          	PUSH	AF
