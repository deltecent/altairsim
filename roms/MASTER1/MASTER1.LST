 1146 F2CE  0E 2A       	LD	C,'*'
 1147 F2D0  CD F05B     	CALL	HIGH_CO
 1148 F2D3  C3 F01C     	JP	ACTIVATE_LOW_PAGE
 1149                   
 1150                   ;---------------------------------------------------------------------------------------------------------------
 1151                   ;This code will read a download file from another computer (usually a PC) sent via a serial port and place
 1152                   ;it in RAM at a specified location.  The file must be sent via the XModem protocol. On PC's there are
 1153                   ;many programs that do this. The "Absolute Telnet" program (by Celestial Software) is what I use.
 1154                   
 1155 F2D6              HIGH_XMODEM:
 1156 F2D6  21 F7F3     	LD	HL,MODEM_SIGNON		;Send Modem signon message
 1157 F2D9  CD F298     	CALL	HIGH_PRINT_STRING
 1158                   					
 1159 F2DC  21 0000     	LD	HL,0			;SP to HL
 1160 F2DF  39          	ADD	HL,SP			
 1161 F2E0  11 0040     	LD	DE,40H			;Drop 40H bytes below stack to be safe
 1162 F2E3  ED 52       	SBC	HL,DE
 1163 F2E5  E5          	PUSH	HL
 1164 F2E6  DD E1       	POP	IX			;Will store data in RAM 40H bytes below SP to be safe
 1165                   					
 1166 F2E8  CD F10E     	CALL	HIGH_CI			;Get menu item 1,2 or 3
 1167 F2EB  FE 1B       	CP	A,ESC
 1168 F2ED  CA F2CE     	JP	Z,HIGH_ERROR
 1169 F2F0  DD 77 03    	LD	(IX+MENU_NUMBER),A	;Store menu selection in RAM			
 1170 F2F3  4F          	LD	C,A
 1171 F2F4  CD F05B     	CALL	HIGH_CO
 1172 F2F7  FE 31       	CP	A,'1'
 1173 F2F9  28 0B       	JR	Z,SELECT_SERIAL1
 1174 F2FB  FE 32       	CP	A,'2'
 1175 F2FD  28 1A       	JR	Z,SELECT_SERIAL2
 1176 F2FF  FE 33       	CP	A,'3'
 1177 F301  28 29       	JR	Z,SELECT_Z80_USB
 1178 F303  C3 F2CE     	JP	HIGH_ERROR
 1179                   
 1180 F306              SELECT_SERIAL1:
 1181 F306  DB A1       	IN	A,(MODEM_CTL_PORT)
 1182 F308  FE FF       	CP	A,0FFH
 1183 F30A  CA F323     	JP	Z,NO_SERIAL_1
 1184 F30D  21 F8D2     	LD	HL,MODEM_SCC_MSG	;Send Modem serial parameters
 1185 F310  CD F298     	CALL	HIGH_PRINT_STRING
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.30 Page  21
