  286                   
  287                   ;--------------- PORTS FOR FOR Z80/WD2793 FDC Board
  288                   
  289         0010      S100_DATA_A	EQU	10H		;IN,  S100 Data port to GET data to from FDC Board
  290         0010      S100_DATA_B	EQU	10H		;OUT, S100 Data port to SEND data to FDC Board
  291         0011      S100_STATUS_A	EQU	11H		;Status port for A
  292         0011      S100_STATUS_B	EQU	11H		;Status port for B
