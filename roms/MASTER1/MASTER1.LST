 1592                   	; Check loaded image marker
 1593 F590  3A 0100     	LD	A,(STARTCPM)		; get first byte of loaded data
 1594 F593  FE 31       	CP	31H			; expect to have 31H, ie. ld sp,80h
 1595 F595  C2 F648     	JP	NZ,ERR_BADIMAGE		; handle invalid boot sector data
 1596                   
 1597                   	; Launch CP/M
 1598 F598  C3 0100     	JP	STARTCPM		; start CP/M
 1599                   
 1600                   
 1601                   
 1602                   
 1603                   ;-------------- BOOT UP ROMWBW FROM SD CARD ON S100COMPUTERS SD BOARD ----------------
 1604                   
 1605 F59B              SDWBW:
 1606 F59B  21 FAE7     	LD	HL,SDWBWLOAD$MSG	; ROMWBW load start message
 1607 F59E  CD F298     	CALL	HIGH_PRINT_STRING
 1608                   
 1609                   	; Initialize
 1610 F5A1  CD F60A     	CALL	SD_INIT			; initialize SD Card
 1611 F5A4  C2 F63E     	JP	NZ,ERR_MEDIA		; handle error
 1612 F5A7  CD F2C4     	CALL	PRTDOT			; display progress
 1613                   
 1614                   	; This is the main loading loop.  Each MMU bank is 16K, so we
 1615                   	; have an inner loop to read and load 32 sectors.  An outer
 1616                   	; loop increments the MMU bank selection, so we wind up loading
 1617                   	; the desired 128K in 8 consecutive banks.
 1618 F5AA  11 0400     	LD	DE,1024			; DE is LBA (start from sec 1024)
 1619 F5AD  0E 04       	LD	C,4			; C is MMU bank (start from 4)
 1620 F5AF              SDWBW1:
 1621                   	; Outer loop (once per bank)
 1622 F5AF  21 0000     	LD	HL,0000H		; HL is RAM address
 1623 F5B2  06 20       	LD	B,32			; B is sector count, load 32 sectors per bank
 1624 F5B4  79          	LD	A,C			; get bank to be loaded
 1625 F5B5  07          	RLCA				; rotate bank num
 1626 F5B6  07          	RLCA				; ... to top 6 bits
 1627 F5B7  D3 D2       	OUT	(MPGSEL_0),A		; and select it
 1628                   
 1629 F5B9              SDWBW2:
 1630                   	; Inner loop (once per sector)
 1631 F5B9  C5          	PUSH	BC			; save loop control
 1632 F5BA  D5          	PUSH	DE			; save LBA
 1633 F5BB  CD F614     	CALL	SD_SEEK			; seek to desired LBA
 1634 F5BE  CC F626     	CALL	Z,SD_READBLK		; read sector, HL will be incremented
 1635 F5C1  D1          	POP	DE			; recover LBA
 1636 F5C2  C1          	POP	BC			; recover loop control
 1637 F5C3  C2 F643     	JP	NZ,ERR_IO		; handle error
 1638 F5C6  13          	INC	DE			; next sector
 1639 F5C7  10 F0       	DJNZ	SDWBW2			; loop until all bank sectors done
 1640                   
 1641                   	; Show progress
 1642 F5C9  CD F2C4     	CALL	PRTDOT			; display progress
 1643                   
 1644                   	; Setup for next bank and check for done
 1645 F5CC  0C          	INC	C			; next bank
 1646 F5CD  79          	LD	A,C			; put in A
 1647 F5CE  FE 0C       	CP	4 + 8			; 128K / 16K = 8 banks
 1648 F5D0  20 DD       	JR	NZ,SDWBW1		; loop until all banks done
 1649                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.30 Page  29
MASTER1 Z80

 1650                   	; Setup the lower 16K with the first 16K of RomWBW
 1651 F5D2  3E 10       	LD	A,4 << 2		; first 16K bank
 1652 F5D4  D3 D2       	OUT	(MPGSEL_0),A		; set it
 1653                   
 1654                   	; Completion message
 1655 F5D6  21 FAF9     	LD	HL,SDDONE$MSG		; load complete message
 1656 F5D9  CD F298     	CALL	HIGH_PRINT_STRING	; display it
 1657                   
 1658                   	;; Back to main menu (page 0)
 1659                   	;JP	ACTIVATE_LOW_PAGE	; Return to main menu in ROM page A
 1660                   
 1661                   	; Check loaded image marker
 1662 F5DC  2A 0004     	LD	HL,(0004H)		; marker bytes location ptr
 1663 F5DF  7E          	LD	A,(HL)
 1664 F5E0  FE 76       	CP	076H			; first marker byte
 1665 F5E2  C2 F648     	JP	NZ,ERR_BADIMAGE		; handle invalid boot sector data
 1666 F5E5  23          	INC	HL
 1667 F5E6  7E          	LD	A,(HL)
 1668 F5E7  FE B5       	CP	0B5H			; second marker byte
 1669 F5E9  C2 F648     	JP	NZ,ERR_BADIMAGE		; handle invalid boot sector data
 1670                   
 1671                   	; Launch RomWBW
 1672 F5EC  C3 0000     	JP	0000H			; start RomWBW
 1673                   
 1674                   ;-------------- SD CARD SUPPORT ROUTINES ----------------
 1675                   
 1676                   ; Send command in C to SD interface, command result in A
 1677 F5EF              SD_CMD:
 1678 F5EF  C5          	PUSH	BC			; save command byte
 1679 F5F0  0E 33       	LD	C,33H			; set command prefix byte
 1680 F5F2  CD F5F6     	CALL	SD_PUTBYTE		; send it
 1681 F5F5  C1          	POP	BC			; recover command byte
 1682                   	; fall thru to send command byte
 1683                   
 1684                   ; Write byte in C to SD interface, put result in A
 1685 F5F6              SD_PUTBYTE:
 1686 F5F6  DB 80       	IN	A,(SD_STAT)		; get status
 1687 F5F8  CB 47       	BIT	0,A			; check bit 0 for ready to send
 1688 F5FA  20 FA       	JR	NZ,SD_PUTBYTE		; if not, loop
 1689 F5FC  79          	LD	A,C			; byte to send to A
 1690 F5FD  D3 81       	OUT	(SD_DATA),A		; send it
 1691 F5FF  C9          	RET
 1692                   
 1693                   ; Read a byte from SD interface to C, read result in A
 1694 F600              SD_GETBYTE:
 1695 F600  DB 80       	IN	A,(SD_STAT)		; get status
 1696 F602  CB 7F       	BIT	7,A			; check bit 7 for ready to read
 1697 F604  28 FA       	JR	Z,SD_GETBYTE		; if not, loop
 1698 F606  DB 81       	IN	A,(SD_DATA)		; get the byte
 1699 F608  4F          	LD	C,A			; put in C
 1700 F609  C9          	RET
 1701                   
 1702                   ; Initialize the SD Card, init result in A
 1703 F60A              SD_INIT:
 1704 F60A  0E 80       	LD	C,SD$CMD$INIT0		; setup command
 1705 F60C  CD F5EF     	CALL	SD_CMD			; send it
 1706 F60F  CD F600     	CALL	SD_GETBYTE		; get result
 1707 F612  B7          	OR	A			; set flags
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.30 Page  30
MASTER1 Z80

 1708 F613  C9          	RET
 1709                   
 1710                   ; Seek to LBA in DE, seek result in A
 1711 F614              SD_SEEK:
 1712 F614  0E 84       	LD	C,SD$CMD$SETTRKSEC	; setup command
 1713 F616  CD F5EF     	CALL	SD_CMD			; send it
 1714 F619  4A          	LD	C,D			; setup track byte
 1715 F61A  CD F5F6     	CALL	SD_PUTBYTE		; send it
 1716 F61D  4B          	LD	C,E			; setup sector byte
 1717 F61E  CD F5F6     	CALL	SD_PUTBYTE		; send it
 1718 F621  CD F600     	CALL	SD_GETBYTE		; get result
 1719 F624  B7          	OR	A			; set flags
 1720 F625  C9          	RET
 1721                   
 1722                   ; Read a sector into buf at HL, read result in A
 1723 F626              SD_READBLK:
 1724 F626  0E 85       	LD	C,SD$CMD$READ		; setup command
 1725 F628  CD F5EF     	CALL	SD_CMD			; send it
 1726 F62B  06 00       	LD	B,0			; 256 loops, 2 bytes each
 1727 F62D              SD_READBLK1:
 1728 F62D  CD F600     	CALL	SD_GETBYTE		; get next byte
 1729 F630  71          	LD	(HL),C			; save it
 1730 F631  23          	INC	HL			; bump buf ptr
 1731 F632  CD F600     	CALL	SD_GETBYTE		; get next byte
 1732 F635  71          	LD	(HL),C			; save it
 1733 F636  23          	INC	HL			; bump buf ptr
 1734 F637  10 F4       	DJNZ	SD_READBLK1		; loop as needed
 1735 F639  CD F600     	CALL	SD_GETBYTE		; get result
 1736 F63C  B7          	OR	A			; set flags
 1737 F63D  C9          	RET
