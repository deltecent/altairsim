 1195 F323  21 FD25     	LD	HL,NO_SERIAL_MSGG	;No Serial board detected
 1196 F326  CD F298     	CALL	HIGH_PRINT_STRING
 1197 F329  C3 F01C     	JP	ACTIVATE_LOW_PAGE
 1198                   
