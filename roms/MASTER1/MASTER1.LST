  961                   ;	
  962 F209              HIGH_SCCINIT_A:
  963 F209  04          	DB	04H			;Point to WR4
  964 F20A  44          	DB	44H			;X16 clock,1 Stop,NP
  965 F20B  03          	DB	03H			;Point to WR3
  966 F20C  C1          	DB	0C1H			;Enable reciever, Auto Enable, Recieve 8 bits	
  967                   ;	DB	0E1H			;Enable reciever, No Auto Enable, Recieve 8 bits (for CTS bit)	
  968 F20D  05          	DB	05H			;Point to WR5
  969 F20E  EA          	DB	0EAH			;Enable, Transmit 8 bits
  970 F20F  0B          	DB	0BH			;Set RTS,DTR, Enable. Point to WR11
  971 F210  56          	DB	56H			;Recieve/transmit clock = BRG
  972 F211  0C          	DB	0CH			;Point to WR12
  973                   ;	DB	40H			;Low Byte 2400 Baud 
  974                   ;	DB	1EH			;Low Byte 4800 Baud 
  975                   ;	DB	0EH			;Low Byte 9600 Baud 
  976 F212  06          	DB	06H			;Low byte 19,200 Baud <<<<<<<<<<< XModem I/O
  977                   ;	DB	02H			;Low byte 38,400 Baud 
  978                   ;	DB	00H			;Low byte 76,800 Baud  
  979 F213  0D          	DB	0DH			;Point to WR13
  980 F214  00          	DB	00H			;High byte for Baud
  981 F215  0E          	DB	0EH			;Point to WR14
  982 F216  01          	DB	01H			;Use 4.9152 MHz Clock. Note SD Systems uses a 2.4576 MHz clock, enable BRG
  983 F217  0F          	DB	0FH			;Point to WR15
  984 F218  00          	DB	00H			;Generate Int with CTS going high
  985                   
  986 F219              HIGH_SCCINIT_B:
  987 F219  04          	DB	04H			;Point to WR4
  988 F21A  44          	DB	44H			;X16 clock,1 Stop,NP
  989 F21B  03          	DB	03H			;Point to WR3
  990 F21C  C1          	DB	0C1H			;Enable reciever, Auto Enable, Recieve 8 bits	
  991 F21D  05          	DB	05H			;Point to WR5
  992 F21E  EA          	DB	0EAH			;Enable, Transmit 8 bits
  993 F21F  0B          	DB	0BH			;Set RTS,DTR, Enable. Point to WR11
  994 F220  56          	DB	56H			;Recieve/transmit clock = BRG
  995 F221  0C          	DB	0CH			;Point to WR12
  996 F222  06          	DB	06H			;Low byte 19,200 Baud <<<<<<<<<<< Note Speech synthizer defaults to this value
  997 F223  0D          	DB	0DH			;Point to WR13
  998 F224  00          	DB	00H			;High byte for Baud
  999 F225  0E          	DB	0EH			;Point to WR14
 1000 F226  01          	DB	01H			;Use 4.9152 MHz Clock. Note SD Systems uses a 2.4576 MHz clock, enable BRG
 1001 F227  0F          	DB	0FH			;Point to WR15
 1002 F228  00          	DB	00H			;Generate Int with CTS going high
