  527                   ;----------------->>> THIS CODE MUST BE AT THE SAME LOCATION AS FOR THE LOW PAGE ROM CODE <<<---------
  528                   ;
  529 F015              ACTIVATE_HIGH_PAGE:				; SWITCH TO HIGH PAGE of ROM 
  530 F015  00          	NOP
  531 F016  00          	NOP
  532 F017  00          	NOP
  533 F018  00          	NOP
  534 F019  C3 F023     	JP	HIGH_MENU_OPTION
  535                   	
  536 F01C              ACTIVATE_LOW_PAGE:				; RETURN BACK TO LOW PAGE OF ROM
  537 F01C  3E 04       	LD	A,04H				; 04H for MEMORY MANAGEMENT TO OVERLAP + Bit 1 = HIGH PAGE
  538 F01E  D3 D3       	OUT	(Z80PORT+3),A	
  539 F020  C3 F052     	JP	NoHighPageError			; Will arrive here only IF no address line switch. 
  540                   ;
  541                   ;----------------------->>> END OF COMMON CODE LOACTIONS <<<----------------------------------
  542                   ;
  543                   ;
  544 F023              HIGH_MENU_OPTION:
  545 F023  7A          	LD	A,D				; HIGH PAGE code with 1 in [D] for XMODEM
  546 F024  FE 01       	CP	A,1
  547 F026  CA F2D6     	JP	Z,HIGH_XMODEM
  548 F029  FE 02       	CP	A,2
  549 F02B  CA F551     	JP	Z,SDCPM
  550 F02E  FE 03       	CP	A,3
  551 F030  CA F59B     	JP	Z,SDWBW
  552 F033  FE 04       	CP	A,4
  553 F035  CA F656     	JP	Z,SHOW_TIME			;Display Time/Date if hardware is [present
  554 F038  FE 05       	CP	A,5
  555 F03A  CA F740     	JP	Z,HIGH_BOARDS			;Display S100 boards in system
  556 F03D  C3 F040     	JP	INVALID_MENU_ERROR		; The only menu option so far
  557                   	
