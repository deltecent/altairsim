 1791 F685  DB 71       	IN	A,(CMOS_PORT+1)		;Get BCD value returned
 1792 F687  47          	LD	B,A			;SAVE
 1793 F688  1E 00       	LD	E,0			;SET E TO ZERO
 1794 F68A  CD F691     	CALL	DisplayTime
