  870 F1A6              SPEAKOUT:				;Send test to serial board speaker
  871 F1A6  AF          	XOR	A,A			;Will try 256 times, then timeout
  872 F1A7  F5          SPXXX:	PUSH	AF
  873 F1A8  DB A0       	IN	A,(BCTL)		;(A0), Is SCC RX Buffer empty
  874 F1AA  E6 04       	AND	04H
  875 F1AC  20 05       	JR	NZ,SENDS		;NZ if ready to recieve character
  876 F1AE  F1          	POP	AF
  877 F1AF  3D          	DEC	A
  878 F1B0  20 F5       	JR	NZ,SPXXX
  879 F1B2  C9          	RET
  880 F1B3  F1          SENDS:	POP	AF
  881 F1B4  79          	LD	A,C
  882 F1B5  D3 A2       	OUT	(BDTA),A		;(A2), Send it
  883 F1B7  C9          	RET
  884                   ;
  885                   ;SPEAKTOMM THIS IS A ROUTINE TO SEND A STRING TO TALKER [HL] AT STRING
  886 F1B8              HIGH_SPEAK:	
  887 F1B8  7E          	LD	A,(HL)
  888 F1B9  FE 24       	CP	'$'
  889 F1BB  28 07       	JR	Z,SPEAK1
  890 F1BD  4F          	LD	C,A
  891 F1BE  CD F1A6     	CALL	SPEAKOUT
  892 F1C1  23          	INC	HL
  893 F1C2  18 F4       	JR	HIGH_SPEAK
  894 F1C4  0E 0D       SPEAK1:	LD	C,0DH			;MUST END WITH A CR
  895 F1C6  C3 F1A6     	JP	SPEAKOUT
