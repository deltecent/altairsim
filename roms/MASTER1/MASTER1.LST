  665 F0CE              HIGH_CSTS:
  666         FFFF      IF   V3_Z80CPU_BOARD			; Is this an S100Computers V3 Z80 CPU Board
  667 F0CE  DB E8       	IN	A,(Z80_USB_STATUS)	; For V3 Z80 board special case check for USB output
  668 F0D0  CB 47       	BIT	0,A			; jumper K8 is set to ground
  669 F0D2  CA F0FE     	JP	Z,Z80_USB_STAT		; Special case V3 CPU Board
  670                   ENDIF
  671 F0D5  DB EF       	IN      A,(IOBYTE)              ; Read IOBYTE (hopefully 0xFF if non-existent) Printer has no status
  672 F0D7  E6 30               AND     00110000B               ; Isolate the console device bits
  673 F0D9  FE 30               CP      00110000B               ; Propeller?
  674 F0DB  28 0D               JR      Z,PROPELLER_CSTS        ; If so, get it
  675 F0DD  FE 20               CP      00100000B               ; Serial I/O Board SCC Port A?
  676 F0DF  CA F1EB             JP      Z,SERIAL_STAT           ; If so, do it
  677 F0E2  FE 10               CP      00010000B               ; Serial I/O Board DLP USB Port?
  678 F0E4  CA F0F6             JP      Z,SERIAL_USB_STAT       ; If so, do it
  679 F0E7  C3 F106             JP      PS2_STAT                ; PS2 keyboard on FPGA VGA Board is only other possibility
