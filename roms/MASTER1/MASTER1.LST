 1365 F44E  3E 05       	LD	A,5H			;Lower RTS line
 1366 F450  D3 A1       	OUT	MODEM_CTL_PORT,A	;Sel Reg 5
 1367 F452  3E EA       	LD	A,11101010B		;EAH
 1368 F454  D3 A1       	OUT	MODEM_CTL_PORT,A
 1369 F456  00          	NOP
 1370 F457  00          	NOP
 1371 F458  11 BBBB     MSEC1:	LD	DE,0BBBBH		;1 SEC DCR COUNT
 1372 F45B  DB A1       MWTI1:	IN	A,MODEM_CTL_PORT
 1373 F45D  E6 01       	AND	A,MODEM_RECV_MASK
 1374 F45F  FE 01       	CP	A,RECV_READY
 1375 F461  CA F473     	JP	Z,MCHAR1		;GOT CHAR
 1376 F464  1D          	DEC	E			;COUNT DOWN
