 1779 F66E  D2 F674     	JP	NC,RTC_2A		;GO AROUND IF OK
 1780 F671  C3 F68F     	JP	RTC_ERROR		;IF ERROR
 1781                   
 1782 F674              RTC_2A:	
 1783 F674  1E FE       	LD	E,-2			;-2 goes to 0 for PORT_INC_2 
 1784 F676  CD F720     	CALL	PORT_INC_2		;SET ADDRESS OF SECONDS
 1785 F679  DB 71       	IN	A,(CMOS_PORT+1)		;Get BCD value returned
 1786 F67B  57          	LD	D,A			;SAVE IN D
 1787 F67C  CD F720     	CALL	PORT_INC_2		;SET ADDRESS OF MINUTES
