 1812 F699  CD F009     	CALL	ZCO
 1813 F69C  C1          	POP	BC
 1814 F69D  79          	LD	A,C
 1815 F69E  CD F727     	CALL	PRINT_BCD		;Minutes.  Convert BCD to ASCII
 1816 F6A1  0E 3A       	LD	C,':'
