  125         0000      FALSE		EQU	0
  126         FFFF      TRUE		EQU	NOT FALSE
  127                   
  128         F000      BASE		EQU	0F000H		;Start or EPROM Location (Assume a 2732 or half of a 28C64)
  129                   					;Note can test running in CPM (set ORG to 100H), BUT disable setting the stack
  130                   					;by commenting out the 4 lines below SETUP_STACK:
  131                   
  132         F000      	ORG	BASE			;<--------<<<<<< LOCATION OF START OF MONITOR (First part)
  133                   					;Normally this monitor will reside at F000H 
  134                   					;The CPM (V1.2) jump table will be at F800H forn some old software I have.
  135                   					;Note. This is not a requirement for all my recent software/CPM3.
  136                   					
  137         FFFF      ST8C4		EQU	TRUE		;TRUE if S100_Parallel_IO Board.  False if IMSAI PIO Board	
  138                   					;in this ROM. Most users can set this option to FALSE 
  139                   
  140         FFFF      V3_Z80CPU_BOARD	EQU	TRUE		;TRUE if the S100Computers V3 Z80 CPU board is present
  141                   					
  142                   
  143         0001      SCROLL	EQU	01H			;Set scrool direction UP.
  144         0007      BELL	EQU	07H
  145         0020      SPACE	EQU	20H
  146         0009      TAB	EQU	09H			;TAB ACROSS (8 SPACES FOR SD-BOARD)
  147         000D      CR	EQU	0DH
  148         000A      LF	EQU	0AH
  149         000C      FF	EQU	0CH
  150         0011      QUIT	EQU	11H			;Turns off any screen enhancements (flashing, underline etc).
  151         0017      NO_ENHANCEMENT	EQU 17H			;Turns off whatever is on
  152         0010      FAST	EQU	10H			;High speed scrool
  153         001B      ESC	EQU	1BH
  154         007F      DELETE	EQU	7FH
  155         0008      BACKS	EQU	08H
  156         001A      CLEAR	EQU	1AH			;TO CLEAR SCREEN
  157         0038      RST7	EQU	38H			;RST 7 (LOCATION FOR TRAP)
  158         0000      NN	EQU	0H			;[I] INITIAL VALUE
  159         0001      SOH	EQU	1			; For XModem etc.
  160         0004      EOT	EQU	4
  161         0006      ACK	EQU	6
  162         0015      NAK	EQU	15H
  163                   
  164                   
  165         0100      STARTCPM EQU	100H			;LOCATION WHERE CPM WILL BE PLACED FOR COLD BOOT
  166         0100      STARTDOS EQU	100H			;LOCATION WHERE MSDOS WILL BE PLACED FOR COLD BOOT
  167         0048      FFILE_SIZE EQU	9000h/512		;SIZE OF 5MSDOS20.COM IN 512 BYTE SECTORS
  168                   ;
  169                   ;
  170                   ;IOBYTE = SENSE SWITCHES AT PORT 0EFH
  171                   ; Note this Monitor assumes tha if there is no IOBYTE hardware port at 0EFH on the bus the Z80 
  172                   ; will read the port input as 0FFH
  173                   ;
  174                   ;  BIT MAP OF PORT 0EFH:- 
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.30 Page   4
MASTER1 Z80

  175                   ;  X X X X  X X X X                      (11111111=NORMAL CONFIG)
  176                   ;  | | | |  | | | |..For Z80 Monitor,    0=CONSOLE DATA TO PRINTER ALSO
  177                   ;  | | | |  | | |....For 8086 Monitor,   0=Force MSDOS Console output to CGA/VGA Board 
  178                   ;  | | | |  | |......For 8086 Monitor,   0=Do not initialize MSDOS extra ROMS
  179                   ;  | | | |  |........Unused
  180                   ;  | | | |.............................. Console Device
  181                   ;  | |				         11: Propeller Console IO Board
  182                   ;  | |                                   01: Serial IO Board  LP USB port 
  183                   ;  | |                                   10: Serial I/O Board SCC Port A (19.2K, 1 Stop, NP)
  184                   ;  | |                                   00: VGA/PS2 Keyboard
  185                   ;  | |
  186                   ;  | |                                   Note if the V3 Z80 CPU Board K8 jumper is  jumpered 2-3 all Console IO will 
  187                   ;  | |                                   go to the USB port (ignoring this IOBYTE bits 5&6).
  188                   ;  | |...............For Z80 Monitor     0=Write protect Electralogics "Quasi-Disk" Memory disk for CPM3
  189                   ;  |.................For 8086 Monitor,   0=Prevent doing a JMPF to 500H after 8086 reset (to CPM86 boot)
  190                   ;                                        Normally a test is made to see if the CPM86 Boot is already in RAM at 500H
  191                   ;                                        If it is, a 8086 reset will bypass the monitor and go directly there. 
  192                   ;                                       (see Init: in 8086 Monitor)
  193                   ;                Note if 00xxxxxx,       This will force hardware diagnostic in the 8086 Monitor (See code at FFFF0H)
  194                   ;
  195                   ;
  196                   ;
  197                   ;-------------- PROPELLER CONSOLE_IO (OR SD SYSTEMS VIDIO BOARD) FOR CONSOLE INPUT & OUTPUT
  198         0000      CONSOL_STATUS	EQU	0H	
  199         0001      CONSOL_IN	EQU	01H
  200         0001      CONSOL_OUT	EQU	01H
  201                   
  202                   
  203                   					;IF this monitor ROMM is on the V3 S100 Computers Board you can
  204                   					;use the on-board USB port for console IO instead of the Propeller board.
  205                   					;Bit 0 of port 0E8H must be jumpered (K8) low on the board. Otherewise the USB port is ignored
  206                   
  207         00E9      Z80_USB_DATA	EQU	0E9H		;PORT ASSIGNEMENT FOR DLP-USB Controller chip on V3 S100Computers Z80 CPU board
  208         00E8      Z80_USB_STATUS	EQU	0E8H		;Status port for USB port (Port C of 8255, bits 6,7)
  209                   
  210         0086      VGA_IOBYTE	EQU	86H		;Bit 0=0 Console Output to FPGA_VGA_LCD Board, Bit 1=0 Console input is from that boards PS2 Port
  211         0080      VGA_CONSOL_STATUS EQU	80H
  212         0081      VGA_CONSOL_OUT   EQU	81H
  213                   
  214         0089      PS2_CONSOL_STATUS  EQU	89H
  215         008A      PS2_CONSOL_DATA	   EQU	8AH
  216                   
  217         008E      LCD_DATA_PORT	   EQU  8EH
  218         008F      ESP32_RESET_PORT   EQU  8FH
  219         0088      ACTIVATE_LCD_PORT  EQU  88H		;This pin must be 1 for the ESP32 code to respond
  220                   
  221                   
  222                   ;-------------- THIS IS MY PORT TO OUTPUT DATA TO HP 4050T LASAR PRINTER  (IMSAI 8PIO Board)
  223                   
  224         FFFF      IF	ST8C4				;If S100_Parallel_IO Board for Printer output
  225         00C2      PRINTER_CTRL	EQU	0C2H		;ST8C4 Control Port
  226         00C1      PRINTER_STATUS	EQU	0C1H		;ST8C4 Status port
  227         00C0      PRINTER_OUT	EQU	0C0H		;ST8C4 Data port
  228         000D      PRINTER_ST_LOW	EQU	0DH		;OUT STROBE LOW
  229         000C      PRINTER_ST_HIGH	EQU	0CH		;OUT STROBE HIGH
  230                   
  231                   ELSE
  236                   ENDIF
