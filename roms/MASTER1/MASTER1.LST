 1553 F551              SDCPM:
 1554 F551  21 FAB5     	LD	HL,SDCPMLOAD$MSG	; CP/M load start message
 1555 F554  CD F298     	CALL	HIGH_PRINT_STRING
 1556                   	
 1557 F557  DB 80       	IN	A,(SD_STAT)
 1558 F559  FE FF       	CP	0FFH
 1559 F55B  20 09       	JR	NZ,INIT_SD
 1560 F55D  21 FD63     	LD	HL,NO$SDCARD$MSG	; CP/M load start message
 1561 F560  CD F298     	CALL	HIGH_PRINT_STRING
 1562 F563  C3 F54E     	JP	EXIT
 1563                   	
 1564 F566              INIT_SD:				; Initialize
 1565 F566  CD F60A     	CALL	SD_INIT			; initialize SD Card
 1566 F569  C2 F63E     	JP	NZ,ERR_MEDIA		; handle error
 1567 F56C  CD F2C4     	CALL	PRTDOT			; display progress
 1568                   
 1569                   	; Read sectors
 1570 F56F  06 0C       	LD	B,SEC_COUNT		; number of sectors to load
 1571 F571  21 0100     	LD	HL,CPM_ADDRESS		; memory buffer address
 1572 F574  11 0001     	LD	DE,1			; starting LBA
 1573 F577              SDCPM1:
 1574 F577  C5          	PUSH	BC			; save loop control
 1575 F578  D5          	PUSH	DE			; save LBA
 1576 F579  CD F614     	CALL	SD_SEEK			; seek to desired LBA
 1577 F57C  CC F626     	CALL	Z,SD_READBLK		; read sector, HL will be incremented
 1578 F57F  D1          	POP	DE			; recover LBA
 1579 F580  C1          	POP	BC			; recover loop control
 1580 F581  C2 F643     	JP	NZ,ERR_IO		; handle error
 1581 F584  13          	INC	DE			; next sector
 1582 F585  CD F2C4     	CALL	PRTDOT			; display progress
 1583 F588  10 ED       	DJNZ	SDCPM1			; loop till all sectors read
 1584                   
