 1741 F63E  21 FAFF     	LD	HL,NOMEDIA$MSG
 1742 F641  18 0A       	JR	ERR_ABORT
 1743 F643              ERR_IO:
 1744 F643  21 FB25     	LD	HL,IOERR$MSG
 1745 F646  18 05       	JR	ERR_ABORT
 1746 F648              ERR_BADIMAGE:
