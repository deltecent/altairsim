  585 F05B  DB E8       	IN	A,(Z80_USB_STATUS)	;For V3 Z80 board special case check for USB output
  586 F05D  CB 47       	BIT	0,A			;jumper K8 is set to ground
  587 F05F  CA F0A4     	JP	Z,Z80_USB_OUT		;Special case V3 CPU Board
  588                   ENDIF
  589 F062  DB EF       	IN      A,(IOBYTE)              ; Read IOBYTE (hopefully 0xFF if non-existent)
  590 F064  CB 47               BIT     0,A                     ; Check bit 0 for printer echo
  591 F066  F5                  PUSH    AF                      ; Preserve IOBYTE
  592 F067  CC F173             CALL    Z,HIGH_LO                   ; Do printer echo if requested for ALL outputs below
  593 F06A  F1                  POP     AF                      ; Restore IOBYTE
  594 F06B  E6 30               AND     00110000B               ; Isolate the console device bits
  595 F06D  FE 30               CP      00110000B               ; Propeller?
  596 F06F  28 0D               JR      Z,PROPELLER_CO          ; If so, do it
  597 F071  FE 20               CP      00100000B               ; Serial I/O Board SCC Port A?
  598 F073  CA F1C9             JP      Z,SERIAL_OUT            ; If so, do it
  599 F076  FE 10               CP      00010000B               ; Serial I/O Board DLP USB Port?
  600 F078  CA F090             JP      Z,SERIAL_USB_CO         ; If so, do it
  601 F07B  C3 F09A             JP      VGA_CO                  ; VGA is only other possibility
  602                   	
  603 F07E              PROPELLER_CO:				;Must be standard PROPELLER CONSOLE I/O BOARD for output
  604 F07E  DB 00       	IN	A,(CONSOL_STATUS)	
  605 F080  E6 04       	AND	4H
  606 F082  28 FA       	JR	Z,PROPELLER_CO		;Board not ready yet
  607 F084  79          	LD	A,C
  608 F085  FE 07       	CP	07H			;IS IT A BELL
  609 F087  28 25       	JR	Z,BELL1			;Special case
  610 F089  FE 00       	CP	0H			;SD BOARD CANNOT TAKE A NULL!
  611 F08B  C8          	RET	Z
  612 F08C  D3 01       	OUT	(CONSOL_OUT),A		;Send character
  613 F08E  79          SDCON5:	LD	A,C
  614 F08F  C9          	RET				;RETURN CHARACTER SENT IN [A]
  615                   
  616                   
  617 F090              SERIAL_USB_CO:
  618 F090  DB AA       	IN	A,(USB_STATUS)		;SEND CHARACTER FROM SERIAL BOARD USB PORT (AAH)
  619 F092  E6 40       	AND	A,USB_TXE
  620 F094  20 FA       	JR	NZ,SERIAL_USB_CO
  621 F096  79          	LD	A,C			;GET CHAR
  622 F097  D3 AC       	OUT	(USB_DATA),A
  623 F099  C9          	RET
  624                   
  625 F09A  DB 80       VGA_CO:	IN	A,(VGA_CONSOL_STATUS)	;Check board is ready to recieve character
  626 F09C  CB 47       	BIT	0,A
  627 F09E  28 FA       	JR	Z,VGA_CO
  628 F0A0  79          	LD	A,C
  629 F0A1  D3 81       	OUT	(VGA_CONSOL_OUT),A	;Send 1 character
  630 F0A3  C9          	RET
  631                   
  632 F0A4              Z80_USB_OUT:
  633 F0A4  DB E8       	IN	A,(Z80_USB_STATUS)	;Don't worry PC is always fast enough!
  634 F0A6  E6 40       	AND	A,USB_TXE
  635 F0A8  20 FA       	JR	NZ,Z80_USB_OUT
  636 F0AA  79          	LD	A,C			;GET CHAR
  637 F0AB  D3 E9       	OUT	(Z80_USB_DATA),A
  638 F0AD  C9          	RET
  639                   
  640 F0AE  3E 06       BELL1:	LD	A,06H			;SEND A BELL
  641 F0B0  D3 01       	OUT	(CONSOL_OUT),A
  642 F0B2  3E 0F       	LD	A,0FH
