 1202 F32E  FE FF       	CP	A,0FFH
 1203 F330  C2 F33C     	JP	NZ,SELECT_OK		
 1204 F333  21 FD42     	LD	HL,NO_Z80_USB_MSGG	
 1205 F336  CD F298     	CALL	HIGH_PRINT_STRING	;No Z80 USB PortSend Modem serial parameters
 1206 F339  C3 F01C     	JP	ACTIVATE_LOW_PAGE
 1207                   
 1208                   
 1209 F33C              SELECT_OK:
 1210 F33C  AF          	XOR	A,A			;Initilize flags
 1211 F33D  DD 77 00    	LD	(IX+RECVD_SECT_NO),A
 1212 F340  DD 77 01    	LD	(IX+SECTNO),A
 1213 F343  DD 77 02    	LD	(IX+ERRCT),A
 1214                   					
 1215 F346  21 FA40     	LD	HL,MODEM_RAM_LOC	;Get RAM location for where to place code
 1216 F349  CD F298     	CALL	HIGH_PRINT_STRING
 1217 F34C  0E 01       	LD	C,1
 1218 F34E  CD F252     	CALL	HIGH_HEXSP		;Get 16 bit value, put on stack
 1219 F351  FD E1       	POP	IY			;DMA Value now in IY
 1220 F353  CD F2A3     	CALL	HIGH_CRLF
 1221                   				
 1222 F356  06 01       	LD	B,1			;TIMEOUT DELAY
 1223 F358  CD F438     	CALL	RECV			;GOBBLE UP GARBAGE CHARS FROM THE LINE
 1224                   
 1225                   
 1226                   
 1227 F35B              RECV_LOOP:				;------- MAIN RECIEVE LOOP ---------------------
 1228 F35B  AF          	XOR	A,A			;GET 0
 1229 F35C  DD 77 02    	LD	(IX+ERRCT),A		;INITIAL ERROR COUNT SET TO 0
 1230 F35F              RECV_HDR:
 1231 F35F  21 F921     	LD	HL,RMSG
 1232 F362  CD F298     	CALL	HIGH_PRINT_STRING
 1233 F365  DD 7E 01    	LD	A,(IX+SECTNO)		;Get current sector number
 1234 F368  3C          	INC	A
 1235 F369  CD F2B5     	CALL	HIGH_LBYTE			;Show Sector Number on Console
 1236                   
 1237 F36C  21 F9DD     	LD	HL,MODEM_RAM_MSG	;"H.  IF OK, will write to RAM location"
 1238 F36F  CD F298     	CALL	HIGH_PRINT_STRING
 1239 F372  FD E5       	PUSH	IY
 1240 F374  E1          	POP	HL			;IY to HL
 1241 F375  CD F2B0     	CALL	HIGH_LADR			;Show DMA Address
 1242 F378  CD F2A3     	CALL	HIGH_CRLF
 1243                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.30 Page  22
MASTER1 Z80

 1244 F37B  06 05       	LD	B,5			;5 SEC TIMEOUT
 1245 F37D  CD F438     	CALL	RECV
 1246 F380  D2 F3AE     	JP	NC,RHNTO		;IF ALL OK (NO TIMEOUT), THEN DROP DOWN TO RHNTO TO GET DATA
 1247                   
 1248 F383              RECV_HDR_TIMEOUT:
 1249 F383  CD F4FB     	CALL	TOUT			;PRINT TIMEOUT
 1250                   
 1251 F386              RECV_SECT_ERR:				;PURGE THE LINE OF INPUT CHARS
 1252 F386  06 01       	LD	B,1			;1 SEC W/NO CHARS
 1253 F388  CD F438     	CALL	RECV
 1254 F38B  D2 F386     	JP	NC,RECV_SECT_ERR	;LOOP UNTIL SENDER DONE
 1255 F38E  3E 15       	LD	A,NAK
 1256 F390  CD F4BA     	CALL	SEND			;SEND NAK
 1257                   
 1258 F393  DD 7E 02    	LD	A,(IX+ERRCT)
 1259 F396  3C          	INC	A
 1260 F397  DD 77 02    	LD	(IX+ERRCT),A
 1261 F39A  FE 08       	CP	A,MODEM_ERR_LIMIT
 1262 F39C  DA F35F     	JP	C,RECV_HDR
 1263                   			
 1264 F39F  CD F514     	CALL	CHECK_FOR_QUIT
 1265 F3A2  CA F35F     	JP	Z,RECV_HDR
 1266 F3A5  21 F9C9     	LD	HL,BAD_HEADER_MSG
 1267 F3A8  CD F298     	CALL	HIGH_PRINT_STRING
 1268 F3AB  C3 F54E     	JP	EXIT
 1269                   
 1270                   								
 1271 F3AE  FE 01       RHNTO:	CP	A,SOH			;GOT CHAR - MUST BE SOH
 1272 F3B0  CA F3C8     	JP	Z,GOT_SOH		;Z IF OK
 1273 F3B3  B7          	OR	A,A			;00 FROM SPEED CHECK?
 1274 F3B4  CA F35F     	JP	Z,RECV_HDR
 1275 F3B7  FE 04       	CP	A,EOT
 1276 F3B9  CA F430     	JP	Z,GOT_EOT
 1277                   					;DIDN'T GET SOH - 
 1278 F3BC  CD F2B5     	CALL	HIGH_LBYTE
 1279 F3BF  21 F936     	LD	HL,ERRSOH
 1280 F3C2  CD F298     	CALL	HIGH_PRINT_STRING
 1281 F3C5  C3 F386     	JP	RECV_SECT_ERR
 1282                   
 1283 F3C8              GOT_SOH:
 1284 F3C8  06 01       	LD	B,1
 1285 F3CA  CD F438     	CALL	RECV
 1286 F3CD  DA F383     	JP	C,RECV_HDR_TIMEOUT
 1287 F3D0  57          	LD	D,A			;D=BLK #
 1288 F3D1  06 01       	LD	B,1
 1289 F3D3  CD F438     	CALL	RECV			;GET CMA'D SECT #
 1290 F3D6  DA F383     	JP	C,RECV_HDR_TIMEOUT
 1291 F3D9  2F          	CPL
 1292 F3DA  BA          	CP	A,D			;GOOD SECTOR #?
 1293 F3DB  CA F3E7     	JP	Z,RECV_SECTOR
 1294                   								
 1295 F3DE  21 F94C     	LD	HL,ERR2			;GOT BAD SECTOR #
 1296 F3E1  CD F298     	CALL	HIGH_PRINT_STRING
 1297 F3E4  C3 F386     	JP	RECV_SECT_ERR
 1298                   
 1299                   
 1300 F3E7              RECV_SECTOR:				;Sector is OK, so read data and place in RAM
 1301 F3E7  7A          	LD	A,D			;GET SECTOR #
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.30 Page  23
MASTER1 Z80

 1302 F3E8  DD 77 00    	LD	(IX+RECVD_SECT_NO),A
 1303 F3EB  0E 00       	LD	C,0			;INIT CKSUM
 1304 F3ED  1E 80       	LD	E,80H			;Sector Byte Count
 1305 F3EF  FD E5       	PUSH	IY
 1306 F3F1  E1          	POP	HL			;DMA address (IY) to HL
 1307                   					
 1308 F3F2              RECV_CHAR:
 1309 F3F2  06 01       	LD	B,1			;1 SEC TIMEOUT
 1310 F3F4  CD F438     	CALL	RECV			;GET CHAR
 1311 F3F7  DA F383     	JP	C,RECV_HDR_TIMEOUT
 1312 F3FA  77          	LD	(HL),A			;STORE CHAR
 1313 F3FB  23          	INC	HL		
 1314 F3FC  1D          	DEC	E			;Next sector byte
 1315 F3FD  C2 F3F2     	JP	NZ,RECV_CHAR
 1316                   
 1317                   					;VERIFY CHECKSUM
 1318 F400  51          	LD	D,C			;SAVE CHECKSUM
 1319 F401  06 01       	LD	B,1			;TIMEOUT
 1320 F403  CD F438     	CALL	RECV			;GET CHECKSUM
 1321 F406  DA F383     	JP	C,RECV_HDR_TIMEOUT
 1322 F409  BA          	CP	A,D			;CHECK
 1323 F40A  C2 F427     	JP	NZ,RECV_CKSUM_ERR
 1324                   
 1325                   					;GOT A SECTOR, WRITE IF = 1+PREV SECTOR
 1326 F40D  DD 7E 00    	LD	A,(IX+RECVD_SECT_NO)
 1327 F410  47          	LD	B,A			;SAVE IT
 1328 F411  DD 7E 01    	LD	A,(IX+SECTNO)		;GET PREV
 1329 F414  3C          	INC	A			;CALC NEXT SECTOR #
 1330 F415  B8          	CP	B			;MATCH?
 1331 F416  C2 F41C     	JP	NZ,DO_ACK
 1332 F419  DD 77 01    	LD	(IX+SECTNO),A		;UPDATE SECTOR #
 1333 F41C  3E 06       DO_ACK:	LD	A,ACK
 1334 F41E  CD F4BA     	CALL	SEND
 1335                   				
 1336 F421  E5          	PUSH	HL			;ALL OK SO SAVE DMA Address in IY
 1337 F422  FD E1       	POP	IY			
 1338 F424  C3 F35B     	JP	RECV_LOOP		;Back to Top recieve loop
 1339                   
 1340 F427              RECV_CKSUM_ERR:
 1341 F427  21 F964     	LD	HL,ERR3
 1342 F42A  CD F298     	CALL	HIGH_PRINT_STRING
 1343 F42D  C3 F386     	JP	RECV_SECT_ERR
 1344                   
 1345 F430              GOT_EOT:
 1346 F430  3E 06       	LD	A,ACK			;ACK THE EOT
 1347 F432  CD F4BA     	CALL	SEND
 1348 F435  C3 F542     	JP	XFER_CPLT
