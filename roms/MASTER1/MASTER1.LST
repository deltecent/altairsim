  716                   ;<<<<<<<<<<<<<<<<<<<< MAIN CONSOL INPUT ROUTINE >>>>>>>>>>>>>>>>>>>>
  717                   
  718 F10E              HIGH_CI:
  719         FFFF      IF   V3_Z80CPU_BOARD			; Is this an S100Computers V3 Z80 CPU Board
  720 F10E  DB E8       	IN	A,(Z80_USB_STATUS)	;For V3 Z80 board special case check for USB output
  721 F110  CB 47       	BIT	0,A			;jumper K8 is set to ground
  722 F112  CA F15D     	JP	Z,Z80_USB_IN		;Special case V3 CPU Board
  723                   ENDIF
  724 F115  DB EF       	IN      A,(IOBYTE)              ; Read IOBYTE (hopefully 0xFF if non-existent)
  725 F117  E6 30               AND     00110000B               ; Isolate the console device bits
  726 F119  FE 30               CP      00110000B               ; Propeller?
  727 F11B  28 0D               JR      Z,PROPELLER_CI          ; If so, do it
  728 F11D  FE 20               CP      00100000B               ; Serial I/O Board SCC Port A?
  729 F11F  CA F135             JP      Z,SERIAL_CI             ; If so, do it
  730 F122  FE 10               CP      00010000B               ; Serial I/O Board DLP USB Port?
  731 F124  CA F13E             JP      Z,SERIAL_USB_CI         ; If so, do it
  732 F127  C3 F168             JP      PS2_IN                  ; PS2 is only other possibility
  733                   
  734 F12A              PROPELLER_CI:	
  735 F12A  DB 00       	IN	A,(CONSOL_STATUS)	;Else "normal" Propeller console IN
  736 F12C  E6 02       	AND	02H
  737 F12E  28 FA       	JR	Z,PROPELLER_CI
  738 F130  DB 01       	IN	A,(CONSOL_IN)
  739 F132  E6 7F       	AND	7FH			;7 bits only
  740 F134  C9          	RET
  741                   
  742 F135              SERIAL_CI:
  743 F135  CD F1EB     	CALL	SERIAL_STAT		;See if anything at Serial/Modem input
  744 F138  28 FB       	JR	Z,SERIAL_CI		;No, Keep trying
  745 F13A  CD F1DB     	CALL	SERIAL_IN		;Jump to serial port routine
  746 F13D  C9          	RET
  747                   
  748                   
  749 F13E              SERIAL_USB_CI:				;Its not clear why this delay is required!
  750 F13E  D5          	PUSH	DE			;---- GET CHARACTER FROM SERIAL BOARD VIA USB PORT -----
  751 F13F  11 00BB     HMSEC3:	LD	DE,000BBH		;1 SEC DCR COUNT at 10 MHz (does not have to be accurate)
  752 F142  DB AA       HMWTI4:	IN	A,(USB_STATUS)
  753 F144  E6 80       	AND	A,USB_RXE
  754 F146  28 0C       	JR	Z,HMCHAR4		;GOT CHAR
  755 F148  1D          	DEC	E			;COUNT DOWN
  756 F149  20 F7       	JR	NZ,HMWTI4		;FOR TIMEOUT
  757 F14B  15          	DEC	D
  758 F14C  20 F4       	JR	NZ,HMWTI4
