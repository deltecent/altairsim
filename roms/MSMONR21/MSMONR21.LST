   88 E025  D3 78       	OUT	(78H),A
   89 E027  0E 7D       	LD	C,7DH		;difference in timing for
   90 E029  11 0001     	LD	DE,0001H	;load of port
   91 E02C  ED 78       WAIT0:	IN	A,(C)		;plus a ready wait on bit 7
   92 E02E  F2 E02C     	JP	P,WAIT0
   93 E031  13          WAIT1:	INC	DE
   94 E032  ED 78       	IN	A,(C)
   95 E034  FA E031     	JP	M,WAIT1
   96 E037  31 E059     	LD	SP,MONST
   97 E03A  C1          FINDBC: POP	BC
   98 E03B  E1          	POP	HL
   99 E03C  37          	SCF	
  100 E03D  ED 52       	SBC	HL,DE
  101 E03F  38 F9       	JR	C,FINDBC
  102 E041  C1          	POP	BC
  103 E042  3E 40       	LD	A,40H		;back to more serial stuff
  104 E044  D3 7D       	OUT	(CSTAT),A
  105 E046  78          	LD	A,B
  106 E047  D3 7D       	OUT	(CSTAT),A
  107 E049  3E 37       	LD	A,37H
  108 E04B  D3 7D       	OUT	(CSTAT),A
  109 E04D  79          	LD	A,C
  110 E04E  D3 78       	OUT	(78H),A
  111 E050  3E 64       	LD	A,64H
  112 E052  06 C8       MCLOOP: LD	B,0C8H
  113 E054  10 FE       CLLOOP: DJNZ	CLLOOP
  114 E056  3D          	DEC	A
  115 E057  20 F9       	JR	NZ,MCLOOP
  116 E059  18 1C       MONST:	JR	RDETRY
