    1                   ;
    2                   ;	MS monitor Version 2.10
    3                   ;	Resurrected on 08/14/91
    4                   ;	Restored to standard 08/28/91  09:54 pm
    5                   ;
    6                   ;	General equates
    7                   ;
    8         FF60      SBUFF	EQU	0FF60H		;buffer
    9         FFC0      STKTOP	EQU	0FFC0H		;stack top
   10         FFC1      BKBUFF	EQU	STKTOP+1H	;storage of original program data
   11         FFC4      BKADDR	EQU	STKTOP+4H	;breakpoint address storage
   12         FFC6      MNFLG1	EQU	STKTOP+6H	;monitor flag 1
   13         FFC7      PARMCT	EQU	STKTOP+7H	;parameters input counter
   14         FFC8      CHARIN	EQU	STKTOP+8H	;character inputted
   15         FFC9      SFFC9	EQU	STKTOP+9H	;byte storage
   16         FFD0      BUF0	EQU	STKTOP+10H	;parameter storage
   17         FFD1      BUF01	EQU	BUF0+1
   18         FFD2      BUF02	EQU	BUF0+2		;etc.
   19         FFD4      BUF04	EQU	BUF0+4
   20         FFD5      BUF05	EQU	BUF0+5
   21         FFD6      BUF06	EQU	BUF0+6
   22         FFD8      BUF08	EQU	BUF0+8
   23         FFE4      TEMPSP	EQU	BUF0+14H	;temp stack save
   24         FFE6      BRKSP	EQU	BUF0+16H	;breakpoint sp storage
   25                   ;
   26                   ;	The follow -> notations are used to indicate where
   27                   ;	the cpu registers are stored for breakpoints
   28                   ;
   29         FFE8      RSTSTK	EQU	BUF0+18H	;restore stack
   30                   ;				 ->IY
   31         FFEA      SFFEA	EQU	BUF0+1AH	;->IX
   32         FFF4      SFFF4	EQU	0FFF4H		;->HL
   33         FFF9      SFFF9	EQU	0FFF9H
   34         FFFA      MNFLG0	EQU	0FFFAH		;monitor flag 0 ->I
   35         FFFC      TEMPB0	EQU	0FFFCH		;->AF
   36         FFFD      TEMPB1	EQU	0FFFDH
   37         FFFE      ADRBUF	EQU	0FFFEH		;word storage + ret addr
   38                   ;
   39                   ;	Bios entry points
   40                   ;
   41         F003      WBOOTE	EQU	0F003H		;warm boot
   42         F018      HME	EQU	0F018H		;home vector
   43         F02D      LDE	EQU	0F02DH		;load 'n' sectors
   44         F030      SVE	EQU	0F030H		;save 'n' records
   45         F033      FMATE	EQU	0F033H		;format vector
   46         F03F      STDSDT	EQU	0F03FH		;start of density tables
   47         F040      TKSPS	EQU	0F040H		;tracks per side
   48                   ;
   49                   ;	Base ram equates
   50                   ;
   51         0040      TADDR	EQU	0040H		;transfer address
   52         0042      UNIT	EQU	0042H		;drive select
   53         0043      SCTR	EQU	0043H		;sectors
   54         0044      TRK	EQU	0044H		;track
   55         0045      NREC	EQU	0045H		;number of records
   56         0046      ERMASK	EQU	0046H		;error mask
   57         0047      ERSTAT	EQU	0047H		;error status
   58         004D      SPSV	EQU	004DH		;stack save
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.30 Page   2
