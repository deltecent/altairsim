   62                   ;
   63         0063      SELECT	EQU	063H		;disk select port
   64         007C      CDATA	EQU	07CH		;console data
   65         007D      CSTAT	EQU	07DH		;console status
   66                   ;
   67         E000      	ORG	0E000H
