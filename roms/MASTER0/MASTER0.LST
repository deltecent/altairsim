 1499 F4C9              MoreRD16:
 1500 F4C9  3E 08       	LD	A,REGdata		;REG regsiter address
 1501 F4CB  D3 32       	OUT	(IDECport),A	
 1502                   
 1503 F4CD  F6 40       	OR	IDErdline		;08H+40H, Pulse RD line
 1504 F4CF  D3 32       	OUT	(IDECport),A	
 1505                   
