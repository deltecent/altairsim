 1520                   ;------------------------ IDE SUPPORT ROUTINES --------------
 1521                   
 1522 F4E1              INITILIZE_IDE_BOARD:			;Drive Select in [A]. Note leaves selected drive as [A]
 1523 F4E1  3E 92       	LD	A,RDcfg8255		;Config 8255 chip (10010010B), read mode on return
 1524 F4E3  D3 33       	OUT	(IDECtrl),A		;Config 8255 chip, READ mode
 1525                   				
 1526                   					;Hard reset the disk drive 
 1527                   					;For some reason some CF cards need to the RESET line 
 1528                   					;pulsed very carefully. You may need to play around   
 1529 F4E5  3E 80       	LD	A,IDEreset		;with the pulse length. Symptoms are: incorrect data comming
 1530 F4E7  D3 32       	OUT	(IDECport),A		;back from a sector read (often due to the wrong sector being read)
 1531                   					;I have a (negative)pulse of 60 uSec. (10Mz Z80, two IO wait states).
 1532                   
 1533 F4E9  0E 20       	LD	C,IDE_Reset_Delay	;~60 uS seems to work for the 5 different CF cards I have
 1534 F4EB              ResetDelay:
 1535 F4EB  0D          	DEC	C
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.30 Page  27
