 2105                   ;	DB	0E1H			;Enable reciever, No Auto Enable, Recieve 8 bits (for CTS bit)	
 2106 F834  05          	DB	05H			;Point to WR5
 2107 F835  EA          	DB	0EAH			;Enable, Transmit 8 bits
 2108 F836  0B          	DB	0BH			;Set RTS,DTR, Enable. Point to WR11
 2109 F837  56          	DB	56H			;Recieve/transmit clock = BRG
