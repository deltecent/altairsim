  441                   ;
  442                   ; IDE Status Register:
  443                   ;  bit 7: Busy	1=busy, 0=not busy
  444                   ;  bit 6: Ready 1=ready for CMD, 0=not ready yet
  445                   ;  bit 5: DF	1=fault occured insIDE drive
  446                   ;  bit 4: DSC	1=seek complete
  447                   ;  bit 3: DRQ	1=data request ready, 0=not ready to xfer yet
  448                   ;  bit 2: CORR	1=correctable error occured
  449                   ;  bit 1: IDX	vendor specific
  450                   ;  bit 0: ERR	1=error occured
