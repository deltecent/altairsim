  615 F088  F3          	DI				;No interrupts
  616 F089  AF          	XOR	A			;SET INTERUPT TO PAGE 0H
  617 F08A  ED 47       	LD	I,A			;Z80 Interrupt page 0
  618 F08C  D3 D1       	OUT	(Z80PORT+1),A		;KILL THE INTERSYSTEMS Z80 CPU BOARD INT CONTROLLER (If present)
