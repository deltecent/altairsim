 2245                   ;
 2246                   ;
 2247                   ; Basic test for presence of 8086 on reset. The 8086 will jump to FFFF0H. If there is a ROM there nothing will 
 2248                   ; change and the 8086 will jump from F000:FFF0 to the start of the ROM monitor.   
 2249                   ; If however no ROM is present the 8086 will find the RAM code below and continously put "?" 
 2250                   ; on Consol via port 01H. This avoids teh hassel of figuring out why the 8086 boards don't boot 
 2251                   ; when their ROM's are not active. (Either on the CPU board or MSDOS Support board).
 2252                   
 2253 F8BB  3E FC       SLAVE_CPU:	LD	A,0FCH			;Point to 8086 Reset location (FFFF0H)
 2254 F8BD  D3 D2       		OUT	(Z80PORT+2),A		;Re-map to 0000H to FC000H 
 2255 F8BF  21 3FF0     		LD	HL,3FF0H
 2256                   
 2257 F8C2  36 B0       		LD	(HL),0B0H		;Continously put "?" on Consol via port 01
 2258 F8C4  23          		INC	HL			;Basic test for 8086 on reset
 2259 F8C5  36 3F       		LD	(HL),'?'
 2260 F8C7  23          		INC	HL
 2261 F8C8  36 E6       		LD	(HL),0E6H
 2262 F8CA  23          		INC	HL
 2263 F8CB  36 01       		LD	(HL),01H		;Console port (note no status check)
 2264 F8CD  23          		INC	HL
 2265 F8CE  36 EB       		LD	(HL),0EBH
 2266 F8D0  23          		INC	HL
 2267 F8D1  36 FA       		LD	(HL),0FAH		
 2268                   
 2269 F8D3  AF          		XOR	A
 2270 F8D4  D3 D2       		OUT	(Z80PORT+2),A		;Re-map back to 0H
