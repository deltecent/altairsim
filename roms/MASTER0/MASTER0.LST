 1510 F4D7  77          	LD	(HL),A
 1511 F4D8  23          	INC	HL
 1512                   	
 1513 F4D9  3E 08       	LD	A,REGdata		;Deassert RD line
 1514 F4DB  D3 32       	OUT	(IDECport),A
