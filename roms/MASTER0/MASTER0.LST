 2688 FB62  C5          	PUSH	BC			;This can be increased if you are displaying debugging info on the ZFDC 
 2689 FB63  D5          	PUSH	DE			;HEX LED display.
 2690 FB64  01 0000     	LD	BC,0
 2691 FB67  1E 05       	LD	E,STATUS_DELAY		;Timeout, (about 2 seconds)
 2692 FB69  DB 11       WAIT_1:	IN	A,S100_STATUS_B		;Check if ZFDC has any data for S-100 system
