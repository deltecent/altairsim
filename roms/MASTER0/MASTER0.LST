 1561 F50E  1E 0E       	LD	E,REGshd		;00001110,(0EH) CS0,A2,A1,  
 1562 F510  CD F586     	CALL	IDEwr8D			;Write byte to select the MASTER device
 1563                   
 1564 F513  06 FF       	LD	B,0FFH			;Delay time to allow a Hard Disk to get up to speed
 1565 F515              WaitInit:	
 1566 F515  1E 0F       	LD	E,REGstatus		;Get status after initilization
 1567 F517  CD F575     	CALL	IDErd8D			;Check Status (info in [D])
 1568 F51A  CB 7A       	BIT	7,D
 1569                   	;;;JR	Z,SECREAD		;Zero, so all is OK to write to drive
 1570 F51C  C8          	RET	Z			;Zero, so all is OK to write to drive
 1571                   					;Delay to allow drive to get up to speed
 1572 F51D  C5          	PUSH	BC
 1573 F51E  01 FFFF     	LD	BC,0FFFFH	
 1574 F521  16 02       DXLAY2:	LD	D,2			;May need to adjust delay time to allow cold drive to
 1575 F523  15          DXLAY1:	DEC	D			;to speed
 1576 F524  20 FD       	JR	NZ,DXLAY1
 1577 F526  0B          	DEC	BC
 1578 F527  79          	LD	A,C
 1579 F528  B0          	OR	B
 1580 F529  20 F6       	JR	NZ,DXLAY2
 1581 F52B  C1          	POP	BC
