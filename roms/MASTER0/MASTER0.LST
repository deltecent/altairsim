  241                   ;-------------- S100Computers SERIAL I/O BOARD PORT ASSIGNMENTS  (A0-AC)
  242                   
  243         00A0      BCTL		EQU	0A0H		;CHANNEL B CONTROL PORT ASSIGNMENTS OF THE ZILOG SCC CHIP ;<--- Adjust as necessary, 
  244         00A2      BDTA		EQU	0A2H		;CHANNEL B DATA
  245         00A1      ACTL		EQU	0A1H		;CHANNEL A CONTROL (MODEM_CTL_PORT)		
  246         00A3      ADTA		EQU	0A3H		;CHANNEL A DATA (MODEM_DATA_PORT)
  247                   
  248         00A8      PortA_8255	EQU	0A8H		;A port of 8255 ;<--- Adjust as necessary
  249         00A9      PortB_8255	EQU	0A9H		;B port of 8255
  250         00AA      PortC_8255	EQU	0AAH		;C Port of 8255
  251         00AB      PortCtrl_8255	EQU	0ABH		;8255 configuration port
  252         0098      AinBout8255cfg	EQU	10011000b	;Set 8255 ports:- A input, B output, 
  253                   
  254         00AC      USB_DATA	EQU	0ACH		;PORT ASSIGNEMENT FOR DLP-USB Controller chip on Serial Board
  255         00AA      USB_STATUS	EQU	0AAH		;Status port for USB port (Port C of 8255, bits 6,7)
  256         0080      USB_RXE		EQU	80H		;If Bit 7 = 0, data available to recieve by S-100 Computer	
  257         0040      USB_TXE		EQU	40H		;If Bit 6 = 0 data CAN be written for transmission to PC
  258                   
  259         00A1      BASE_PORT	EQU	0A1H		;For XModem communication routines
  260         00A1      MODEM_CTL_PORT	EQU	BASE_PORT 	;A1H (Note modem I/O will be on CHANNEL A. Speaker on CHANNEL B
  261         00A3      MODEM_DATA_PORT	EQU	BASE_PORT+2	;A3H 
  262                   
  263         0004      MODEM_SEND_MASK	EQU	4
  264         0004      SEND_READY	EQU	4		;VALUE WHEN READY
  265         0001      MODEM_RECV_MASK	EQU	1
  266         0001      RECV_READY	EQU	1		;BIT ON WHEN READY
  267         0008      MODEM_ERR_LIMIT	EQU	8		;Max number of Modem serial port re-reads aborting
  268         0001      MODEM_RTS_DELAY	EQU	1		;Time to check Modem RTS line (See XMODEM_LOAD & P_XMODEM_LOAD). Not critical.
  269                   
  270         0000      RECVD_SECT_NO	EQU	0H		;IX Offset for XModem Recieved Sector Number
  271         0001      SECTNO		EQU	1H		;IX Offset for XModem CURRENT SECTOR NUMBER 
  272         0002      ERRCT		EQU	2H		;IX Offset for XModem ERROR COUNT
  273         0003      MENU_NUMBER	EQU	3H		;IX Offset for menu selection
  274                   
  275                   
  276                   ;-------------- S100Computers MSDOS Support Board PORT ASSIGNMENTS 
  277                    
  278         0070      CMOS_PORT	EQU	70H		;Base Port for CMOS Clock/Date Chip on MSDOS Support Board
  279         0020      MASTER_PIC_PORT	EQU	20h		;Hardware port the 8259A (two ports 20H & 21H)
  280                   
  281         0017      MasterICW1	equ	00010111B	;EDGE triggered, 4 bytes, single Master,ICW4 needed
  282         0008      MasterICW2	equ	8H		;Base address for 8259A Int Table (IBM-PC uses 8X4 = 20H)
