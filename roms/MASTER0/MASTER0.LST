 1629                   ;
 1630                   ;------------------------------------------------------------------
 1631                   ; Low Level 8 bit R/W to the drive controller.  These are the routines that talk
 1632                   ; directly to the drive controller registers, via the 8255 chip.  
 1633                   ; Note the 16 bit I/O to the drive (which is only for SEC Read here) is done directly 
 1634                   ; in the routine MoreRD16 for speed reasons.
 1635                   
 1636 F575              IDErd8D:				;READ 8 bits from IDE register in [E], return info in [D]
 1637 F575  7B          	LD	A,E
 1638 F576  D3 32       	OUT	(IDECport),A		;drive address onto control lines
 1639                   
 1640 F578  F6 40       	OR	IDErdline		;RD pulse pin (40H)
 1641 F57A  D3 32       	OUT	(IDECport),A		;assert read pin
 1642                   
 1643 F57C  DB 30       	IN	A,(IDEAport)
 1644 F57E  57          	LD	D,A			;return with data in [D]
 1645                   
 1646 F57F  7B          	LD	A,E			;<---Ken Robbins suggestion
 1647 F580  D3 32       	OUT	(IDECport),A		;Deassert RD pin
 1648                   
 1649 F582  AF          	XOR	A
 1650 F583  D3 32       	OUT	(IDECport),A		;Zero all port C lines
 1651 F585  C9          	RET
