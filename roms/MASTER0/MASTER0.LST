  319                   ;-------------- PORT(S) TO SWITCH MASTER/SLAVE(S)
  320                   
  321         00D0      Z80PORT	EQU	0D0H			;4 PORTS ON Z80 BOARD FOR MEMORY MANAGEMENT (& INT Controller on IA Z80 CPU Board)
  322                   
  323         00D2      MPGSEL_0	EQU	0D2H		; MEM MGR BANK 0 PAGE SELECT REG (0K-16K)
  324         00D3      MPGSEL_1	EQU	0D3H		; MEM MGR BANK 1 PAGE SELECT REG (16K-32K)
  325                   
  326         00EF      IOBYTE		EQU	0EFH		;IOBYTE (SEE ABOVE)
  327         00EE      SW_TMAX		EQU	0EEH		;O		;TRACK PORT
  343         0056      SECTOR	EQU	X+6			;SECTOR PORT
