 1539                   	
 1540 F4F2  CD F552     	CALL	DELAY_15		;Need to delay a little before checking busy status
 1541                   
 1542 F4F5              IDEwaitnotbusy:				;Drive READY if 01000000
 1543 F4F5  06 FF       	LD	B,0FFH
 1544 F4F7  0E 80       	LD	C,080H			;Delay, must be above 80H for 4MHz Z80. Leave longer for slower drives
 1545 F4F9              MoreWait:
