 2678 FB55              S100IN:
 2679 FB55  DB 11       	IN	A,S100_STATUS_B		;Check if ZFDC has any data for S-100 system
 2680 FB57  CB 7F       	BIT	DIRECTION_BIT,A		;Is ZFDC in input mode, if not wait
 2681 FB59  28 FA       	JR	Z,S100IN		;If low then ZFDC board is still in input mode, wait
 2682 FB5B  CB 47       	BIT	DATA_IN_RDY,A
 2683 FB5D  28 F6       	JR	Z,S100IN
