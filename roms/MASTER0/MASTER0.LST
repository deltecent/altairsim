 1366 F435  3A 0100     	LD	A,(STARTCPM)
 1367 F438  FE 31       	CP	31H			;EXPECT TO HAVE 31H @80H IE. LD SP,80H
 1368 F43A  C2 F54C     	JP	NZ,ERR_LD1		;Boot Sector Data incorrect
 1369                   
 1370                   	; Launch CP/M
 1371 F43D  C3 0100     	JP	STARTCPM
 1372                   
 1373                   ;---------------------------------------------------------------------------------------------------------------
 1374                   ; This code will load RomWBW from an IDE device starting at LBA 0x1024
 1375                   ; into the first 128K of banked RAM (8 x 16K pages).
 1376                   ;
 1377                   ; The Z80 CPU implements a custom memory manager that allows mapping the 2
 1378                   ; lowest 16K portions of CPU address space ($0000-$3FFFF, and $4000-$7FFF).
 1379                   ; Each of these banks can be mapped to any physical 16K bank.
 1380                   ; The physical 16K banks are 16K aligned.  The memory manager
 1381                   ; can address a maximum of 1MB of physical memory.  Which is
 1382                   ; 64 x 16K banks (bank numbers $00-$3F)
 1383                   ;
 1384                   ; The top 32K of CPU address space ($8000-$FFFF) is statically mapped
 1385                   ; to physical banks $02 & $03.  RomWBW is designed to have the top
 1386                   ; 32K of CPU address space assigned to the last two banks of
 1387                   ; RAM.  So the RomWBW memory manager for this board (MM_SZ80)
 1388                   ; rotates the requested bank numbers by 4.  With wrapping, this
 1389                   ; causes a RomWBW request for the top two banks to be mapped to
 1390                   ; physical banks $02 & $03.
 1391                   ;
 1392                   ; Z80 CPU Physical:  00 01 02 03 ... 38 39 3A 3B 3C 3D 3E 3F
 1393                   ; RomWBW Logical:    04 05 06 07 ... 3C 3D 3E 3F 00 01 02 03
 1394                   ;
 1395                   ; As a result, the Z80 CPU Monitor loads RomWBW starting at
 1396                   ; physical bank 04.
 1397                   
 1398 F440              HBOOTWBW:
 1399 F440  21 FEDD     	LD	HL,WBWLOAD$MSG		;Send Modem signon message
 1400 F443  CD F176     	CALL	PRINT_STRING
 1401                   	
 1402                   	; Interface initialization
 1403 F446  CD F4E1     	CALL	INITILIZE_IDE_BOARD	; initialize the board and drive. If there is no drive abort
 1404 F449  DA F13E     	JP	C,START			; abort on error
 1405 F44C  CD F23F     	CALL	PRTDOT
 1406                   
 1407                   	; This is the main loading loop.  Each MMU bank is 16K, so we
 1408                   	; have an inner loop to read and load 32 sectors.  An outer
 1409                   	; loop increments the MMU bank selection, so we wind up loading
 1410                   	; the desired 128K in 8 consecutive banks.
 1411 F44F  11 0400     	LD	DE,1024			; DE is LBA (start from sec 1024)
 1412 F452  0E 04       	LD	C,4			; C is MMU bank (start from 4)
 1413 F454              WBWBOOT1:
 1414                   	; Setup for inner loop
 1415 F454  21 0000     	LD	HL,0000H		; HL is RAM address
 1416 F457  06 20       	LD	B,32			; B is sector count, load 32 sectors per bank
 1417 F459  79          	LD	A,C			; get bank to be loaded
 1418 F45A  07          	RLCA				; rotate bank num
 1419 F45B  07          	RLCA				; ... to top 6 bits
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.30 Page  25
MASTER0 Z80

 1420 F45C  D3 D2       	OUT	(MPGSEL_0),A		; and select it
 1421                   
 1422 F45E              WBWBOOT2:
 1423                   	; Bank load loop
 1424 F45E  C5          	PUSH	BC			; save loop control
 1425 F45F  D5          	PUSH	DE			; save LBA
 1426 F460  CD F494     	CALL	SET_LBA
 1427 F463  CD F4BD     	CALL	READSECTOR		; HL will be incremented
 1428 F466  D1          	POP	DE			; recover LBA
 1429 F467  C1          	POP	BC			; recover loop control
 1430 F468  DA F13E     	JP	C,START			; abort on error
 1431 F46B  13          	INC	DE			; next sector
 1432 F46C  10 F0       	DJNZ	WBWBOOT2		; loop until all bank sectors done
 1433                   
 1434                   	; Show progress
 1435 F46E  CD F23F     	CALL	PRTDOT
 1436                   
 1437                   	; Setup for next bank and check for done
 1438 F471  0C          	INC	C			; next bank
 1439 F472  79          	LD	A,C			; put in A
 1440 F473  FE 0C       	CP	4 + 8			; 128K / 16K = 8 banks
 1441 F475  20 DD       	JR	NZ,WBWBOOT1		; loop until all banks done
 1442                   
 1443                   	; Setup the lower 16K with the first 16K of RomWBW
 1444 F477  3E 10       	LD	A,4 << 2		; first 16K bank
 1445 F479  D3 D2       	OUT	(MPGSEL_0),A
 1446                   
 1447                   	; Completion message
 1448 F47B  21 FED7     	LD	HL,DONE$MSG
 1449 F47E  CD F176     	CALL	PRINT_STRING
