 2672 FB4F  CB 47       	BIT	DATA_IN_RDY,A		;Anything there ?
 2673 FB51  C8          	RET	Z			;Return 0 if nothing
 2674 FB52  AF          	XOR	A,A
 2675 FB53  3D          	DEC	A			;Return NZ, & 0FFH in A if something there
 2676 FB54  C9          	RET
