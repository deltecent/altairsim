 1459 F48A  23          	INC	HL
 1460 F48B  7E          	LD	A,(HL)
 1461 F48C  FE B5       	CP	0B5H			; Second marker byte
 1462 F48E  C2 F54C     	JP	NZ,ERR_LD1		; Boot Sector Data incorrect
 1463                   
 1464                   	; Launch RomWBW
 1465 F491  C3 0000     	JP	0000H
 1466                   
