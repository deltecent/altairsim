  656 F0BB  3E 17       	LD	A,MasterICW1		;Initilize the 8259A PIC Controller (;EDGE triggered, 4 bytes, single Master,ICW4 needed)
  657 F0BD  D3 20       	OUT	(MASTER_PIC_PORT),A
