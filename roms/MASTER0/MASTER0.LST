 1468 F494  F5          	PUSH	AF
 1469 F495  D5          	PUSH	DE
 1470 F496  E5          	PUSH	HL
 1471 F497  EB          	EX	DE,HL
 1472 F498  1E 0B       	LD	E,REGsector
 1473 F49A  55          	LD	D,L
 1474 F49B  CD F586     	CALL	IDEwr8D
 1475 F49E  1E 0C       	LD	E,REGcyLSB
 1476 F4A0  54          	LD	D,H
 1477 F4A1  CD F586     	CALL	IDEwr8D
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.30 Page  26
