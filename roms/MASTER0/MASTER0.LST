 1478 F4A4  1E 0D       	LD	E,REGcyMSB
 1479 F4A6  16 00       	LD	D,0
 1480 F4A8  CD F586     	CALL	IDEwr8D
 1481 F4AB  16 E0       	LD	D,11100000B		; MASTER, LBA MODE
 1482 F4AD  1E 0E       	LD	E,REGshd
 1483 F4AF  CD F586     	CALL	IDEwr8D
 1484 F4B2  1E 0A       	LD	E,REGcnt
 1485 F4B4  16 01       	LD	D,1			; R/W 1 sector
 1486 F4B6  CD F586     	CALL	IDEwr8D
 1487 F4B9  E1          	POP	HL
 1488 F4BA  D1          	POP	DE
 1489 F4BB  F1          	POP	AF
 1490 F4BC  C9          	RET
 1491                   
 1492 F4BD              READSECTOR:
 1493 F4BD  16 20       	LD	D,CMDread		;Send read CMD
 1494 F4BF  1E 0F       	LD	E,REGCMD
 1495 F4C1  CD F586     	CALL	IDEwr8D			;Send sec read CMD to drive.
 1496 F4C4  CD F55C     	CALL	IDEwdrq			;Wait until it's got the data
 1497                   
