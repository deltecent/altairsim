  295         0005      STATUS_DELAY	EQU	5		;Time-out for waiting for ZFDC Board handshake signal (~0.5 seconds @ 10MHz)
  296         0007      DIRECTION_BIT	EQU	7		;Bits for the ZFDC flags 0 = IN, 1 = OUT
  297         0000      DATA_IN_RDY	EQU	0		;Bit for data available from ZFDC board
  298         0001      DATA_OUT_RDY	EQU	1		;Bit for data can be sent to ZFDC board
  299         0001      STD8IBM		EQU	1		;IBM 8" SDSS Diak
  300         0000      NO_ERRORS_FLAG	EQU	0		;No Errors flag for previous cmd, sent back to S-100 BIOS
  301                   
  302                   
  303                   ;Commands to the ZFDC Board:-
  304                   
  305         0003      CMD_RESET_ZFDC	EQU	3H		;Reset the WD2793 chip and Board software
  306         0004      CMD_SET_FORMAT	EQU	4H		;This will select a specified drive and assign a disk format table to that drive
  307         0005      CMD_SET_DRIVE	EQU	5H		;This will select a specified drive (0,1,2,3)
  308         0007      CMD_SET_TRACK	EQU	7H		;This will set head request to a specified track
  309         0008      CMD_SET_SIDE	EQU	8H		;This will set side request to a specified side
  310         0009      CMD_SET_SECTOR	EQU	9H		;This will set sector request to a specified sector
  311         000A      CMD_SET_HOME	EQU	0AH		;This will set head request to Track 0 of CURRENT drive
  312         000B      CMD_STEP_IN	EQU	0BH		;Step head in one track of CURRENT drive
  313         000E      CMD_SEEK_TRACK	EQU	0EH		;Seek to track to (IY+DRIVE_TRACK) with the track verify bit set on CURRENT drive/format
  314         0010      CMD_READ_SECTOR	EQU	10H		;Read data from the CURRENT sector (on current track,side,drive).
  315         0021      CMD_HANDSHAKE	EQU	21H		;Handshake command only sent during board initilization/testing 
  316         0029      CMD_RD_MULTI_SECTOR EQU 29H		;Read data from multiple sectors starting at the CURRENT sector (on current track,side,drive).
  317                   
