 1552 F505  10 F2       	DJNZ	MoreWait
 1553 F507  0D          	DEC	C
 1554 F508  20 EF       	JR	NZ,MoreWait
 1555 F50A  37          	SCF				;Set carry to indicate an error
 1556 F50B  C9          	RET
